@model BrikonYapi.Web.Data.Entities.Owner
@{
    ViewData["Title"] = "Yeni Kat Maliki";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Yeni Kat Maliki Hesabı</h5>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Owners" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ad Soyad <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Telefon</label>
                        <input asp-for="Phone" class="form-control" placeholder="0532 000 00 00" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">E-posta (giriş için kullanılacak) <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Başlangıç Şifresi <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="text" name="password" id="pwField" class="form-control" required minlength="8"
                                   placeholder="min. 8 karakter, büyük harf ve rakam içermeli" />
                            <button type="button" class="btn btn-outline-primary" id="pwGen">
                                <iconify-icon icon="iconamoon:synchronize-duotone" class="me-1"></iconify-icon>Şifre Üret
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="pwCopy" title="Kopyala">
                                <iconify-icon icon="iconamoon:copy-duotone"></iconify-icon>
                            </button>
                        </div>
                        <div class="form-text" id="pwHint">Bu şifreyi malike güvenli bir şekilde iletin. Daha sonra "Şifre Sıfırla" ile yenileyebilirsiniz.</div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label">Aktif (giriş yapabilir)</label>
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        Bağımsız bölüm ataması bu hesap oluşturulduktan sonra <a href="/Admin/Units">Bağımsız Bölümler</a> ekranından yapılır.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Oluştur
                        </button>
                        <a href="/Admin/Owners" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var field = document.getElementById('pwField');
    var hint  = document.getElementById('pwHint');
    var seps  = ['!', '*', '.', '?', '-'];

    // Sunucudaki OwnerPasswordGenerator ile aynı kalıp: Brikon!4827
    document.getElementById('pwGen').addEventListener('click', function () {
        var sep = seps[Math.floor(Math.random() * seps.length)];
        var num = Math.floor(1000 + Math.random() * 9000);
        field.value = 'Brikon' + sep + num;
        field.focus();
        field.select();
    });

    document.getElementById('pwCopy').addEventListener('click', function () {
        if (!field.value) return;
        field.select();
        navigator.clipboard.writeText(field.value).then(function () {
            var old = hint.textContent;
            hint.textContent = 'Şifre panoya kopyalandı.';
            setTimeout(function () { hint.textContent = old; }, 2000);
        });
    });
})();
</script>
}
