@model BrikonYapi.Web.Data.Entities.Owner
@{
    ViewData["Title"] = "Yeni Kat Maliki";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card bk-form-card border-0">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:account-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Yeni Kat Maliki Hesabı</h5>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <form asp-area="Admin" asp-controller="Owners" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Hesap Bilgileri</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="bk-label">Ad Soyad <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="bk-label">E-posta <span class="text-muted small">(opsiyonel)</span></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@eposta.com" />
                            </div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Giriş Bilgileri</div>
                        <div class="alert alert-info small mb-3">
                            Kat Maliki Portalı'na giriş artık <strong>telefon numarası</strong> (kullanıcı adı) ve
                            <strong>T.C. Kimlik Numarası</strong> (şifre) ile yapılır.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="bk-label">Telefon (giriş için) <span class="text-danger">*</span></label>
                                <input asp-for="Phone" class="form-control" placeholder="05050646941" required />
                                <div class="form-text bk-hint">11 haneli, başında 0 olacak şekilde.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="bk-label">T.C. Kimlik No (şifre) <span class="text-danger">*</span></label>
                                <input asp-for="TcKimlikNo" class="form-control" required minlength="11" maxlength="11"
                                       pattern="[0-9]{11}" placeholder="11 haneli T.C. Kimlik No" autocomplete="off" />
                                <div class="form-text bk-hint">Malik girişte bu numarayı şifre olarak kullanacak.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label">Aktif (giriş yapabilir)</label>
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        Hesabı oluşturduktan hemen sonra, aynı akışın devamında bağımsız bölüm atayabileceğiniz ekrana yönlendirileceksiniz.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Oluştur
                        </button>
                        <a href="/Admin/Owners" class="btn bk-btn-cancel">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

