@using BrikonYapi.Web.Data.Entities
@model Owner
@{
    ViewData["Title"] = "Kat Maliki Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var allProjects = (List<Project>)(ViewBag.AllProjects ?? new List<Project>());
    var access = (List<OwnerProjectAccess>)(ViewBag.Access ?? new List<OwnerProjectAccess>());
    var ownedProjectIds = Model.Units.Where(u => u.IsActive).Select(u => u.ProjectId).ToHashSet();
    var assignableUnits = (List<Unit>)(ViewBag.AssignableUnits ?? new List<Unit>());
    var ownedUnitIds = Model.Units.Select(u => u.Id).ToHashSet();
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card bk-form-card border-0">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:account-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Kat Maliki Düzenle</h5>
                    <div class="bk-form-hero-subtitle">@Model.FullName</div>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <form asp-area="Admin" asp-controller="Owners" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Hesap Bilgileri</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="bk-label">Ad Soyad <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label class="bk-label">E-posta <span class="text-muted small">(opsiyonel)</span></label>
                                <input asp-for="Email" type="email" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="bk-label">Telefon (giriş kullanıcı adı) <span class="text-danger">*</span></label>
                                <input asp-for="Phone" class="form-control" placeholder="05050646941" required />
                                <div class="form-text bk-hint">Değiştirirseniz malikin giriş kullanıcı adı da değişir.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="bk-label">T.C. Kimlik No (giriş şifresi)</label>
                                <input asp-for="TcKimlikNo" class="form-control" minlength="11" maxlength="11"
                                       pattern="[0-9]{11}" placeholder="11 haneli T.C. Kimlik No" autocomplete="off" />
                                <div class="form-text bk-hint">Değiştirip kaydederseniz malikin şifresi de otomatik güncellenir.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Aktif (giriş yapabilir)</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Kaydet
                        </button>
                        <a href="/Admin/Owners" class="btn bk-btn-cancel">İptal</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card bk-form-card border-0 mt-3">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:home-city-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Bağımsız Bölüm Ata</h5>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <p class="text-muted small mb-3">
                    Bu malikin hangi bağımsız bölüm(ler)e sahip olduğunu buradan işaretleyin. Sadece
                    <strong>sahipsiz bölümler</strong> ve <strong>zaten bu malike ait olan bölümler</strong> listelenir —
                    başka bir malike ait bir bölümü buradan almak için önce
                    <a href="/Admin/Units">Bağımsız Bölümler</a> ekranından o bölümün sahipliğini kaldırmanız gerekir.
                </p>

                @if (!assignableUnits.Any())
                {
                    <div class="text-muted small">Şu an atanabilecek (sahipsiz) bir bağımsız bölüm yok.</div>
                }
                else
                {
                    <form asp-area="Admin" asp-controller="Owners" asp-action="AssignUnits" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ownerId" value="@Model.Id" />

                        <div class="row g-2 mb-3">
                            @foreach (var u in assignableUnits)
                            {
                                var isOwned = ownedUnitIds.Contains(u.Id);
                                <div class="col-md-6">
                                    <label class="d-flex align-items-center gap-2 p-2 border rounded @(isOwned ? "border-primary bg-primary-subtle" : "")">
                                        <input type="checkbox" class="form-check-input mt-0" name="unitIds" value="@u.Id" @(isOwned ? "checked" : "") />
                                        <span>
                                            <span class="fw-semibold">@u.Project?.Name — @u.UnitNo</span>
                                            @if (!string.IsNullOrEmpty(u.BlockNo))
                                            {
                                                <span class="text-muted">(@u.BlockNo)</span>
                                            }
                                            @if (!isOwned)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary ms-1">sahipsiz</span>
                                            }
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>

                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Bölüm Atamasını Kaydet
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="card bk-form-card border-0 mt-3">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:shield-check-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Proje ve Sohbet Erişimi</h5>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <p class="text-muted small mb-3">
                    Bu malikin hangi projelerin <strong>oylamalarını görüp oy kullanabileceğini</strong> ve hangi
                    proje <strong>sohbetine katılabileceğini</strong> burada tek tek belirlersiniz. Bağımsız bölüm
                    sahipliğinden bağımsızdır — bir malik bölümü olmayan bir projenin oylamasına da dahil edilebilir.
                </p>

                @if (!allProjects.Any())
                {
                    <div class="text-muted small">Aktif proje bulunmuyor.</div>
                }
                else
                {
                    <form asp-area="Admin" asp-controller="Owners" asp-action="SaveAccess" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Proje</th>
                                        <th class="text-center" style="width:140px;">Oylamayı Görsün</th>
                                        <th class="text-center" style="width:140px;">Sohbete Katılsın</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in allProjects)
                                    {
                                        var row = access.FirstOrDefault(a => a.ProjectId == p.Id);
                                        var canSee  = row?.CanSeeProject ?? false;
                                        var canChat = row?.CanChat ?? false;
                                        <tr>
                                            <td>
                                                @p.Name
                                                @if (ownedProjectIds.Contains(p.Id))
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary ms-1">bağımsız bölümü var</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-flex justify-content-center">
                                                    <input class="form-check-input" type="checkbox" name="seeProjectIds" value="@p.Id" @(canSee ? "checked" : "") />
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-flex justify-content-center">
                                                    <input class="form-check-input" type="checkbox" name="chatProjectIds" value="@p.Id" @(canChat ? "checked" : "") />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Erişimi Kaydet
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="card bk-form-card border-0 mt-3">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:home-city-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Bağımsız Bölüm Detayları</h5>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <p class="text-muted small mb-3">
                    Kat, oda düzeni ve metrekare bilgisi Kat Maliki Ana Sayfa'sındaki bölüm kartında gösterilir
                    (ör. "3. Kat · 3+1 · 145 m²"). Hangi bölümün bu malike ait olduğunu değiştirmek için yukarıdaki
                    "Bağımsız Bölüm Ata" panelini kullanın; bölümün proje/numara/blok gibi kendi bilgilerini
                    değiştirmek için <a href="/Admin/Units">Bağımsız Bölümler</a> ekranını kullanın.
                </p>

                @if (!Model.Units.Any())
                {
                    <div class="text-muted small">
                        Bu malike atanmış bir bağımsız bölüm yok — yukarıdaki "Bağımsız Bölüm Ata" panelinden ekleyebilirsiniz.
                    </div>
                }
                else
                {
                    @foreach (var u in Model.Units)
                    {
                        <form asp-area="Admin" asp-controller="Owners" asp-action="SaveUnitDetails" method="post" class="bk-field-group mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ownerId" value="@Model.Id" />
                            <input type="hidden" name="unitId" value="@u.Id" />

                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="fw-semibold">@u.Project?.Name — @u.UnitNo @(!string.IsNullOrEmpty(u.BlockNo) ? $"({u.BlockNo})" : "")</div>
                                <a href="/Admin/PaymentPlanTemplates?unitId=@u.Id" class="btn btn-sm btn-outline-primary">
                                    <iconify-icon icon="mdi:file-document-multiple-outline" class="me-1"></iconify-icon>Bu Bölüme Ödeme Planı Uygula
                                </a>
                            </div>

                            <div class="row g-2 align-items-end">
                                <div class="col-3">
                                    <label class="bk-label small mb-1">Kat</label>
                                    <input type="number" name="floorNo" value="@u.FloorNo" class="form-control form-control-sm" placeholder="3" />
                                </div>
                                <div class="col-4">
                                    <label class="bk-label small mb-1">Oda Düzeni</label>
                                    <input type="text" name="roomLayout" value="@u.RoomLayout" class="form-control form-control-sm" placeholder="3+1" maxlength="20" />
                                </div>
                                <div class="col-3">
                                    <label class="bk-label small mb-1">m²</label>
                                    <input type="number" name="areaM2" value="@u.AreaM2" class="form-control form-control-sm" placeholder="145" />
                                </div>
                                <div class="col-2">
                                    <button type="submit" class="btn btn-sm bk-btn-save w-100">Kaydet</button>
                                </div>
                            </div>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>
