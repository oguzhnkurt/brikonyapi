@using BrikonYapi.Web.Data.Entities
@model Owner
@{
    ViewData["Title"] = "Kat Maliki Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var allProjects = (List<Project>)(ViewBag.AllProjects ?? new List<Project>());
    var access = (List<OwnerProjectAccess>)(ViewBag.Access ?? new List<OwnerProjectAccess>());
    var ownedProjectIds = Model.Units.Where(u => u.IsActive).Select(u => u.ProjectId).ToHashSet();
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card bk-form-card border-0">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:account-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Kat Maliki Düzenle</h5>
                    <div class="bk-form-hero-subtitle">@Model.FullName</div>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <form asp-area="Admin" asp-controller="Owners" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Hesap Bilgileri</div>
                        <div class="mb-3">
                            <label class="bk-label">Ad Soyad <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="bk-label">Telefon</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>

                        <div class="mb-0">
                            <label class="bk-label">E-posta</label>
                            <input type="email" class="form-control" value="@Model.Email" disabled />
                            <div class="form-text bk-hint">E-posta (kullanıcı adı) değiştirilemez.</div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Bağımsız Bölümler</div>
                        <div>
                            @if (Model.Units.Any())
                            {
                                foreach (var u in Model.Units)
                                {
                                    <span class="badge bg-info-subtle text-info me-1">@u.Project?.Name — @u.UnitNo (%@u.ProgressPercentage)</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Atanmamış — <a href="/Admin/Units">Bağımsız Bölümler</a> ekranından atayabilirsiniz.</span>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Aktif (giriş yapabilir)</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Kaydet
                        </button>
                        <a href="/Admin/Owners" class="btn bk-btn-cancel">İptal</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card bk-form-card border-0 mt-3">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:shield-check-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Proje ve Sohbet Erişimi</h5>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <p class="text-muted small mb-3">
                    Bu malikin hangi projelerin <strong>oylamalarını görüp oy kullanabileceğini</strong> ve hangi
                    proje <strong>sohbetine katılabileceğini</strong> burada tek tek belirlersiniz. Bağımsız bölüm
                    sahipliğinden bağımsızdır — bir malik bölümü olmayan bir projenin oylamasına da dahil edilebilir.
                </p>

                @if (!allProjects.Any())
                {
                    <div class="text-muted small">Aktif proje bulunmuyor.</div>
                }
                else
                {
                    <form asp-area="Admin" asp-controller="Owners" asp-action="SaveAccess" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Proje</th>
                                        <th class="text-center" style="width:140px;">Oylamayı Görsün</th>
                                        <th class="text-center" style="width:140px;">Sohbete Katılsın</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in allProjects)
                                    {
                                        var row = access.FirstOrDefault(a => a.ProjectId == p.Id);
                                        var canSee  = row?.CanSeeProject ?? false;
                                        var canChat = row?.CanChat ?? false;
                                        <tr>
                                            <td>
                                                @p.Name
                                                @if (ownedProjectIds.Contains(p.Id))
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary ms-1">bağımsız bölümü var</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-flex justify-content-center">
                                                    <input class="form-check-input" type="checkbox" name="seeProjectIds" value="@p.Id" @(canSee ? "checked" : "") />
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-flex justify-content-center">
                                                    <input class="form-check-input" type="checkbox" name="chatProjectIds" value="@p.Id" @(canChat ? "checked" : "") />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Erişimi Kaydet
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="card bk-form-card border-0 mt-3">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:home-city-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Bağımsız Bölüm Detayları</h5>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <p class="text-muted small mb-3">
                    Kat, oda düzeni ve metrekare bilgisi Kat Maliki Ana Sayfa'sındaki bölüm kartında gösterilir
                    (ör. "3. Kat · 3+1 · 145 m²"). Bölümün kendisini (proje, numara, blok, malik ataması) değiştirmek
                    için <a href="/Admin/Units">Bağımsız Bölümler</a> ekranını kullanın.
                </p>

                @if (!Model.Units.Any())
                {
                    <div class="text-muted small">
                        Atanmamış — <a href="/Admin/Units">Bağımsız Bölümler</a> ekranından atayabilirsiniz.
                    </div>
                }
                else
                {
                    @foreach (var u in Model.Units)
                    {
                        <form asp-area="Admin" asp-controller="Owners" asp-action="SaveUnitDetails" method="post" class="bk-field-group mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ownerId" value="@Model.Id" />
                            <input type="hidden" name="unitId" value="@u.Id" />

                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="fw-semibold">@u.Project?.Name — @u.UnitNo @(!string.IsNullOrEmpty(u.BlockNo) ? $"({u.BlockNo})" : "")</div>
                                <a href="/Admin/PaymentPlanTemplates?unitId=@u.Id" class="btn btn-sm btn-outline-primary">
                                    <iconify-icon icon="mdi:file-document-multiple-outline" class="me-1"></iconify-icon>Ödeme Planı Şablonu Uygula
                                </a>
                            </div>

                            <div class="row g-2 align-items-end">
                                <div class="col-3">
                                    <label class="bk-label small mb-1">Kat</label>
                                    <input type="number" name="floorNo" value="@u.FloorNo" class="form-control form-control-sm" placeholder="3" />
                                </div>
                                <div class="col-4">
                                    <label class="bk-label small mb-1">Oda Düzeni</label>
                                    <input type="text" name="roomLayout" value="@u.RoomLayout" class="form-control form-control-sm" placeholder="3+1" maxlength="20" />
                                </div>
                                <div class="col-3">
                                    <label class="bk-label small mb-1">m²</label>
                                    <input type="number" name="areaM2" value="@u.AreaM2" class="form-control form-control-sm" placeholder="145" />
                                </div>
                                <div class="col-2">
                                    <button type="submit" class="btn btn-sm bk-btn-save w-100">Kaydet</button>
                                </div>
                            </div>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>
