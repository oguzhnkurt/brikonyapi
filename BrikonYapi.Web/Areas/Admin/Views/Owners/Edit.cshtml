@using BrikonYapi.Web.Data.Entities
@model Owner
@{
    ViewData["Title"] = "Kat Maliki Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var allProjects = (List<Project>)(ViewBag.AllProjects ?? new List<Project>());
    var access = (List<OwnerProjectAccess>)(ViewBag.Access ?? new List<OwnerProjectAccess>());
    var ownedProjectIds = Model.Units.Where(u => u.IsActive).Select(u => u.ProjectId).ToHashSet();
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Kat Maliki Düzenle</h5>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Owners" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ad Soyad <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Telefon</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">E-posta</label>
                        <input type="email" class="form-control" value="@Model.Email" disabled />
                        <div class="form-text">E-posta (kullanıcı adı) değiştirilemez.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Bağımsız Bölümler</label>
                        <div>
                            @if (Model.Units.Any())
                            {
                                foreach (var u in Model.Units)
                                {
                                    <span class="badge bg-info-subtle text-info me-1">@u.Project?.Name — @u.UnitNo (%@u.ProgressPercentage)</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Atanmamış — <a href="/Admin/Units">Bağımsız Bölümler</a> ekranından atayabilirsiniz.</span>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Aktif (giriş yapabilir)</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Kaydet
                        </button>
                        <a href="/Admin/Owners" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <iconify-icon icon="iconamoon:shield-yes-duotone" class="me-2"></iconify-icon>
                    Proje ve Sohbet Erişimi
                </h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Bu malikin hangi projelerin <strong>oylamalarını görüp oy kullanabileceğini</strong> ve hangi
                    proje <strong>sohbetine katılabileceğini</strong> burada tek tek belirlersiniz. Bağımsız bölüm
                    sahipliğinden bağımsızdır — bir malik bölümü olmayan bir projenin oylamasına da dahil edilebilir.
                </p>

                @if (!allProjects.Any())
                {
                    <div class="text-muted small">Aktif proje bulunmuyor.</div>
                }
                else
                {
                    <form asp-area="Admin" asp-controller="Owners" asp-action="SaveAccess" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Proje</th>
                                        <th class="text-center" style="width:140px;">Oylamayı Görsün</th>
                                        <th class="text-center" style="width:140px;">Sohbete Katılsın</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in allProjects)
                                    {
                                        var row = access.FirstOrDefault(a => a.ProjectId == p.Id);
                                        var canSee  = row?.CanSeeProject ?? false;
                                        var canChat = row?.CanChat ?? false;
                                        <tr>
                                            <td>
                                                @p.Name
                                                @if (ownedProjectIds.Contains(p.Id))
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary ms-1">bağımsız bölümü var</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-flex justify-content-center">
                                                    <input class="form-check-input" type="checkbox" name="seeProjectIds" value="@p.Id" @(canSee ? "checked" : "") />
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-flex justify-content-center">
                                                    <input class="form-check-input" type="checkbox" name="chatProjectIds" value="@p.Id" @(canChat ? "checked" : "") />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Erişimi Kaydet
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <iconify-icon icon="iconamoon:building-1-duotone" class="me-2"></iconify-icon>
                    Bağımsız Bölüm Detayları
                </h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Kat, oda düzeni ve metrekare bilgisi Kat Maliki Ana Sayfa'sındaki bölüm kartında gösterilir
                    (ör. "3. Kat · 3+1 · 145 m²"). Bölümün kendisini (proje, numara, blok, malik ataması) değiştirmek
                    için <a href="/Admin/Units">Bağımsız Bölümler</a> ekranını kullanın.
                </p>

                @if (!Model.Units.Any())
                {
                    <div class="text-muted small">
                        Atanmamış — <a href="/Admin/Units">Bağımsız Bölümler</a> ekranından atayabilirsiniz.
                    </div>
                }
                else
                {
                    @foreach (var u in Model.Units)
                    {
                        <form asp-area="Admin" asp-controller="Owners" asp-action="SaveUnitDetails" method="post" class="border rounded p-3 mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ownerId" value="@Model.Id" />
                            <input type="hidden" name="unitId" value="@u.Id" />

                            <div class="fw-semibold mb-2">@u.Project?.Name — @u.UnitNo @(!string.IsNullOrEmpty(u.BlockNo) ? $"({u.BlockNo})" : "")</div>

                            <div class="row g-2 align-items-end">
                                <div class="col-3">
                                    <label class="form-label small mb-1">Kat</label>
                                    <input type="number" name="floorNo" value="@u.FloorNo" class="form-control form-control-sm" placeholder="3" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label small mb-1">Oda Düzeni</label>
                                    <input type="text" name="roomLayout" value="@u.RoomLayout" class="form-control form-control-sm" placeholder="3+1" maxlength="20" />
                                </div>
                                <div class="col-3">
                                    <label class="form-label small mb-1">m²</label>
                                    <input type="number" name="areaM2" value="@u.AreaM2" class="form-control form-control-sm" placeholder="145" />
                                </div>
                                <div class="col-2">
                                    <button type="submit" class="btn btn-sm btn-primary w-100">Kaydet</button>
                                </div>
                            </div>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>
