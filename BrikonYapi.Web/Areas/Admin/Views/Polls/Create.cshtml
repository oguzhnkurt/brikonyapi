@model BrikonYapi.Web.Data.Entities.Poll
@{
    ViewData["Title"] = "Yeni Oylama";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var projects = ViewBag.Projects as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card bk-form-card border-0">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:poll"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Yeni Oylama</h5>
                    <div class="bk-form-hero-subtitle">
                        Bir malik bu oylamada yalnızca bir kez oy kullanabilir; bu kural veritabanı seviyesinde garanti altındadır.
                    </div>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <form asp-area="Admin" asp-controller="Polls" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Genel Bilgiler</div>

                        <div class="mb-3">
                            <label class="bk-label">Başlık <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Örn: Dış cephe rengi seçimi" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="bk-label">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Oylamanın amacını kısaca açıklayın"></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="bk-label">Kapsam</label>
                                <select asp-for="ProjectId" class="form-select">
                                    <option value="">Tüm projelerdeki malikler</option>
                                    @foreach (var p in projects)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                                <div class="form-text bk-hint">Proje seçerseniz yalnızca o projedeki malikler görür ve oy verebilir.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="bk-label">Kategori</label>
                                <input asp-for="Category" class="form-control" placeholder="Dış Cephe, İç Mekan, Peyzaj, Diğer..." />
                            </div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Oylama Türü</div>
                        <input type="hidden" asp-for="IsConcept" id="IsConceptInput" />
                        <div class="row g-2 mb-2" id="pollTypePicker">
                            <div class="col-md-6">
                                <button type="button" class="pt-card active" data-concept="false">
                                    <iconify-icon icon="mdi:format-list-checks"></iconify-icon>
                                    <span><strong>Standart oylama</strong><small>Her seçenek tek bir fotoğraf/başlık (ör. kapı modeli, renk).</small></span>
                                </button>
                            </div>
                            <div class="col-md-6">
                                <button type="button" class="pt-card" data-concept="true">
                                    <iconify-icon icon="mdi:palette-swatch-outline"></iconify-icon>
                                    <span><strong>Konsept (render) oylaması</strong><small>Her seçenek bir tasarım paketi: odalara göre render görselleri + malzeme kartı.</small></span>
                                </button>
                            </div>
                        </div>
                        <div id="conceptFields" style="display:none">
                            <div class="mb-2">
                                <label class="bk-label">Odalar / Alanlar</label>
                                <input asp-for="ConceptRooms" class="form-control" placeholder="Salon, Mutfak, Banyo, Dış Cephe" />
                                <div class="form-text bk-hint">Virgülle ayırın. Her konsept için bu odaların render görsellerini yükleyeceksiniz. Boş bırakırsanız: Salon, Mutfak, Banyo, Dış Cephe.</div>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="SameCameraAngle" />
                                <label class="form-check-label" asp-for="SameCameraAngle">Render'lar aynı kamera açısından çekildi</label>
                                <div class="form-text bk-hint">İşaretlerseniz kat malikleri iki konsepti kaydırmalı bir sürgüyle üst üste karşılaştırabilir. Farklı açılarsa işaretlemeyin.</div>
                            </div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Zamanlama</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="bk-label">Başlangıç</label>
                                <input asp-for="StartsAt" type="text" autocomplete="off" class="form-control" placeholder="gg.aa.yyyy ss:dd" />
                            </div>
                            <div class="col-md-6">
                                <label class="bk-label">Bitiş</label>
                                <input asp-for="EndsAt" type="text" autocomplete="off" class="form-control" placeholder="gg.aa.yyyy ss:dd" />
                                <div class="form-text bk-hint">Boş bırakılırsa siz kapatana kadar açık kalır.</div>
                            </div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Seçenekler &amp; Durum</div>

                        <div class="mb-3">
                            <label class="bk-label" id="optionsLabel">Seçenekler <span class="text-danger">*</span></label>
                            <div id="optionList" class="d-flex flex-column gap-2">
                                <input name="optionTexts" class="form-control" placeholder="1. seçenek" required />
                                <input name="optionTexts" class="form-control" placeholder="2. seçenek" required />
                            </div>
                            <button type="button" id="addOption" class="btn btn-sm btn-outline-secondary mt-2">
                                <iconify-icon icon="iconamoon:sign-plus-circle-duotone"></iconify-icon> Seçenek ekle
                            </button>
                            <div class="form-text bk-hint">En az iki seçenek gerekir. Görselleri sonraki ekranda yükleyebilirsiniz.</div>
                        </div>

                        <div class="mb-0">
                            <label class="bk-label">Durum</label>
                            <select asp-for="Status" class="form-select">
                                <option value="0">Aktif (maliklere hemen açılsın)</option>
                                <option value="2">Taslak (henüz gösterilmesin)</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Oluştur
                        </button>
                        <a href="/Admin/Polls" class="btn bk-btn-cancel">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .pt-card { width:100%; display:flex; align-items:flex-start; gap:.75rem; text-align:left; padding:.9rem 1rem;
               border:1.5px solid #e3e8ee; border-radius:12px; background:#fff; transition:border-color .15s, background-color .15s; }
    .pt-card iconify-icon { font-size:1.6rem; color:#8a94a0; flex-shrink:0; margin-top:.1rem; }
    .pt-card span { display:flex; flex-direction:column; gap:.15rem; }
    .pt-card strong { font-size:.92rem; color:#1f2937; }
    .pt-card small { font-size:.78rem; color:#6b7684; line-height:1.4; }
    .pt-card.active { border-color:var(--bk-primary, #0082B4); background:#f0f8fc; }
    .pt-card.active iconify-icon { color:var(--bk-primary, #0082B4); }
</style>
}

@section Scripts {
<script>
    // Oylama türü seçici: konsept modunda oda alanları açılır ve seçenek ipuçları "Konsept A/B/C" olur.
    (function () {
        var hidden = document.getElementById('IsConceptInput');
        var fields = document.getElementById('conceptFields');
        var cards = document.querySelectorAll('#pollTypePicker .pt-card');
        function apply(isConcept) {
            hidden.value = isConcept ? 'true' : 'false';
            fields.style.display = isConcept ? 'block' : 'none';
            cards.forEach(function (c) { c.classList.toggle('active', (c.dataset.concept === 'true') === isConcept); });
            document.querySelectorAll('#optionList input').forEach(function (inp, i) {
                inp.placeholder = isConcept ? ('Konsept ' + String.fromCharCode(65 + i)) : ((i + 1) + '. seçenek');
            });
        }
        cards.forEach(function (c) { c.addEventListener('click', function () { apply(c.dataset.concept === 'true'); }); });
        apply(hidden.value === 'true' || hidden.value === 'True');
    })();

    document.getElementById('addOption').addEventListener('click', function () {
        var list = document.getElementById('optionList');
        var input = document.createElement('input');
        input.name = 'optionTexts';
        input.className = 'form-control';
        var isConcept = document.getElementById('IsConceptInput').value === 'true';
        input.placeholder = isConcept ? ('Konsept ' + String.fromCharCode(65 + list.children.length)) : ((list.children.length + 1) + '. seçenek');
        list.appendChild(input);
        input.focus();
    });

    // Tarih/saat alanları brikon-admin-datepicker.js'teki ortak Türkçe flatpickr ile
    // başlatılıyor. Bitiş, başlangıçtan önceki bir tarihe ayarlanamasın — sunucudaki
    // kontrolle aynı kural, burada anında (submit'e gerek kalmadan) uyarı olarak
    // gösteriliyor.
    (function () {
        var startInput = document.getElementById('StartsAt');
        var endInput = document.getElementById('EndsAt');
        if (!startInput || !endInput || !window.brikonInitDateTimePicker) return;

        var startFp = brikonInitDateTimePicker(startInput);
        var endFp = brikonInitDateTimePicker(endInput);
        if (!startFp || !endFp) return;

        function validate() {
            var s = startInput.value, e = endInput.value;
            if (s && e && e <= s) {
                endFp.altInput.classList.add('is-invalid');
                return false;
            }
            endFp.altInput.classList.remove('is-invalid');
            return true;
        }

        startFp.config.onChange.push(function (selectedDates) {
            endFp.set('minDate', selectedDates[0] || null);
            validate();
        });
        endFp.config.onChange.push(validate);

        document.querySelector('form').addEventListener('submit', function (e) {
            if (!validate()) {
                e.preventDefault();
                alert('Bitiş tarihi başlangıçtan sonra olmalıdır.');
            }
        });
    })();
</script>
}
