@using BrikonYapi.Web.Data.Entities
@model Poll
@{
    ViewData["Title"] = "Oylama Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var total = Model.Votes.Count;

    // Rozet, malik ekranıyla aynı mantığı kullanmalı: durum "Aktif" olsa bile başlangıç tarihi
    // gelmemişse malik henüz oy veremez. Aksi halde admin "Aktif" görürken malik göremiyordu.
    var now        = DateTime.Now;
    var notStarted = Model.Status == PollStatus.Active && Model.StartsAt != null && Model.StartsAt > now;
    var expired    = Model.Status == PollStatus.Active && Model.EndsAt != null && Model.EndsAt < now;
    var startsText = Model.StartsAt?.ToString("dd MMMM yyyy HH:mm", tr) ?? "";
    var endsText   = Model.EndsAt?.ToString("dd MMMM yyyy HH:mm", tr) ?? "";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/Admin/Polls" class="btn btn-sm btn-outline-secondary">
        <iconify-icon icon="iconamoon:arrow-left-2"></iconify-icon> Geri
    </a>
    <h5 class="mb-0">@Model.Title</h5>
    @if (Model.Status == PollStatus.Closed)
    {
        <span class="badge bg-secondary-subtle text-secondary">Kapandı</span>
    }
    else if (Model.Status == PollStatus.Draft)
    {
        <span class="badge bg-warning-subtle text-warning">Taslak</span>
    }
    else if (notStarted)
    {
        <span class="badge bg-warning-subtle text-warning">Başlamadı</span>
    }
    else if (expired)
    {
        <span class="badge bg-secondary-subtle text-secondary">Süresi doldu</span>
    }
    else
    {
        <span class="badge bg-success-subtle text-success">Aktif</span>
    }
</div>

@if (notStarted)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 py-2">
        <iconify-icon icon="iconamoon:clock-duotone"></iconify-icon>
        <div class="small">
            Bu oylama <strong>@startsText</strong> tarihinde başlayacak.
            Maliklerin ekranında şu an "Başlamadı" olarak görünüyor ve oy veremiyorlar.
            Hemen açmak isterseniz başlangıç tarihini geçmiş bir tarihe çekin veya boş bırakın.
        </div>
    </div>
}
else if (expired)
{
    <div class="alert alert-secondary d-flex align-items-center gap-2 py-2">
        <iconify-icon icon="iconamoon:clock-duotone"></iconify-icon>
        <div class="small">
            Bitiş tarihi (<strong>@endsText</strong>) geçtiği için
            malikler artık oy veremiyor. Uzatmak için bitiş tarihini ileri alın veya boş bırakın.
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title mb-0">Özet</h6></div>
            <div class="card-body">
                <dl class="row mb-3 small">
                    <dt class="col-5 text-muted fw-normal">Kapsam</dt>
                    <dd class="col-7">@(Model.Project?.Name ?? "Tüm projeler")</dd>

                    <dt class="col-5 text-muted fw-normal">Kategori</dt>
                    <dd class="col-7">@(Model.Category ?? "—")</dd>

                    <dt class="col-5 text-muted fw-normal">Başlangıç</dt>
                    <dd class="col-7">@(Model.StartsAt?.ToString("dd.MM.yyyy HH:mm", tr) ?? "—")</dd>

                    <dt class="col-5 text-muted fw-normal">Bitiş</dt>
                    <dd class="col-7">@(Model.EndsAt?.ToString("dd.MM.yyyy HH:mm", tr) ?? "—")</dd>

                    <dt class="col-5 text-muted fw-normal">Toplam oy</dt>
                    <dd class="col-7 fw-bold">@total</dd>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="border-top pt-2 small text-muted">@Model.Description</div>
                }

                <div class="border-top pt-3 mt-3">
                    <div class="fw-semibold small mb-2">Tarihler</div>

                    <label class="form-label small mb-1">Başlangıç</label>
                    <input type="text" autocomplete="off" id="pollStartsAt" class="form-control form-control-sm mb-2"
                           value="@(Model.StartsAt?.ToString("yyyy-MM-ddTHH:mm"))" placeholder="gg.aa.yyyy ss:dd" />

                    <label class="form-label small mb-1">Bitiş</label>
                    <input type="text" autocomplete="off" id="pollEndsAt" class="form-control form-control-sm mb-2"
                           value="@(Model.EndsAt?.ToString("yyyy-MM-ddTHH:mm"))" placeholder="gg.aa.yyyy ss:dd" />

                    <div class="form-text small mb-0">Boş bırakılan alan sınır tanımaz. Sayfanın altındaki "Kaydet" ile birlikte kaydedilir.</div>

                    @if (notStarted || expired)
                    {
                        <form asp-area="Admin" asp-controller="Polls" asp-action="SetSchedule" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="startNow" value="true" />
                            <button type="submit" class="btn btn-sm btn-success w-100">
                                <iconify-icon icon="iconamoon:player-play-duotone" class="me-1"></iconify-icon>
                                Hemen Başlat
                            </button>
                        </form>
                    }
                </div>

                <div class="d-flex gap-2 mt-3">
                    @if (Model.Status != PollStatus.Active)
                    {
                        <form asp-area="Admin" asp-controller="Polls" asp-action="SetStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="0" />
                            <button type="submit" class="btn btn-sm btn-success">Oylamayı Aç</button>
                        </form>
                    }
                    @if (Model.Status != PollStatus.Closed)
                    {
                        <form asp-area="Admin" asp-controller="Polls" asp-action="SetStatus" method="post"
                              onsubmit="return confirm('Oylama kapatılsın mı? Malikler artık oy veremez.')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="1" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Oylamayı Kapat</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title mb-0">Seçenekler ve Sonuçlar</h6></div>
            <div class="card-body">
                @foreach (var o in Model.Options.OrderBy(o => o.OrderIndex))
                {
                    var count = Model.Votes.Count(v => v.PollOptionId == o.Id);
                    var pct = total > 0 ? (int)Math.Round(count * 100.0 / total) : 0;

                    <div class="d-flex align-items-center gap-3 py-3 border-bottom">
                        <div style="width:56px; height:56px; flex-shrink:0; border-radius:10px;
                                    background:#eef0f2 @(string.IsNullOrEmpty(o.ImagePath) ? "" : $"url('{o.ImagePath}')") center/cover no-repeat;
                                    display:flex; align-items:center; justify-content:center; color:#c3cad1;">
                            @if (string.IsNullOrEmpty(o.ImagePath))
                            {
                                <iconify-icon icon="iconamoon:image-duotone" style="font-size:22px;"></iconify-icon>
                            }
                        </div>

                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-baseline gap-2">
                                <span class="fw-semibold">@o.Text</span>
                                <span class="small text-muted">@count oy · %@pct</span>
                            </div>
                            <div class="progress mt-1" style="height:6px;">
                                <div class="progress-bar" style="width:@(pct)%"></div>
                            </div>

                            <div class="d-flex gap-2 mt-2">
                                <form asp-area="Admin" asp-controller="Polls" asp-action="SetOptionImage" method="post"
                                      enctype="multipart/form-data" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="optionId" value="@o.Id" />
                                    <input type="file" name="image" id="optImg@(o.Id)" class="d-none"
                                           accept=".jpg,.jpeg,.png,.webp" onchange="this.form.submit()" />
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            onclick="document.getElementById('optImg@(o.Id)').click()">
                                        <iconify-icon icon="iconamoon:upload-duotone" class="me-1"></iconify-icon>
                                        Görsel yükle
                                    </button>
                                </form>

                                <form asp-area="Admin" asp-controller="Polls" asp-action="DeleteOption" method="post"
                                      onsubmit="return confirm('Bu seçenek silinsin mi?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="optionId" value="@o.Id" />
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 px-2">Sil</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="card-footer">
                <label class="form-label small mb-1">Yeni seçenek metni (opsiyonel)</label>
                <input id="newOptionInput" class="form-control" placeholder="Örn: Beyaz mermer" />
                <div class="form-text small mb-0">Doldurursan sayfanın altındaki "Kaydet" ile birlikte eklenir.</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end align-items-center gap-2 mt-3">
    <span class="text-muted small">Tarihler ve yeni seçenek burada birlikte kaydedilir.</span>
    <form id="saveAllForm" asp-area="Admin" asp-controller="Polls" asp-action="SaveAll" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="startsAt" id="hiddenStartsAt" />
        <input type="hidden" name="endsAt" id="hiddenEndsAt" />
        <input type="hidden" name="newOptionText" id="hiddenNewOptionText" />
    </form>
    <button type="button" id="saveAllBtn" class="btn bk-btn-save btn-lg">
        <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-2"></iconify-icon>
        Kaydet
    </button>
</div>

@section Scripts {
<script>
    // Tarih/saat alanları brikon-admin-datepicker.js'teki ortak Türkçe flatpickr ile
    // başlatılıyor. Bitiş, başlangıçtan önceki bir tarihe ayarlanamasın — sunucudaki
    // (SaveAll) kontrolle aynı kural, burada anında uyarı olarak gösteriliyor. Tarihler
    // ve yeni seçenek metni ayrı ayrı değil, tek bir "Kaydet" butonuyla gizli
    // saveAllForm üzerinden birlikte gönderiliyor.
    (function () {
        var startInput = document.getElementById('pollStartsAt');
        var endInput = document.getElementById('pollEndsAt');
        var newOptionInput = document.getElementById('newOptionInput');
        var saveBtn = document.getElementById('saveAllBtn');
        var form = document.getElementById('saveAllForm');
        if (!startInput || !endInput || !saveBtn || !form) return;

        var startFp = window.brikonInitDateTimePicker ? brikonInitDateTimePicker(startInput) : null;
        var endFp = window.brikonInitDateTimePicker ? brikonInitDateTimePicker(endInput) : null;

        function isInvalid() {
            return startInput.value && endInput.value && endInput.value <= startInput.value;
        }

        if (startFp && endFp) {
            startFp.config.onChange.push(function (selectedDates) {
                endFp.set('minDate', selectedDates[0] || null);
                endFp.altInput.classList.toggle('is-invalid', !!isInvalid());
            });
            endFp.config.onChange.push(function () {
                endFp.altInput.classList.toggle('is-invalid', !!isInvalid());
            });
        }

        saveBtn.addEventListener('click', function () {
            if (isInvalid()) {
                alert('Bitiş tarihi başlangıçtan sonra olmalıdır.');
                return;
            }
            document.getElementById('hiddenStartsAt').value = startInput.value || '';
            document.getElementById('hiddenEndsAt').value = endInput.value || '';
            document.getElementById('hiddenNewOptionText').value = newOptionInput ? newOptionInput.value.trim() : '';
            form.submit();
        });
    })();
</script>
}
