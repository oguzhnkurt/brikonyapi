@using BrikonYapi.Web.Data.Entities
@model List<Poll>
@{
    ViewData["Title"] = "Oylamalar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <div>
            <h5 class="card-title mb-0">Oylamalar (@Model.Count)</h5>
            <div class="text-muted small mt-1">Kat maliklerine sunulan anketler ve malzeme seçimleri.</div>
        </div>
        <div class="d-flex gap-2">
            <form asp-area="Admin" asp-controller="Polls" asp-action="OptimizeImages" method="post"
                  onsubmit="return confirm('Tüm seçenek görselleri taranıp gerekiyorsa küçültülecek. Devam edilsin mi?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Yavaş yüklenen büyük görselleri küçültür">
                    <iconify-icon icon="iconamoon:lightning-2-duotone" class="me-1"></iconify-icon>
                    Görselleri Optimize Et
                </button>
            </form>
            <a href="/Admin/Polls/Create" class="btn btn-primary btn-sm">
                <iconify-icon icon="iconamoon:sign-plus-circle-duotone" class="me-1"></iconify-icon>
                Yeni Oylama
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5">
                <iconify-icon icon="iconamoon:check-square-duotone" style="font-size:48px;"></iconify-icon>
                <span class="mt-2">Henüz oylama oluşturulmamış.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Başlık</th>
                            <th>Kapsam</th>
                            <th>Kategori</th>
                            <th>Seçenek</th>
                            <th>Oy</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td><strong>@p.Title</strong></td>
                                <td class="small">@(p.Project?.Name ?? "Tüm projeler")</td>
                                <td class="small">@(p.Category ?? "—")</td>
                                <td class="small">@p.Options.Count</td>
                                <td class="small fw-semibold">@p.Votes.Count</td>
                                <td>
                                    @switch (p.Status)
                                    {
                                        case PollStatus.Active:
                                            <span class="badge bg-success-subtle text-success">Aktif</span>
                                            break;
                                        case PollStatus.Closed:
                                            <span class="badge bg-secondary-subtle text-secondary">Kapandı</span>
                                            break;
                                        default:
                                            <span class="badge bg-warning-subtle text-warning">Taslak</span>
                                            break;
                                    }
                                </td>
                                <td class="text-muted small">@p.CreatedAt.ToString("dd.MM.yyyy", tr)</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a href="/Admin/Polls/Manage/@p.Id" class="btn btn-sm btn-outline-primary">
                                            <iconify-icon icon="iconamoon:settings-duotone"></iconify-icon> Yönet
                                        </a>
                                        <form asp-area="Admin" asp-controller="Polls" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu oylama ve tüm oyları silinsin mi?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <iconify-icon icon="iconamoon:trash-duotone"></iconify-icon>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
