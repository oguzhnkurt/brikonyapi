@model BrikonYapi.Web.Data.Entities.PaymentSchedule
@using BrikonYapi.Web.Data.Entities
@{
    var unit = (Unit)ViewBag.Unit;
    var stages = (List<ProjectStage>)ViewBag.Stages;
    ViewData["Title"] = "Ödeme Kalemi Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Ödeme Kalemi Düzenle — @unit.Project?.Name / @unit.UnitNo</h5>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="PaymentSchedules" asp-action="Edit" asp-route-id="@Model.Id" method="post" id="pmEditForm">
                    @Html.AntiForgeryToken()

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tutar <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <select asp-for="Currency" class="form-select pm-currency-select">
                                    <option value="@BrikonYapi.Web.Data.Entities.PaymentCurrency.TRY">₺ TL</option>
                                    <option value="@BrikonYapi.Web.Data.Entities.PaymentCurrency.USD">$ USD</option>
                                    <option value="@BrikonYapi.Web.Data.Entities.PaymentCurrency.EUR">€ EUR</option>
                                </select>
                                <input type="text" id="pmAmount" inputmode="numeric" class="form-control"
                                       value="@Model.Amount.ToString("N0", new System.Globalization.CultureInfo("tr-TR"))" required autocomplete="off" />
                                <input type="hidden" asp-for="Amount" id="pmAmountHidden" />
                            </div>
                            <div class="form-text small">Malik doğrudan seçilen para biriminde öder (TL karşılığı hesaplanmaz).</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Vade Tarihi <span class="text-danger">*</span></label>
                            <input asp-for="DueDate" type="date" class="form-control" value="@Model.DueDate.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <input asp-for="Description" class="form-control" placeholder="Örn: 3. Hakediş Taksiti" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">İnşaat Aşaması</label>
                        <select asp-for="ProjectStageId" id="pmStageSelect" class="form-select">
                            <option value="">Aşamaya bağlı değil (elle gir)</option>
                            @foreach (var st in stages)
                            {
                                <option value="@st.Id">@st.Name</option>
                            }
                        </select>
                        <div class="form-text small">Seçilirse aşama "Tamamlandı" olunca malike gösterilir.</div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Hakediş %</label>
                            <input asp-for="HakedisPercentage" id="pmHakedisInput" type="number" min="0" max="100" class="form-control" placeholder="20" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Taksit No</label>
                            <input asp-for="InstallmentNo" type="number" min="0" class="form-control" placeholder="3" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Durum</label>
                            <select asp-for="Status" class="form-select">
                                <option value="0">Bekliyor</option>
                                <option value="1">Ödendi</option>
                                <option value="2">Gecikti</option>
                                <option value="3">İptal</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Kaydet
                        </button>
                        <a href="/Admin/PaymentSchedules?unitId=@unit.Id" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* Tema'nın .form-select'i geniş sağ dolgu (chevron için ~3rem) kullanır; dar (90px) bir
       kutuda bu, seçili metni ("₺ TL" vb.) tamamen görünmez kılıyordu. Dolguyu daraltıp kutuyu
       biraz genişleterek metnin görünür kalmasını sağlıyoruz. */
    .pm-currency-select {
        max-width: 108px; flex: 0 0 auto;
        padding: .375rem 1.75rem .375rem .5rem !important;
        background-position: right .5rem center !important;
    }
</style>

@section Scripts {
<script>
(function () {
    var display = document.getElementById('pmAmount');
    var hidden  = document.getElementById('pmAmountHidden');
    var form    = document.getElementById('pmEditForm');

    display.addEventListener('input', function () {
        var digits = display.value.replace(/\D/g, '');
        display.value = digits ? Number(digits).toLocaleString('tr-TR') : '';
    });

    form.addEventListener('submit', function () {
        hidden.value = display.value.replace(/\D/g, '');
    });

})();
</script>
}
