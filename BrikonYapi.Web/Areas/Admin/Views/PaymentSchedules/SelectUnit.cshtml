@model List<BrikonYapi.Web.Data.Entities.Unit>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Ödeme Planları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var selectedProjectId = (int?)ViewBag.SelectedProjectId;
    var stats = (Dictionary<int, (int Total, int Paid, int Overdue)>)ViewBag.Stats;
}

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0">Ödeme Planları</h4>
        <div class="text-muted small">
            Bir bağımsız bölümün taksitlerini görüntülemek, elle taksit eklemek ya da düzenlemek için
            aşağıdan bölümü seçin. Henüz planı olmayan bölümlere "Şablon Uygula" ile hazır bir ödeme planı
            uygulayabilir ya da "Oluştur" ile elle taksit girebilirsiniz.
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <form method="get" class="d-flex align-items-center gap-2">
            <select name="projectId" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width:200px">
                <option value="">Tüm Projeler</option>
                @foreach (var item in (SelectList)ViewBag.Projects)
                {
                    <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
                }
            </select>
        </form>
        <input type="text" id="unitSearch" class="form-control form-control-sm" style="min-width:200px"
               placeholder="Bölüm no veya malik ara..." />
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5">
                <span>Önce <a href="/Admin/Units/Create">bağımsız bölüm</a> eklemelisiniz.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="unitTable">
                    <thead class="table-light">
                        <tr>
                            <th>Proje</th>
                            <th>Bağımsız Bölüm</th>
                            <th>Malik</th>
                            <th>Ödeme Planı Durumu</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            var hasStat = stats.TryGetValue(u.Id, out var stat);
                            int total = hasStat ? stat.Total : 0;
                            int paid = hasStat ? stat.Paid : 0;
                            int overdue = hasStat ? stat.Overdue : 0;
                            var ownerName = u.Owner?.FullName ?? "Atanmamış";
                            <tr data-search="@($"{u.UnitNo} {u.BlockNo} {ownerName}".ToLowerInvariant())">
                                <td>@u.Project?.Name</td>
                                <td><strong>@u.UnitNo</strong> <span class="text-muted small">@u.BlockNo</span></td>
                                <td>@ownerName</td>
                                <td>
                                    @if (total == 0)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Plan yok</span>
                                    }
                                    else if (overdue > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger">@overdue gecikmiş</span>
                                        <span class="text-muted small">· @paid/@total ödendi</span>
                                    }
                                    else if (paid == total)
                                    {
                                        <span class="badge bg-success-subtle text-success">Tümü ödendi (@total)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">@paid/@total ödendi</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        @if (total == 0)
                                        {
                                            <a href="/Admin/PaymentPlanTemplates?unitId=@u.Id" class="btn btn-sm btn-outline-info" title="Hazır bir ödeme planı şablonunu bu bölüme uygula">
                                                <iconify-icon icon="mdi:file-document-multiple-outline"></iconify-icon>
                                                Şablon Uygula
                                            </a>
                                            <a href="/Admin/PaymentSchedules?unitId=@u.Id" class="btn btn-sm btn-primary" title="Bu bölüme taksitleri tek tek elle ekle">
                                                Oluştur
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="/Admin/PaymentSchedules?unitId=@u.Id" class="btn btn-sm btn-outline-primary">
                                                Görüntüle
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
(function () {
    var input = document.getElementById('unitSearch');
    if (!input) return;
    input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        document.querySelectorAll('#unitTable tbody tr').forEach(function (row) {
            var hay = row.getAttribute('data-search') || '';
            row.style.display = hay.indexOf(q) === -1 ? 'none' : '';
        });
    });
})();
</script>
}
