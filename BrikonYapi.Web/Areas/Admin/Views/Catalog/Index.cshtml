@model List<BrikonYapi.Web.Data.Entities.Catalog>
@using BrikonYapi.Web.Data.Entities
@{
    ViewData["Title"] = "E-Katalog Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4 mb-4">

    <!-- Manuel Yükleme Kartı -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <iconify-icon icon="iconamoon:upload-duotone" style="font-size:22px;color:#0d6efd;"></iconify-icon>
                <h5 class="card-title mb-0">Seçenek 1 — Manuel PDF Yükle</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Admin paneli üzerinden istediğiniz PDF kataloğu yükleyin. Yüklenen dosya sunucuda saklanır.</p>
                <form asp-area="Admin" asp-controller="Catalog" asp-action="UploadManual" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Katalog Başlığı</label>
                        <input type="text" name="title" class="form-control" placeholder="Örn: 2025 Brikon Yapı Kataloğu" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Açıklama <span class="text-muted fw-normal">(opsiyonel)</span></label>
                        <input type="text" name="description" class="form-control" placeholder="Kısa açıklama..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">PDF Dosyası <span class="text-danger">*</span></label>
                        <input type="file" name="pdf" class="form-control" accept=".pdf" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <iconify-icon icon="iconamoon:cloud-upload-duotone" class="me-1"></iconify-icon>
                        Yükle & Kaydet
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Otomatik Katalog Kartı -->
    <div class="col-md-6">
        <div class="card h-100 border-success">
            <div class="card-header d-flex align-items-center gap-2 bg-success-subtle">
                <iconify-icon icon="iconamoon:magic-wand-duotone" style="font-size:22px;color:#198754;"></iconify-icon>
                <h5 class="card-title mb-0 text-success">Seçenek 2 — Otomatik Katalog Oluştur</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    Sistemdeki tüm aktif projelerden <strong>otomatik olarak</strong> profesyonel bir PDF katalog oluşturur.
                </p>
                <ul class="text-muted small mb-3 ps-3">
                    <li>Kapak sayfası, içindekiler, proje sayfaları</li>
                    <li>Her proje için görsel, konum, istatistikler</li>
                    <li>Şirket bilgileri ve iletişim sayfası</li>
                    <li>Brikon Yapı kurumsal tasarım</li>
                </ul>
                <form asp-area="Admin" asp-controller="Catalog" asp-action="GenerateAuto" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Katalog Başlığı <span class="text-muted fw-normal">(opsiyonel)</span></label>
                        <input type="text" name="title" class="form-control" placeholder="Örn: 2025 Brikon Yapı Kataloğu" />
                    </div>
                    <button type="submit" class="btn btn-success w-100" id="generateBtn"
                            onclick="this.innerHTML='<span class=\'spinner-border spinner-border-sm me-2\'></span>Oluşturuluyor...'; this.disabled=true; this.form.submit();">
                        <iconify-icon icon="iconamoon:magic-wand-duotone" class="me-1"></iconify-icon>
                        Kataloğu Otomatik Oluştur
                    </button>
                    <div class="form-text mt-2 text-center">⏱ Proje sayısına göre 5–20 saniye sürebilir.</div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Katalog Listesi -->
<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Mevcut Kataloglar</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5">
                <iconify-icon icon="iconamoon:file-document-duotone" style="font-size:48px;"></iconify-icon>
                <span class="mt-2">Henüz katalog eklenmemiş.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Başlık</th>
                            <th>Tür</th>
                            <th>PDF Yolu</th>
                            <th>Durum</th>
                            <th>Eklenme</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr class="@(c.IsActive ? "table-success" : "")">
                                <td>
                                    <strong>@c.Title</strong>
                                    @if (!string.IsNullOrEmpty(c.Description))
                                    {
                                        <div class="text-muted small">@c.Description</div>
                                    }
                                </td>
                                <td>
                                    @if (c.Type == CatalogType.Manual)
                                    {
                                        <span class="badge bg-primary-subtle text-primary">Manuel</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">Sistem</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.PdfPath))
                                    {
                                        <a href="@c.PdfPath" target="_blank" class="text-decoration-none small">
                                            <iconify-icon icon="iconamoon:file-pdf-duotone" class="me-1 text-danger"></iconify-icon>
                                            PDF Görüntüle
                                        </a>
                                    }
                                </td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                                            Aktif (Header'da Gösteriliyor)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                    }
                                </td>
                                <td class="text-muted small">@c.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        @if (!c.IsActive)
                                        {
                                            <form asp-area="Admin" asp-controller="Catalog" asp-action="SetActive" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                                                    Aktif Yap
                                                </button>
                                            </form>
                                        }
                                        <form asp-area="Admin" asp-controller="Catalog" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu kataloğu silmek istediğinize emin misiniz?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <iconify-icon icon="iconamoon:trash-duotone"></iconify-icon>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
