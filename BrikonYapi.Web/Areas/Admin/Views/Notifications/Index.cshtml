@using BrikonYapi.Web.Data.Entities
@model List<Owner>
@{
    ViewData["Title"] = "Bildirimler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var prefs = (List<OwnerNotificationPreference>)(ViewBag.NotificationPrefs ?? new List<OwnerNotificationPreference>());
    var history = (List<NotificationLog>)(ViewBag.History ?? new List<NotificationLog>());
    int historyPage = ViewBag.HistoryPage ?? 1;
    int historyPageSize = ViewBag.HistoryPageSize ?? 25;
    int historyTotalPages = ViewBag.HistoryTotalPages ?? 1;
    int historyTotalCount = ViewBag.HistoryTotalCount ?? 0;
    string reminderCheckpoints = ViewBag.ReminderCheckpoints;
    string reminderMessageTemplate = ViewBag.ReminderMessageTemplate;
    var reminderDaysSelected = (reminderCheckpoints ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(x => int.TryParse(x, out var n) ? n : (int?)null)
        .Where(n => n.HasValue)
        .Select(n => n!.Value)
        .ToHashSet();
    bool whatsAppConfigured = ViewBag.WhatsAppConfigured;
    var tr = new System.Globalization.CultureInfo("tr-TR");

    string ChannelLabel(NotificationChannel c) => c switch
    {
        NotificationChannel.WhatsApp => "WhatsApp",
        NotificationChannel.Sms      => "SMS",
        _                             => "E-posta"
    };

    string StatusBadge(NotificationStatus s) => s switch
    {
        NotificationStatus.Sent   => "<span class=\"badge bg-success-subtle text-success\">Gönderildi</span>",
        NotificationStatus.Failed => "<span class=\"badge bg-danger-subtle text-danger\">Başarısız</span>",
        _                          => "<span class=\"badge bg-warning-subtle text-warning\">Bekliyor</span>"
    };

    string[] recipientColors =
    {
        "#e17076", "#7bc862", "#e0a11a", "#54b4d3", "#a695e7",
        "#e07bb0", "#65aadd", "#c98f4a", "#ff8a65", "#4db6ac"
    };
    string ColorFor(string name)
    {
        var sum = 0;
        foreach (var c in name) sum += c;
        return recipientColors[Math.Abs(sum) % recipientColors.Length];
    }
    string InitialsFor(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }
}

@section Styles {
<style>
    .owner-pick-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: .6rem;
        max-height: 320px;
        overflow-y: auto;
        padding: .2rem;
    }
    .owner-pick-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .6rem .7rem;
        border: 1px solid #e3e7ec;
        border-radius: 10px;
        cursor: pointer;
        transition: border-color .15s, background-color .15s, box-shadow .15s;
        background: #fff;
    }
    .owner-pick-card:hover:not(.disabled) {
        border-color: #0082B4;
        box-shadow: 0 2px 8px rgba(0,130,180,.10);
    }
    .owner-pick-card.selected {
        border-color: #0082B4;
        background: rgba(0,130,180,.06);
    }
    .owner-pick-card.disabled {
        cursor: not-allowed;
        opacity: .55;
    }
    .owner-pick-avatar {
        width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0; color: #fff;
        font-size: .8rem; font-weight: 700; display: flex; align-items: center; justify-content: center;
    }
    .owner-pick-info { min-width: 0; flex: 1; }
    .owner-pick-name {
        font-size: .85rem; font-weight: 600; color: #1f2937;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .owner-pick-meta {
        font-size: .72rem; color: #8a94a3;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .owner-pick-badge { font-size: .65rem; margin-top: 2px; display: inline-block; }
    .owner-pick-check {
        position: absolute; top: 6px; right: 6px;
        font-size: 1.05rem; color: #0082B4; opacity: 0; transform: scale(.7);
        transition: opacity .15s, transform .15s;
    }
    .owner-pick-card.selected .owner-pick-check { opacity: 1; transform: scale(1); }

    /* Mesaj şablonu önizlemesi: sohbet balonu gibi, WhatsApp'ta göründüğü hale yakın */
    .bk-tpl-preview-wrap { margin-top: .85rem; }
    .bk-tpl-preview-label {
        font-size: .68rem; font-weight: 700; color: #9aa3b0;
        text-transform: uppercase; letter-spacing: .04em;
        margin-bottom: .45rem; display: flex; align-items: center; gap: .35rem;
    }
    .bk-tpl-preview-row { display: flex; align-items: flex-end; gap: .5rem; }
    .bk-tpl-preview-avatar {
        flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%;
        background: #25d366; color: #fff; display: flex; align-items: center;
        justify-content: center; font-size: .95rem;
    }
    .bk-tpl-preview-bubble {
        position: relative;
        background: #e9fbe0;
        border: 1px solid #d3f3c4;
        border-radius: 12px;
        padding: .65rem .85rem;
        font-size: .84rem;
        line-height: 1.5;
        color: #253339;
        white-space: pre-wrap;
        word-break: break-word;
        max-width: 520px;
        box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
    }
    .bk-tpl-preview-bubble::before {
        content: "";
        position: absolute;
        left: -7px;
        bottom: 9px;
        width: 0; height: 0;
        border-top: 7px solid transparent;
        border-bottom: 7px solid transparent;
        border-right: 8px solid #e9fbe0;
        filter: drop-shadow(-1px 0 0 #d3f3c4);
    }
    .bk-tpl-preview-bubble:empty::before { display: none; }
</style>
}

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2 bk-page-header">
    <div>
        <h5 class="mb-0">
            <iconify-icon icon="mdi:bell-outline" class="me-1"></iconify-icon>
            Bildirimler
        </h5>
        <span class="text-muted small">Kat maliklerine manuel WhatsApp gönderin, geçmişi görün, otomatik hatırlatıcıyı ayarlayın.</span>
    </div>
    <a href="/Admin/Owners" class="btn btn-outline-secondary btn-sm">
        <iconify-icon icon="iconamoon:arrow-left-2-duotone" class="me-1"></iconify-icon>
        Kat Maliklerine Dön
    </a>
</div>

@if (!whatsAppConfigured)
{
    <div class="alert alert-light border small text-muted d-flex gap-2 align-items-start mb-3">
        <iconify-icon icon="iconamoon:information-circle-duotone" class="fs-18 text-warning flex-shrink-0"></iconify-icon>
        <div>
            WhatsApp gönderimi henüz tam yapılandırılmamış (360dialog API anahtarı ve/veya onaylı şablon adı eksik).
            Sunucu ayarlarından (Coolify ortam değişkenleri) <code>WhatsApp:ApiKey</code> ve
            <code>WhatsApp:ManualTemplateName</code> girilmeden gönderim yapılamaz.
        </div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bk-form-card border-0">
            <div class="card-body bk-form-body">
                <div class="bk-group-title mb-2">
                    <iconify-icon icon="ic:baseline-whatsapp" class="text-success me-1"></iconify-icon>
                    Manuel WhatsApp Gönder
                </div>

                <form asp-area="Admin" asp-controller="Notifications" asp-action="SendWhatsApp" method="post" id="sendForm">
                    @Html.AntiForgeryToken()
                    <div id="hiddenOwnerIds"></div>

                    <div class="mb-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <label class="bk-label mb-0">Alıcılar</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="text" id="ownerSearch" class="form-control form-control-sm" style="width:200px" placeholder="İsimde ara…" />
                            <button type="button" id="btnSelectAll" class="btn btn-sm btn-outline-secondary">Tümünü Seç</button>
                            <button type="button" id="btnClearAll" class="btn btn-sm btn-outline-secondary">Temizle</button>
                        </div>
                    </div>

                    <div class="owner-pick-grid" id="ownerGrid">
                        @foreach (var o in Model)
                        {
                            var pref = prefs.FirstOrDefault(p => p.OwnerId == o.Id);
                            var waOn = pref?.WhatsAppEnabled ?? true;
                            var hasPhone = !string.IsNullOrWhiteSpace(o.Phone);
                            var disabled = !hasPhone || !waOn;
                            var meta = o.Units.Any() ? string.Join(", ", o.Units.Select(u => u.Project?.Name + " " + u.UnitNo)) : "Atanmamış";
                            <div class="owner-pick-card@(disabled ? " disabled" : "")" data-id="@o.Id" data-name="@o.FullName.ToLower()" tabindex="@(disabled ? "-1" : "0")">
                                <input type="checkbox" class="d-none owner-check" value="@o.Id" data-name="@o.FullName" @(disabled ? "disabled" : "") />
                                <iconify-icon icon="mdi:check-circle" class="owner-pick-check"></iconify-icon>
                                <div class="owner-pick-avatar" style="background:@ColorFor(o.FullName);">@InitialsFor(o.FullName)</div>
                                <div class="owner-pick-info">
                                    <div class="owner-pick-name">@o.FullName</div>
                                    <div class="owner-pick-meta">@meta</div>
                                    @if (!hasPhone)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary owner-pick-badge">Telefon yok</span>
                                    }
                                    else if (!waOn)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary owner-pick-badge">WhatsApp kapalı</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="text-muted small mt-2"><span id="selectedCount">0</span> kişi seçili</div>

                    <div class="mt-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="bk-label mb-0">Mesaj</label>
                            <span class="text-muted small"><span id="messageCharCount">0</span>/600</span>
                        </div>
                        <textarea name="message" id="messageInput" class="form-control" rows="3" maxlength="600" required
                                  placeholder="Mesajınızı yazın…"></textarea>
                        <div class="form-text bk-hint">
                            Bu mesaj, onaylı bir WhatsApp şablonu içinde ("Sayın [Ad Soyad], [mesajınız]") gönderilir —
                            serbest metin olarak değil, Meta'nın kurallarına uygun şekilde iletilir.
                        </div>
                        <div class="bk-tpl-preview-wrap">
                            <div class="bk-tpl-preview-label">
                                <iconify-icon icon="mdi:eye-outline"></iconify-icon>
                                Malik bu mesajı böyle görecek
                            </div>
                            <div class="bk-tpl-preview-row">
                                <div class="bk-tpl-preview-avatar"><iconify-icon icon="ic:baseline-whatsapp"></iconify-icon></div>
                                <div class="bk-tpl-preview-bubble" id="manualTemplatePreview"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-success btn-sm" id="btnSubmitSend" disabled>
                            <iconify-icon icon="ic:baseline-whatsapp" class="me-1"></iconify-icon>
                            Gönder
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card bk-form-card border-0 mb-3">
    <div class="card-body bk-form-body">
        <div class="bk-group-title mb-2">
            <iconify-icon icon="mdi:clock-alert-outline" class="me-1"></iconify-icon>
            Otomatik Hatırlatıcı
        </div>
        <div class="text-muted small mb-3">
            Ödeme vadesinden önce, seçilen günlerde malike otomatik olarak (her gece kontrol edilir) bir hatırlatma gönderilir.
            SMS ve e-posta kanalları şu an için devre dışı — hatırlatma yalnızca WhatsApp üzerinden, aşağıdaki mesaj şablonuyla
            gönderilir; bunun için onaylı bir şablon adı sunucu ayarlarından (<code>WhatsApp:ReminderTemplateName</code>) tanımlanmış olmalı.
        </div>

        <form asp-area="Admin" asp-controller="Notifications" asp-action="SaveReminderSettings" method="post" id="reminderForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="checkpoints" id="checkpointsInput" value="@reminderCheckpoints" />

            <div class="row g-4">
                <div class="col-lg-5">
                    <label class="bk-label">Vadeye kaç gün/hafta kala hatırlatılsın?</label>
                    <div class="d-flex flex-wrap gap-2" id="dayPresets">
                        @foreach (var (days, label) in new (int, string)[] { (1, "1 gün"), (3, "3 gün"), (7, "1 hafta"), (14, "2 hafta"), (30, "1 ay") })
                        {
                            <button type="button" class="btn btn-sm day-chip @(reminderDaysSelected.Contains(days) ? "btn-primary" : "btn-outline-secondary")" data-days="@days">
                                @label
                            </button>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-2" id="customDayChips">
                        @{
                            var presetDays = new[] { 1, 3, 7, 14, 30 };
                            var customDays = reminderDaysSelected.Where(d => !presetDays.Contains(d)).OrderByDescending(d => d);
                        }
                        @foreach (var d in customDays)
                        {
                            <span class="btn btn-sm btn-primary day-chip-custom" data-days="@d">
                                @d gün
                                <iconify-icon icon="mdi:close" class="ms-1 remove-custom-day"></iconify-icon>
                            </span>
                        }
                    </div>

                    <div class="input-group input-group-sm mt-2" style="max-width:220px">
                        <input type="number" min="1" max="365" class="form-control" id="customDayInput" placeholder="Özel gün sayısı" />
                        <button type="button" class="btn btn-outline-primary" id="btnAddCustomDay">
                            <iconify-icon icon="iconamoon:sign-plus-circle-duotone"></iconify-icon>
                        </button>
                    </div>

                    <div class="form-text bk-hint mt-2">
                        Bir veya birden fazla seçebilirsiniz. Vadesi bu günlere denk gelen ödemeler için aynı gün tekrar gönderilmez.
                    </div>
                </div>

                <div class="col-lg-7">
                    <label class="bk-label">Mesaj Şablonu</label>
                    <textarea name="messageTemplate" id="messageTemplateInput" class="form-control" rows="3" maxlength="500">@reminderMessageTemplate</textarea>
                    <div class="form-text bk-hint">
                        Kullanılabilir yer tutucular:
                        <code>{ad}</code> malik adı, <code>{aciklama}</code> taksit açıklaması,
                        <code>{ne_zaman}</code> "yarın" / "1 hafta içinde" gibi ifade, <code>{vade}</code> vade tarihi, <code>{tutar}</code> tutar.
                    </div>

                    <div class="bk-tpl-preview-wrap">
                        <div class="bk-tpl-preview-label">
                            <iconify-icon icon="mdi:eye-outline"></iconify-icon>
                            Malik bu mesajı böyle görecek
                        </div>
                        <div class="bk-tpl-preview-row">
                            <div class="bk-tpl-preview-avatar"><iconify-icon icon="ic:baseline-whatsapp"></iconify-icon></div>
                            <div class="bk-tpl-preview-bubble" id="templatePreview"></div>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn bk-btn-save btn-sm mt-3">
                <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                Kaydet
            </button>
        </form>

        <hr class="my-3" />

        <div class="text-muted small">
            <iconify-icon icon="iconamoon:information-circle-duotone" class="text-warning me-1"></iconify-icon>
            Her kat malikinin bildirim tercihleri (SMS/E-posta/WhatsApp açık-kapalı) ve telefon numarası
            <a href="/Admin/Owners">Kat Malikleri</a> ekranındaki "Bildirimler" butonundan düzenlenir.
        </div>
    </div>
</div>

<div class="card bk-form-card border-0" id="historyCard">
    <div class="card-body bk-form-body">
        <div id="historyContainer">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div class="bk-group-title mb-0">
                <iconify-icon icon="mdi:history" class="me-1"></iconify-icon>
                Gönderim Geçmişi
                @if (historyTotalCount > 0)
                {
                    <span class="text-muted small fw-normal">(@historyTotalCount kayıt)</span>
                }
            </div>
            @if (historyTotalCount > 0)
            {
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted small me-1">Sayfa başına:</span>
                    @foreach (var size in new[] { 25, 50, 100 })
                    {
                        <a href="/Admin/Notifications?page=1&amp;pageSize=@size"
                           class="btn btn-sm history-page-link @(historyPageSize == size ? "btn-primary" : "btn-outline-secondary")">@size</a>
                    }
                </div>
            }
        </div>

        @if (!history.Any())
        {
            <div class="text-muted small py-3 text-center">Henüz gönderilmiş bir bildirim yok.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Kat Maliki</th>
                            <th>Kanal</th>
                            <th>Mesaj</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in history)
                        {
                            <tr>
                                <td class="text-muted small">@h.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@(h.Owner?.FullName ?? "—")</td>
                                <td>
                                    @if (h.Channel == NotificationChannel.WhatsApp)
                                    {
                                        <iconify-icon icon="ic:baseline-whatsapp" class="text-success"></iconify-icon>
                                    }
                                    @ChannelLabel(h.Channel)
                                </td>
                                <td class="small" style="max-width:320px; white-space:normal;">@h.Message</td>
                                <td>@Html.Raw(StatusBadge(h.Status))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (historyTotalPages > 1)
            {
                <nav class="d-flex justify-content-center mt-3">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(historyPage <= 1 ? "disabled" : "")">
                            <a class="page-link history-page-link" href="/Admin/Notifications?page=@(historyPage - 1)&pageSize=@historyPageSize">
                                <iconify-icon icon="iconamoon:arrow-left-2-duotone"></iconify-icon>
                            </a>
                        </li>
                        @{
                            var startPage = Math.Max(1, historyPage - 2);
                            var endPage = Math.Min(historyTotalPages, startPage + 4);
                            startPage = Math.Max(1, endPage - 4);
                        }
                        @if (startPage > 1)
                        {
                            <li class="page-item"><a class="page-link history-page-link" href="/Admin/Notifications?page=1&pageSize=@historyPageSize">1</a></li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                        }
                        @for (var p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item @(p == historyPage ? "active" : "")">
                                <a class="page-link history-page-link" href="/Admin/Notifications?page=@p&pageSize=@historyPageSize">@p</a>
                            </li>
                        }
                        @if (endPage < historyTotalPages)
                        {
                            @if (endPage < historyTotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            <li class="page-item"><a class="page-link history-page-link" href="/Admin/Notifications?page=@historyTotalPages&pageSize=@historyPageSize">@historyTotalPages</a></li>
                        }
                        <li class="page-item @(historyPage >= historyTotalPages ? "disabled" : "")">
                            <a class="page-link history-page-link" href="/Admin/Notifications?page=@(historyPage + 1)&pageSize=@historyPageSize">
                                <iconify-icon icon="iconamoon:arrow-right-2-duotone"></iconify-icon>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var hiddenContainer = document.getElementById('hiddenOwnerIds');
            var selectedCountEl = document.getElementById('selectedCount');
            var btnSubmit = document.getElementById('btnSubmitSend');
            var search = document.getElementById('ownerSearch');
            var messageInput = document.getElementById('messageInput');
            var messageCharCount = document.getElementById('messageCharCount');
            var manualTemplatePreview = document.getElementById('manualTemplatePreview');

            function getChecked() {
                return Array.prototype.slice.call(document.querySelectorAll('.owner-check:checked'));
            }

            function syncCardState(cb) {
                var card = cb.closest('.owner-pick-card');
                if (card) card.classList.toggle('selected', cb.checked);
            }

            function renderManualPreview() {
                var checked = getChecked();
                var firstName = checked.length ? checked[0].getAttribute('data-name') : '[Ad Soyad]';
                var text = messageInput.value.trim() || '[mesajınız]';
                manualTemplatePreview.textContent = 'Sayın ' + firstName + ', ' + text;
            }

            function refresh() {
                var checked = getChecked();
                selectedCountEl.textContent = checked.length;
                btnSubmit.disabled = checked.length === 0;
                renderManualPreview();
            }

            document.addEventListener('change', function (e) {
                if (e.target && e.target.classList && e.target.classList.contains('owner-check')) {
                    syncCardState(e.target);
                    refresh();
                }
            });

            document.getElementById('ownerGrid').addEventListener('click', function (e) {
                var card = e.target.closest && e.target.closest('.owner-pick-card');
                if (!card || card.classList.contains('disabled')) return;
                var cb = card.querySelector('.owner-check');
                if (!cb || cb.disabled) return;
                cb.checked = !cb.checked;
                syncCardState(cb);
                refresh();
            });

            document.getElementById('ownerGrid').addEventListener('keydown', function (e) {
                if (e.key !== 'Enter' && e.key !== ' ') return;
                var card = e.target.closest && e.target.closest('.owner-pick-card');
                if (!card || card.classList.contains('disabled')) return;
                e.preventDefault();
                var cb = card.querySelector('.owner-check');
                if (!cb || cb.disabled) return;
                cb.checked = !cb.checked;
                syncCardState(cb);
                refresh();
            });

            messageInput.addEventListener('input', function () {
                messageCharCount.textContent = messageInput.value.length;
                renderManualPreview();
            });

            document.getElementById('btnSelectAll').addEventListener('click', function () {
                document.querySelectorAll('.owner-pick-card').forEach(function (card) {
                    if (card.style.display === 'none' || card.classList.contains('disabled')) return;
                    var cb = card.querySelector('.owner-check');
                    if (cb && !cb.disabled) { cb.checked = true; syncCardState(cb); }
                });
                refresh();
            });

            document.getElementById('btnClearAll').addEventListener('click', function () {
                document.querySelectorAll('.owner-check').forEach(function (cb) { cb.checked = false; syncCardState(cb); });
                refresh();
            });

            search.addEventListener('input', function () {
                var q = search.value.trim().toLowerCase();
                document.querySelectorAll('.owner-pick-card').forEach(function (row) {
                    row.style.display = row.getAttribute('data-name').indexOf(q) === -1 ? 'none' : '';
                });
            });

            refresh();

            var form = document.getElementById('sendForm');
            form.addEventListener('submit', function () {
                var checked = getChecked();
                hiddenContainer.innerHTML = '';
                checked.forEach(function (cb) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'ownerIds';
                    input.value = cb.value;
                    hiddenContainer.appendChild(input);
                });
            });

            // Gönderim geçmişi sayfalama: tıklanınca tüm sayfayı yeniden yüklemek yerine
            // sadece geçmiş bölümünü sunucudan getirip yerinde değiştirir — böylece kullanıcının
            // sayfadaki scroll konumu (ör. tablonun ortasında) korunur, en tepeye atlamaz.
            var historyContainer = document.getElementById('historyContainer');

            function loadHistoryPage(url, pushState) {
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (res) { return res.text(); })
                    .then(function (html) {
                        var doc = new DOMParser().parseFromString(html, 'text/html');
                        var fresh = doc.getElementById('historyContainer');
                        if (fresh) {
                            historyContainer.innerHTML = fresh.innerHTML;
                            if (pushState) window.history.pushState({ historyUrl: url }, '', url);
                        }
                    })
                    .catch(function () {
                        // Ağ hatası vb. durumda normal tam sayfa geçişine düş.
                        window.location.href = url;
                    });
            }

            document.addEventListener('click', function (e) {
                var link = e.target.closest && e.target.closest('.history-page-link');
                if (!link) return;
                if (link.closest('.disabled')) { e.preventDefault(); return; }
                e.preventDefault();
                loadHistoryPage(link.getAttribute('href'), true);
            });

            window.addEventListener('popstate', function (e) {
                if (e.state && e.state.historyUrl) {
                    loadHistoryPage(e.state.historyUrl, false);
                }
            });

            // Otomatik Hatırlatıcı: gün/hafta seçici artık chip'lerle çalışıyor (elle "7,1" yazmak yerine).
            // Seçili günler (hazır seçenekler + eklenen özel günler) form gönderilmeden hemen önce
            // gizli "checkpoints" alanına virgülle ayrılmış olarak yazılır.
            var checkpointsInput = document.getElementById('checkpointsInput');
            var customDayChips = document.getElementById('customDayChips');
            var customDayInput = document.getElementById('customDayInput');
            var messageTemplateInput = document.getElementById('messageTemplateInput');
            var templatePreview = document.getElementById('templatePreview');

            function getSelectedDays() {
                var days = [];
                document.querySelectorAll('.day-chip.btn-primary').forEach(function (btn) {
                    days.push(parseInt(btn.getAttribute('data-days'), 10));
                });
                document.querySelectorAll('.day-chip-custom').forEach(function (chip) {
                    days.push(parseInt(chip.getAttribute('data-days'), 10));
                });
                return Array.from(new Set(days)).sort(function (a, b) { return b - a; });
            }

            function syncCheckpointsInput() {
                checkpointsInput.value = getSelectedDays().join(',');
            }

            document.querySelectorAll('.day-chip').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    btn.classList.toggle('btn-primary');
                    btn.classList.toggle('btn-outline-secondary');
                    syncCheckpointsInput();
                });
            });

            function addCustomDayChip(days) {
                if (!days || days < 1) return;
                var existing = getSelectedDays();
                if (existing.indexOf(days) !== -1) return;

                var chip = document.createElement('span');
                chip.className = 'btn btn-sm btn-primary day-chip-custom';
                chip.setAttribute('data-days', days);
                chip.innerHTML = days + ' gün <iconify-icon icon="mdi:close" class="ms-1 remove-custom-day"></iconify-icon>';
                customDayChips.appendChild(chip);
                syncCheckpointsInput();
            }

            document.getElementById('btnAddCustomDay').addEventListener('click', function () {
                var val = parseInt(customDayInput.value, 10);
                addCustomDayChip(val);
                customDayInput.value = '';
            });

            customDayInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    document.getElementById('btnAddCustomDay').click();
                }
            });

            customDayChips.addEventListener('click', function (e) {
                var remove = e.target.closest && e.target.closest('.remove-custom-day');
                if (!remove) return;
                remove.closest('.day-chip-custom').remove();
                syncCheckpointsInput();
            });

            function renderTemplatePreview() {
                var sample = messageTemplateInput.value
                    .replace(/\{ad\}/g, 'Ahmet Yılmaz')
                    .replace(/\{aciklama\}/g, 'Taksit 3/12')
                    .replace(/\{ne_zaman\}/g, '1 hafta içinde')
                    .replace(/\{vade\}/g, '20.09.2026')
                    .replace(/\{tutar\}/g, '₺250.000');
                templatePreview.textContent = sample || ' ';
            }

            messageTemplateInput.addEventListener('input', renderTemplatePreview);
            renderTemplatePreview();

            document.getElementById('reminderForm').addEventListener('submit', function () {
                syncCheckpointsInput();
            });

            syncCheckpointsInput();
        })();
    </script>
}
