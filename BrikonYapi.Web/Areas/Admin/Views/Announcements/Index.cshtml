@model List<BrikonYapi.Web.Data.Entities.Announcement>
@{
    ViewData["Title"] = "Duyurular";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="card-title mb-0">Kat Maliki Duyuruları (@Model.Count)</h5>
        <a href="/Admin/Announcements/Create" class="btn btn-primary btn-sm">
            <iconify-icon icon="iconamoon:sign-plus-circle-duotone" class="me-1"></iconify-icon>
            Yeni Duyuru
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5">
                <iconify-icon icon="iconamoon:news-duotone" style="font-size:48px;"></iconify-icon>
                <span class="mt-2">Henüz duyuru eklenmemiş.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Başlık</th>
                            <th>Etiket</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@a.Title</strong>
                                    <div class="text-muted small">@(a.Body.Length > 80 ? a.Body.Substring(0, 80) + "…" : a.Body)</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(a.Tag))
                                    {
                                        <span class="badge bg-info-subtle text-info">@a.Tag</span>
                                    }
                                </td>
                                <td class="text-muted small">@a.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (a.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Yayında</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Gizli</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a href="/Admin/Announcements/Edit/@a.Id" class="btn btn-sm btn-outline-secondary">
                                            <iconify-icon icon="iconamoon:edit-duotone"></iconify-icon>
                                            Düzenle
                                        </a>
                                        <form asp-area="Admin" asp-controller="Announcements" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu duyuru silinsin mi?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@a.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <iconify-icon icon="iconamoon:trash-duotone"></iconify-icon>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
