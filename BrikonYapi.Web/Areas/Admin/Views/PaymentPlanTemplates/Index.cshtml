@model List<BrikonYapi.Web.Data.Entities.PaymentPlanTemplate>
@using BrikonYapi.Web.Data.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Ödeme Planı Şablonları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var selectedProjectId = (int?)ViewBag.SelectedProjectId;
    var unit = (Unit?)ViewBag.Unit;
}

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-0">Ödeme Planı Şablonları</h4>
        <div class="text-muted small">
            @if (unit != null)
            {
                <span>@unit.Project?.Name / @unit.UnitNo bölümüne uygulanacak şablonu seçin.</span>
            }
            else
            {
                <span>Bir projeye özel, gruba toplu atanabilir hakediş/takvim bazlı ödeme planları.</span>
            }
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <form method="get" class="d-flex align-items-center gap-2">
            @if (unit != null)
            {
                <input type="hidden" name="unitId" value="@unit.Id" />
            }
            <select name="projectId" class="form-select form-select-sm" style="min-width:220px;" @(unit != null ? "disabled" : "") onchange="this.form.submit()">
                <option value="">Tüm Projeler</option>
                @foreach (var p in (SelectList)ViewBag.Projects)
                {
                    <option value="@p.Value" selected="@(p.Selected)">@p.Text</option>
                }
            </select>
        </form>
        @if (selectedProjectId.HasValue && unit == null)
        {
            <a href="/Admin/PaymentPlanTemplates/Create?projectId=@selectedProjectId" class="btn btn-sm bk-btn-save">
                <iconify-icon icon="mdi:plus" class="me-1"></iconify-icon>Yeni Şablon
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (unit == null)
{
    <div class="alert alert-light border small text-muted d-flex gap-2 align-items-start">
        <iconify-icon icon="iconamoon:information-circle-duotone" class="fs-18 text-primary flex-shrink-0"></iconify-icon>
        <div>
            Şablonlar, bir projedeki birden fazla bağımsız bölüme tek seferde uygulanabilecek, yeniden kullanılabilir
            ödeme planlarıdır (örn. "%10 peşinat + 24 ay eşit taksit" ya da hakedişe bağlı aşama ödemeleri).
            Bir şablon oluşturduktan sonra kart üzerindeki <strong>"Uygula"</strong> butonuna basıp hangi bölümlere
            atanacağını seçersiniz — o an seçilen bölümlerin taksitleri (Ödeme Kalemi) otomatik oluşturulur.
            Bir bölüme zaten elle taksit girdiyseniz, aynı bölüme şablon uygulamak taksitleri tekrar oluşturup
            mükerrer kayda yol açar; önce <a href="/Admin/Units">Bağımsız Bölümler</a> üzerinden o bölümün
            mevcut ödeme planını kontrol edin.
        </div>
    </div>
}
else
{
    <div class="alert alert-primary small d-flex gap-2 align-items-start">
        <iconify-icon icon="mdi:home-city-outline" class="fs-18 flex-shrink-0"></iconify-icon>
        <div>
            Seçeceğiniz şablon <strong>malike değil, doğrudan bu bağımsız bölüme</strong> uygulanacak:
            <strong>@unit.Project?.Name — @unit.UnitNo</strong>@(unit.Owner != null ? $" (malik: {unit.Owner.FullName})" : " (sahipsiz bölüm)").
            Şablonu seçtiğinizde bu bölüm için taksitler (Ödeme Kalemi) otomatik oluşturulur.
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="card border-0 bk-form-card">
        <div class="card-body text-center text-muted py-5">
            @if (selectedProjectId.HasValue)
            {
                <span>Bu projede henüz ödeme planı şablonu tanımlanmamış.</span>
                <div class="mt-2">
                    <a href="/Admin/PaymentPlanTemplates/Create?projectId=@selectedProjectId" class="btn btn-sm bk-btn-save">
                        <iconify-icon icon="mdi:plus" class="me-1"></iconify-icon>İlk Şablonu Oluştur
                    </a>
                </div>
            }
            else
            {
                <span>Henüz hiçbir projede ödeme planı şablonu tanımlanmamış. Şablon oluşturmak için yukarıdan bir proje seçin.</span>
            }
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var t in Model)
        {
            var totalPct = t.Items.Sum(i => i.Percentage);
            // Hakediş/aşama bazlı şablonlar kalemleri şablonun kendi projesindeki iş adımlarına bağlı
            // olduğu için sadece o projedeki bölümlere uygulanabilir; takvim/aylık bazlı şablonlar
            // projeden bağımsız olduğu için her bölüme uygulanabilir.
            var applicable = unit == null || t.PlanType == PaymentPlanType.CalendarBased || t.ProjectId == unit.ProjectId;
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 bk-form-card h-100 @(applicable ? "" : "opacity-75")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="fw-semibold">@t.Name</div>
                                <div class="text-muted small">@t.Project?.Name</div>
                            </div>
                            <span class="badge @(t.PlanType == PaymentPlanType.StageBased ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success")">
                                @(t.PlanType == PaymentPlanType.StageBased ? "Hakediş / Aşama" : "Takvim / Aylık")
                            </span>
                        </div>
                        <div class="small text-muted mb-2">
                            @t.Items.Count kalem · Toplam %@totalPct.ToString("0.##")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(t.Description))
                        {
                            <div class="small text-muted mb-2">@t.Description</div>
                        }
                        <ul class="list-unstyled small mb-3">
                            @foreach (var item in t.Items.OrderBy(i => i.OrderIndex).Take(4))
                            {
                                <li class="d-flex justify-content-between border-bottom py-1">
                                    <span class="text-truncate me-2">@item.Label</span>
                                    <span class="text-muted">%@item.Percentage.ToString("0.##")</span>
                                </li>
                            }
                            @if (t.Items.Count > 4)
                            {
                                <li class="text-muted">+ @(t.Items.Count - 4) kalem daha…</li>
                            }
                        </ul>
                        @if (unit != null && !applicable)
                        {
                            <div class="alert alert-light border small text-muted py-2 px-2 mb-2 d-flex gap-1 align-items-start">
                                <iconify-icon icon="mdi:lock-outline" class="fs-16 flex-shrink-0"></iconify-icon>
                                <span>Hakediş/aşama bazlı olduğu için yalnızca <strong>@t.Project?.Name</strong> projesindeki bölümlere uygulanabilir.</span>
                            </div>
                        }
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (unit != null && !applicable)
                            {
                                <button type="button" class="btn btn-outline-secondary flex-grow-1" disabled title="Bu şablon başka bir projeye özel, bu bölüme uygulanamaz">
                                    <iconify-icon icon="mdi:lock-outline" class="me-1"></iconify-icon>Uygulanamaz
                                </button>
                            }
                            else
                            {
                                <a href="/Admin/PaymentPlanTemplates/Assign?templateId=@t.Id@(unit != null ? "&unitId=" + unit.Id : "")" class="btn bk-btn-save flex-grow-1">
                                    <iconify-icon icon="mdi:check-circle-outline" class="me-1"></iconify-icon>Uygula
                                </a>
                            }
                            <a href="/Admin/PaymentPlanTemplates/Edit/@t.Id" class="btn btn-outline-secondary bk-btn-icon" title="Düzenle">
                                <iconify-icon icon="mdi:pencil-outline"></iconify-icon>
                            </a>
                            <form asp-area="Admin" asp-controller="PaymentPlanTemplates" asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline-flex"
                                  onsubmit="return confirm('Bu şablon silinsin mi? (Daha önce uygulanmış taksitler etkilenmez)');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger bk-btn-icon" title="Sil">
                                    <iconify-icon icon="mdi:trash-can-outline"></iconify-icon>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
