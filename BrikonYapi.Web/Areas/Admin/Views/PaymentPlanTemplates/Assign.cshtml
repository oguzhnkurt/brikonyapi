@using BrikonYapi.Web.Data.Entities
@{
    var template = (PaymentPlanTemplate)ViewBag.Template;
    var lockedUnit = (Unit?)ViewBag.LockedUnit;
    var units = (List<Unit>)ViewBag.Units;
    var isStage = template.PlanType == PaymentPlanType.StageBased;
    ViewData["Title"] = "Ödeme Planı Şablonunu Uygula";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card bk-form-card border-0">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:check-decagram-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Ödeme Planı Şablonunu Uygula</h5>
                    <div class="bk-form-hero-subtitle">@template.Project?.Name — @template.Name</div>
                </div>
            </div>
            <div class="card-body bk-form-body">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <div class="bk-field-group mb-3">
                    <div class="bk-group-title">
                        Şablon Kalemleri
                        <span class="badge @(isStage ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success") ms-2">
                            @(isStage ? "Hakediş / Aşama Bazlı" : "Takvim / Aylık Bazlı")
                        </span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="small">Kalem</th>
                                    <th class="small text-center" style="width:100px;">Yüzde</th>
                                    <th class="small">@(isStage ? "Aşama" : "Ay")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in template.Items.OrderBy(i => i.OrderIndex))
                                {
                                    <tr>
                                        <td class="small">@item.Label</td>
                                        <td class="small text-center">%@item.Percentage.ToString("0.##")</td>
                                        <td class="small text-muted">
                                            @(isStage ? (item.ProjectStage?.Name ?? "—") : (item.MonthOffset.HasValue ? item.MonthOffset + ". ay" : "—"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <form asp-area="Admin" asp-controller="PaymentPlanTemplates" asp-action="Assign" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="templateId" value="@template.Id" />

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Atama Tarihi</div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <input type="date" name="assignDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                <div class="form-text small bk-hint">
                                    @if (isStage)
                                    {
                                        <text>Aşamaya bağlı olmayan kalemler için bilgi amaçlı vade tarihi olarak kullanılır.</text>
                                    }
                                    else
                                    {
                                        <text>Aylık taksitlerin vadeleri bu tarihten itibaren hesaplanır (ör. "10. ay" = bu tarih + 10 ay).</text>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="bk-group-title mb-0">Uygulanacak Bağımsız Bölümler</div>
                            @if (lockedUnit == null)
                            {
                                <div class="form-check">
                                    <input type="checkbox" id="chkAll" class="form-check-input" />
                                    <label for="chkAll" class="form-check-label small">Tümünü Seç</label>
                                </div>
                            }
                        </div>

                        @if (!units.Any())
                        {
                            <div class="text-muted small">Bu projede bağımsız bölüm bulunamadı.</div>
                        }
                        else
                        {
                            <div class="table-responsive" style="max-height:420px; overflow-y:auto;">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:36px;"></th>
                                            <th class="small">Bölüm</th>
                                            <th class="small">Malik</th>
                                            <th class="small text-end">Toplam Ödeme</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var u in units)
                                        {
                                            var hasContract = u.ContractAmount.HasValue && u.ContractAmount.Value > 0;
                                            <tr class="@(hasContract ? "" : "table-warning")">
                                                <td>
                                                    <input type="checkbox" name="unitIds" value="@u.Id" class="form-check-input unit-check"
                                                           checked="@(lockedUnit != null)" disabled="@(!hasContract)" />
                                                </td>
                                                <td class="small">@u.Project?.Name — @u.UnitNo @(!string.IsNullOrEmpty(u.BlockNo) ? $"({u.BlockNo})" : "")</td>
                                                <td class="small">@(u.Owner?.FullName ?? "Atanmamış")</td>
                                                <td class="small text-end">
                                                    @if (hasContract)
                                                    {
                                                        <text>@u.ContractAmount!.Value.ToString("N0")</text>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">Tanımsız</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="form-text small bk-hint mt-2">
                                Sarı işaretli bölümlerin "Toplam Ödeme" tutarı tanımlı değil — bu bölümler atlanacaktır.
                                Önce <a href="/Admin/Units">Bağımsız Bölümler</a> ekranından toplam ödeme tutarını girin.
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Ödeme Planını Uygula
                        </button>
                        <a href="/Admin/PaymentPlanTemplates?projectId=@template.ProjectId" class="btn bk-btn-cancel">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var chkAll = document.getElementById('chkAll');
    if (!chkAll) return;
    chkAll.addEventListener('change', function () {
        document.querySelectorAll('.unit-check:not(:disabled)').forEach(function (c) { c.checked = chkAll.checked; });
    });
})();
</script>
}
