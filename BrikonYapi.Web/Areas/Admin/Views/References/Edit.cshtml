@model BrikonYapi.Web.Data.Entities.Reference
@{
    ViewData["Title"] = "Referans Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card bk-form-card border-0">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:star-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Referans Düzenle</h5>
                    <div class="bk-form-hero-subtitle">@Model.Name</div>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <form asp-area="Admin" asp-controller="References" asp-action="Edit"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Genel Bilgiler</div>

                        @if (!string.IsNullOrEmpty(Model.LogoPath))
                        {
                            <div class="mb-3">
                                <label class="bk-label">Mevcut Logo</label>
                                <div class="p-3 bg-light rounded d-inline-block">
                                    <img src="@Model.LogoPath" alt="@Model.Name"
                                         style="height:60px;max-width:160px;object-fit:contain;" />
                                </div>
                                <div class="form-text bk-hint">Yeni logo yüklenirse mevcut logo silinir.</div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="bk-label">Referans Adı <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="bk-label">Yeni Logo (boş bırakılırsa değişmez)</label>
                            <input type="file" name="logo" class="form-control" accept="image/png,image/jpeg,image/webp" />
                        </div>

                        <div class="mb-0">
                            <label class="bk-label">Sıra Numarası</label>
                            <input asp-for="OrderIndex" type="number" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Aktif (sitede göster)</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Güncelle
                        </button>
                        <a href="/Admin/References" class="btn bk-btn-cancel">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
