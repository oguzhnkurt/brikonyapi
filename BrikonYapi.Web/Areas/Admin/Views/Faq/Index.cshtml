@model List<BrikonYapi.Web.Data.Entities.FaqItem>
@{
    ViewData["Title"] = "Sıkça Sorulan Sorular";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="card-title mb-0">Sıkça Sorulan Sorular (@Model.Count)</h5>
        <a href="/Admin/Faq/Create" class="btn btn-primary btn-sm">
            <iconify-icon icon="iconamoon:sign-plus-circle-duotone" class="me-1"></iconify-icon>
            Yeni Soru
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5">
                <iconify-icon icon="iconamoon:question-mark-circle-duotone" style="font-size:48px;"></iconify-icon>
                <span class="mt-2">Henüz soru eklenmemiş.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Soru</th>
                            <th>Cevap (önizleme)</th>
                            <th>Sıra</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            <tr>
                                <td><strong>@f.Question</strong></td>
                                <td class="text-muted small">@(f.Answer.Length > 90 ? f.Answer.Substring(0, 90) + "…" : f.Answer)</td>
                                <td class="text-muted small">@f.OrderIndex</td>
                                <td>
                                    @if (f.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Yayında</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Gizli</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a href="/Admin/Faq/Edit/@f.Id" class="btn btn-sm btn-outline-secondary">
                                            <iconify-icon icon="iconamoon:edit-duotone"></iconify-icon>
                                            Düzenle
                                        </a>
                                        <form asp-area="Admin" asp-controller="Faq" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu soru silinsin mi?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@f.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <iconify-icon icon="iconamoon:trash-duotone"></iconify-icon>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
