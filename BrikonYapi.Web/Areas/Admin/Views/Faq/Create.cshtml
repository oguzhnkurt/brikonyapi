@model BrikonYapi.Web.Data.Entities.FaqItem
@{
    ViewData["Title"] = "Yeni Soru";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Yeni Soru</h5>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Faq" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Soru <span class="text-danger">*</span></label>
                        <input asp-for="Question" class="form-control" placeholder="Örn: Mashard çatı nedir?" required />
                        <span asp-validation-for="Question" class="text-danger small"></span>
                        <div class="form-text">Kat maliki portalında kalın (bold) olarak, tıklanabilir bir başlık şeklinde gösterilir.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cevap <span class="text-danger">*</span></label>
                        <textarea asp-for="Answer" class="form-control" rows="8" required placeholder="Soruya makale tarzında, ayrıntılı cevabı yazın..."></textarea>
                        <span asp-validation-for="Answer" class="text-danger small"></span>
                        <div class="form-text">Soruya tıklanınca altında açılır. Paragraf aralarına boş satır bırakabilirsiniz.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sıra</label>
                        <input asp-for="OrderIndex" type="number" class="form-control" value="0" />
                        <div form-text class="form-text">Küçük sayı önce gösterilir.</div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label">Yayında (kat maliklerine gösterilsin)</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Oluştur
                        </button>
                        <a href="/Admin/Faq" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
