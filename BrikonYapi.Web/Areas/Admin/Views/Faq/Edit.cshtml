@model BrikonYapi.Web.Data.Entities.FaqItem
@{
    ViewData["Title"] = "Soru Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card bk-form-card border-0">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:frequently-asked-questions"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Soru Düzenle</h5>
                    <div class="bk-form-hero-subtitle">@Model.Question</div>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <form asp-area="Admin" asp-controller="Faq" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Soru &amp; Cevap</div>

                        <div class="mb-3">
                            <label class="bk-label">Soru <span class="text-danger">*</span></label>
                            <input asp-for="Question" class="form-control" required />
                            <span asp-validation-for="Question" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label class="bk-label">Cevap <span class="text-danger">*</span></label>
                            <textarea asp-for="Answer" class="form-control" rows="8" required></textarea>
                            <span asp-validation-for="Answer" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">İngilizce (opsiyonel)</div>

                        <div class="mb-3">
                            <label class="bk-label">Soru (EN)</label>
                            <input asp-for="QuestionEn" class="form-control" placeholder="Örn: What is a mansard roof?" />
                            <div class="form-text bk-hint">Boş bırakılırsa site İngilizce görünümünde de Türkçe soru gösterilir.</div>
                        </div>

                        <div class="mb-0">
                            <label class="bk-label">Cevap (EN)</label>
                            <textarea asp-for="AnswerEn" class="form-control" rows="8" placeholder="Cevabın İngilizce çevirisi..."></textarea>
                            <div class="form-text bk-hint">Boş bırakılırsa site İngilizce görünümünde de Türkçe cevap gösterilir.</div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Yayın Ayarları</div>
                        <div class="mb-3">
                            <label class="bk-label">Sıra</label>
                            <input asp-for="OrderIndex" type="number" class="form-control" />
                        </div>

                        <div class="mb-0">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">Yayında (kat maliklerine gösterilsin)</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Kaydet
                        </button>
                        <a href="/Admin/Faq" class="btn bk-btn-cancel">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
