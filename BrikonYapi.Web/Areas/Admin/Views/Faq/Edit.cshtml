@model BrikonYapi.Web.Data.Entities.FaqItem
@{
    ViewData["Title"] = "Soru Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Soru Düzenle</h5>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Faq" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Soru <span class="text-danger">*</span></label>
                        <input asp-for="Question" class="form-control" required />
                        <span asp-validation-for="Question" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cevap <span class="text-danger">*</span></label>
                        <textarea asp-for="Answer" class="form-control" rows="8" required></textarea>
                        <span asp-validation-for="Answer" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sıra</label>
                        <input asp-for="OrderIndex" type="number" class="form-control" />
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Yayında (kat maliklerine gösterilsin)</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Kaydet
                        </button>
                        <a href="/Admin/Faq" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
