@model BrikonYapi.Web.Data.Entities.HeroSlide
@{
    ViewData["Title"] = "Yeni Hero Slide";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card bk-form-card border-0">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:image-multiple-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Yeni Hero Slide</h5>
                    <div class="bk-form-hero-subtitle">Ana sayfa üst banner alanında dönüşümlü olarak gösterilir.</div>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <form asp-area="Admin" asp-controller="HeroSlides" asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Genel Bilgiler</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="bk-label">Başlık</label>
                                <input asp-for="Title" class="form-control" placeholder="Proje adı veya slogan" />
                            </div>
                            <div class="col-md-6">
                                <label class="bk-label">Alt Başlık</label>
                                <input asp-for="Subtitle" class="form-control" placeholder="Kısa açıklama" />
                            </div>
                            <div class="col-md-6">
                                <label class="bk-label">İlişkili Proje (opsiyonel)</label>
                                <select asp-for="ProjectId" class="form-select">
                                    <option value="">-- Seçin --</option>
                                    @foreach (var p in ViewBag.Projects as List<BrikonYapi.Web.Data.Entities.Project> ?? new())
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="bk-label">Sıra</label>
                                <input asp-for="OrderIndex" type="number" class="form-control" value="0" />
                            </div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Buton</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="bk-label">Buton Metni</label>
                                <input asp-for="ButtonText" class="form-control" placeholder="Proje Sayfası" />
                            </div>
                            <div class="col-md-6">
                                <label class="bk-label">Buton URL</label>
                                <input asp-for="ButtonUrl" class="form-control" placeholder="/Projeler/proje-slug" />
                            </div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Medya</div>
                        <div class="mb-3">
                            <label class="bk-label">Video Dosyası (MP4 - arka plan videosu)</label>
                            <input type="file" name="videoFile" class="form-control" accept="video/mp4,video/webm" />
                            <div class="form-text bk-hint">Video yoksa varsayılan videolar kullanılır.</div>
                        </div>
                        <div class="mb-0">
                            <label class="bk-label">Arka Plan Görseli (video yoksa kullanılır)</label>
                            <input type="file" name="bgImage" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Slide Kaydet
                        </button>
                        <a href="/Admin/HeroSlides" class="btn bk-btn-cancel">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
