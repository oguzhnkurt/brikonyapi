@model List<BrikonYapi.Web.Data.Entities.Certificate>
@{
    ViewData["Title"] = "Sertifikalar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="card-title mb-0">
            <iconify-icon icon="iconamoon:certificate-badge-duotone" class="me-2 text-warning"></iconify-icon>
            Sertifikalar (@Model.Count)
        </h5>
        <a href="/Admin/Certificates/Create" class="btn btn-primary btn-sm">
            <iconify-icon icon="iconamoon:sign-plus-circle-duotone" class="me-1"></iconify-icon>
            Yeni Sertifika Ekle
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5">
                <iconify-icon icon="iconamoon:certificate-badge-duotone" style="font-size:48px;"></iconify-icon>
                <span class="mt-2">Henüz sertifika eklenmemiş.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:100px">Görsel</th>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th>Sıra</th>
                            <th>Durum</th>
                            <th>Eklenme</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.ImagePath))
                                    {
                                        <img src="@c.ImagePath" alt="@c.Title"
                                             style="height:56px;width:80px;object-fit:cover;border-radius:4px;" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center bg-light rounded"
                                             style="width:80px;height:56px;color:#aaa;font-size:11px">Yok</div>
                                    }
                                </td>
                                <td><strong>@c.Title</strong></td>
                                <td class="text-muted small" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@c.Description</td>
                                <td class="text-muted">@c.OrderIndex</td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                    }
                                </td>
                                <td class="text-muted small">@c.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a href="/Admin/Certificates/Edit/@c.Id" class="btn btn-sm btn-outline-secondary">
                                            <iconify-icon icon="iconamoon:edit-duotone"></iconify-icon>
                                            Düzenle
                                        </a>
                                        <form asp-area="Admin" asp-controller="Certificates" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu sertifikayı silmek istediğinize emin misiniz?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <iconify-icon icon="iconamoon:trash-duotone"></iconify-icon>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
