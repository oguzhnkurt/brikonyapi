@model BrikonYapi.Web.Data.Entities.Certificate
@{
    ViewData["Title"] = "Sertifika Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card bk-form-card border-0" style="max-width:640px;">
    <div class="bk-form-hero">
        <div class="bk-form-hero-icon">
            <iconify-icon icon="mdi:certificate-outline"></iconify-icon>
        </div>
        <div>
            <h5 class="mb-0">Sertifika Düzenle</h5>
            <div class="bk-form-hero-subtitle">@Model.Title</div>
        </div>
    </div>
    <div class="card-body bk-form-body">
        <form asp-area="Admin" asp-controller="Certificates" asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div class="bk-field-group mb-3">
                <div class="bk-group-title">Genel Bilgiler</div>
                <div class="mb-3">
                    <label class="bk-label">Başlık <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="bk-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label class="bk-label">Mevcut Görsel</label>
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImagePath" alt="@Model.Title"
                                 style="height:120px;width:auto;border-radius:6px;object-fit:cover;border:1px solid #e0e0e0;" />
                        </div>
                    }
                    <input type="file" name="image" class="form-control" accept="image/*" />
                    <div class="form-text bk-hint">Yeni görsel seçerseniz eskisi silinir.</div>
                </div>

                <div class="mb-0">
                    <label class="bk-label">Sıra</label>
                    <input asp-for="OrderIndex" type="number" class="form-control" style="max-width:120px;" />
                </div>
            </div>

            <div class="mb-4">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label class="form-check-label">Aktif</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn bk-btn-save">
                    <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                    Güncelle
                </button>
                <a href="/Admin/Certificates" class="btn bk-btn-cancel">İptal</a>
            </div>
        </form>
    </div>
</div>
