@model BrikonYapi.Web.Data.Entities.Certificate
@{
    ViewData["Title"] = "Yeni Sertifika Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card" style="max-width:640px;">
    <div class="card-header">
        <h5 class="card-title mb-0">Yeni Sertifika Ekle</h5>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Certificates" asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Başlık <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="Örn: ISO 9001:2015" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Sertifika hakkında kısa açıklama..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Görsel</label>
                <input type="file" name="image" class="form-control" accept="image/*" />
                <div class="form-text">JPG, PNG, WEBP desteklenir. Max 5MB önerilir.</div>
            </div>

            <div class="mb-4">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                    <label class="form-check-label">Aktif (sitede görünsün)</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                    Kaydet
                </button>
                <a href="/Admin/Certificates" class="btn btn-outline-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
