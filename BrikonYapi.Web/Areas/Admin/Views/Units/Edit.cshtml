@model BrikonYapi.Web.Data.Entities.Unit
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Bağımsız Bölüm Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card bk-form-card border-0">
            <div class="bk-form-hero">
                <div class="bk-form-hero-icon">
                    <iconify-icon icon="mdi:home-city-outline"></iconify-icon>
                </div>
                <div>
                    <h5 class="mb-0">Bağımsız Bölüm Düzenle</h5>
                    <div class="bk-form-hero-subtitle">@Model.UnitNo</div>
                </div>
            </div>
            <div class="card-body bk-form-body">
                <form asp-area="Admin" asp-controller="Units" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Genel Bilgiler</div>

                        <div class="mb-3">
                            <label class="bk-label">Proje <span class="text-danger">*</span></label>
                            <select asp-for="ProjectId" asp-items="(SelectList)ViewBag.Projects" class="form-select" required></select>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="bk-label">Bağımsız Bölüm No <span class="text-danger">*</span></label>
                                <input asp-for="UnitNo" class="form-control" required />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="bk-label">Blok</label>
                                <input asp-for="BlockNo" class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-4 mb-3">
                                <label class="bk-label">Kat</label>
                                <input asp-for="FloorNo" type="number" class="form-control" placeholder="Örn: 3" />
                            </div>
                            <div class="col-4 mb-3">
                                <label class="bk-label">Oda Düzeni</label>
                                <input asp-for="RoomLayout" class="form-control" placeholder="Örn: 3+1" />
                            </div>
                            <div class="col-4 mb-3">
                                <label class="bk-label">m²</label>
                                <input asp-for="AreaM2" type="number" class="form-control" placeholder="Örn: 145" />
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="bk-label">İlerleme Yüzdesi (%)</label>
                            <input asp-for="ProgressPercentage" type="number" min="0" max="100" class="form-control" />
                            @if (Model.ProgressUpdatedAt.HasValue)
                            {
                                <div class="form-text bk-hint">Son güncelleme: @Model.ProgressUpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Finansal Bilgiler</div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="bk-label">m² Birim Fiyatı (₺)</label>
                                <input asp-for="UnitPriceM2" type="number" step="0.01" min="0" id="uUnitPrice" class="form-control" placeholder="Örn: 25000" />
                            </div>
                            <div class="col-md-4">
                                <label class="bk-label">Hibe/Kredi (₺)</label>
                                <input asp-for="SubsidyAmount" type="number" step="0.01" min="0" id="uSubsidy" class="form-control" placeholder="Örn: 150000" />
                            </div>
                            <div class="col-md-4">
                                <label class="bk-label">Toplam Ödeme (₺)</label>
                                <input asp-for="ContractAmount" type="number" step="0.01" min="0" id="uContract" class="form-control" placeholder="Otomatik hesaplanır" />
                                <div class="form-text small bk-hint">m² × Birim Fiyat − Hibe/Kredi olarak önerilir, elle değiştirilebilir.</div>
                            </div>
                        </div>
                    </div>

                    <div class="bk-field-group mb-3">
                        <div class="bk-group-title">Malik &amp; Notlar</div>

                        <div class="mb-3">
                            <label class="bk-label">Kat Maliki</label>
                            <select asp-for="OwnerId" asp-items="(SelectList)ViewBag.Owners" class="form-select">
                                <option value="">Atanmamış</option>
                            </select>
                        </div>

                        <div class="mb-0">
                            <label class="bk-label">Notlar</label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Aktif</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn bk-btn-save">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                            Kaydet
                        </button>
                        <a href="/Admin/PaymentSchedules?unitId=@Model.Id" class="btn btn-outline-primary" title="Bu bölüme taksitleri tek tek elle ekle">
                            <iconify-icon icon="iconamoon:credit-card-duotone" class="me-1"></iconify-icon>
                            Ödeme Planı
                        </a>
                        <a href="/Admin/PaymentPlanTemplates?unitId=@Model.Id" class="btn btn-outline-info" title="Hazır bir ödeme planı şablonunu bu bölüme uygula">
                            <iconify-icon icon="mdi:file-document-multiple-outline" class="me-1"></iconify-icon>
                            Şablon Uygula
                        </a>
                        <a href="/Admin/Units" class="btn bk-btn-cancel">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // Toplam ödeme = m² × Birim Fiyat − Hibe/Kredi. Zaten bir Toplam Ödeme değeri kayıtlıysa
    // (elle girilmiş/override edilmiş olabilir) otomatik hesaplama onu ezmez.
    var areaEl = document.getElementById('AreaM2');
    var priceEl = document.getElementById('uUnitPrice');
    var subsidyEl = document.getElementById('uSubsidy');
    var contractEl = document.getElementById('uContract');
    var contractTouched = !!(contractEl.value && contractEl.value.trim() !== '');

    function recalc() {
        if (contractTouched) return;
        var area = parseFloat(areaEl.value) || 0;
        var price = parseFloat(priceEl.value) || 0;
        var subsidy = parseFloat(subsidyEl.value) || 0;
        if (area > 0 && price > 0) {
            contractEl.value = Math.max(0, (area * price) - subsidy).toFixed(2);
        }
    }

    contractEl.addEventListener('input', function () { contractTouched = true; });
    [areaEl, priceEl, subsidyEl].forEach(function (el) { el.addEventListener('input', recalc); });
})();
</script>
}
