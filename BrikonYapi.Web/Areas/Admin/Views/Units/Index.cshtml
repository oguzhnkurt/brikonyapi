@model List<BrikonYapi.Web.Data.Entities.Unit>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Bağımsız Bölümler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var selectedProjectId = (int?)ViewBag.SelectedProjectId;
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h5 class="card-title mb-0">Bağımsız Bölümler (@Model.Count)</h5>
        <div class="d-flex align-items-center gap-2">
            <form method="get" class="d-flex align-items-center gap-2">
                <select name="projectId" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width:220px">
                    <option value="">Tüm Projeler</option>
                    @foreach (var item in (SelectList)ViewBag.Projects)
                    {
                        <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
                    }
                </select>
            </form>
            @if (selectedProjectId.HasValue)
            {
                var selectedProjectName = ((SelectList)ViewBag.Projects).FirstOrDefault(p => p.Selected)?.Text ?? "";
                <button type="button" class="btn btn-outline-info btn-sm" id="progressPanelBtn"
                        data-project-id="@selectedProjectId" data-project-name="@selectedProjectName"
                        title="Bu projenin inşaat aşamaları, genel ilerleme yüzdesi ve saha fotoğraflarını yönet">
                    <iconify-icon icon="mdi:crane" class="me-1"></iconify-icon>
                    İnşaat İlerlemesi
                </button>
            }
            else
            {
                <a href="/Admin/ProjectProgress" class="btn btn-outline-info btn-sm" title="Proje bazında inşaat aşamaları, genel ilerleme yüzdesi ve saha fotoğraflarını yönet">
                    <iconify-icon icon="mdi:crane" class="me-1"></iconify-icon>
                    İnşaat İlerlemesi
                </a>
            }
            <a href="/Admin/Units/Create" class="btn btn-sm bk-btn-save">
                <iconify-icon icon="iconamoon:sign-plus-circle-duotone" class="me-1"></iconify-icon>
                Yeni Bağımsız Bölüm
            </a>
        </div>
    </div>
    <div class="px-3 pt-3">
        <div class="alert alert-light border small text-muted mb-0 d-flex gap-2 align-items-start">
            <iconify-icon icon="iconamoon:information-circle-duotone" class="fs-18 text-primary flex-shrink-0"></iconify-icon>
            <div>
                Burada her dairenin/dükkanın (bağımsız bölüm) alan, fiyat ve malik bilgilerini tanımlarsınız.
                Bir bölümün ödeme takvimini oluşturmak için iki yol var: <strong>"Ödeme Planı"</strong> ile o bölüme
                özel taksitleri tek tek elle girersiniz, <strong>"Şablon Uygula"</strong> ile ise önceden hazırlanmış
                bir ödeme planı şablonunu (örn. %10 peşinat + 24 ay taksit) o bölüme otomatik uygularsınız.
                İkisini aynı bölüme birden uygulamayın — taksitler mükerrer oluşur.
                Buradaki "İlerleme" sütunu sadece bu bölümün kendi ilerleme yüzdesidir; projenin genel inşaat
                aşamaları (temel, karkas vb.), teslim tarihi ve saha fotoğrafları için üstteki
                <strong>"İnşaat İlerlemesi"</strong> butonunu kullanın.
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5">
                <iconify-icon icon="mdi:domain" style="font-size:48px;"></iconify-icon>
                <span class="mt-2">Henüz bağımsız bölüm eklenmemiş.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Proje</th>
                            <th>Bağımsız Bölüm No</th>
                            <th>Blok</th>
                            <th>İlerleme</th>
                            <th>Malik</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td>@u.Project?.Name</td>
                                <td><strong>@u.UnitNo</strong></td>
                                <td class="text-muted">@u.BlockNo</td>
                                <td style="min-width:140px">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:6px;">
                                            <div class="progress-bar bg-primary" style="width:@(u.ProgressPercentage)%"></div>
                                        </div>
                                        <span class="small text-muted">%@u.ProgressPercentage</span>
                                    </div>
                                </td>
                                <td>
                                    @if (u.Owner != null)
                                    {
                                        <span>@u.Owner.FullName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis" title="Bu bölümün henüz bir maliki yok — Kat Maliki Düzenle ekranındaki 'Bağımsız Bölüm Ata' panelinden veya buradaki Düzenle'den atayabilirsiniz.">
                                            <iconify-icon icon="mdi:account-alert-outline" class="me-1"></iconify-icon>Sahipsiz
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a href="/Admin/PaymentSchedules?unitId=@u.Id" class="btn btn-sm btn-outline-primary" title="Bu bölüme taksitleri tek tek elle ekle">
                                            <iconify-icon icon="iconamoon:credit-card-duotone"></iconify-icon>
                                            Ödeme Planı
                                        </a>
                                        <a href="/Admin/PaymentPlanTemplates?unitId=@u.Id" class="btn btn-sm btn-outline-info" title="Hazır bir ödeme planı şablonunu bu bölüme uygula">
                                            <iconify-icon icon="mdi:file-document-multiple-outline"></iconify-icon>
                                            Şablon Uygula
                                        </a>
                                        <a href="/Admin/Units/Edit/@u.Id" class="btn btn-sm btn-outline-secondary">
                                            <iconify-icon icon="iconamoon:edit-duotone"></iconify-icon>
                                            Düzenle
                                        </a>
                                        <form asp-area="Admin" asp-controller="Units" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu bağımsız bölümü silmek istediğinize emin misiniz? Bağlı ödeme kalemleri de silinecek.')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <iconify-icon icon="iconamoon:trash-duotone"></iconify-icon>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- İnşaat İlerlemesi paneli: /Admin/ProjectProgress/Manage ekranını (sidebar'sız embed modunda)
     bir iframe içinde sağdan kayan panelde gösterir — ayrı bir sayfaya gitmeden proje aşamaları,
     genel ilerleme ve saha fotoğrafları buradan yönetilebilir. row'un dışında; Bootstrap'ın
     ".row > *" kuralı position:relative dayattığı için offcanvas'ın position:fixed'ini eziyordu
     (bkz. PaymentPlanTemplates/Manage'deki aynı not). -->
<div class="offcanvas offcanvas-end pp-embed-panel" tabindex="-1" id="progressPanel" aria-labelledby="progressPanelTitle">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="progressPanelTitle">
            <iconify-icon icon="mdi:crane" class="me-1 text-info"></iconify-icon>
            <span id="progressPanelProjectName">İnşaat İlerlemesi</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
    </div>
    <div class="offcanvas-body p-0">
        <iframe id="progressPanelFrame" src="about:blank" style="width:100%; height:100%; border:0;"></iframe>
    </div>
</div>

@section Styles {
<style>
    /* Reback'in .offcanvas.offcanvas-end{width:var(--bs-offcanvas-width)} kuralı iki sınıflı
       (daha yüksek özgüllük) olduğu için doğrudan width yazmak kaybediyordu — aynı CSS
       değişkenini eziyoruz (bkz. ProjectProgress/Manage.cshtml'deki .pp-stage-panel notu). */
    .pp-embed-panel { --bs-offcanvas-width: min(1100px, 96vw); }
</style>
}

@section Scripts {
<script>
(function () {
    var btn = document.getElementById('progressPanelBtn');
    var panelEl = document.getElementById('progressPanel');
    var frame = document.getElementById('progressPanelFrame');
    var titleEl = document.getElementById('progressPanelProjectName');
    if (!btn || !panelEl || !frame) return;

    btn.addEventListener('click', function () {
        var projectId = btn.getAttribute('data-project-id');
        var projectName = btn.getAttribute('data-project-name') || 'İnşaat İlerlemesi';
        titleEl.textContent = projectName;
        // Panel her açılışta tazelensin diye src'yi burada set ediyoruz (lazy-load — sayfa
        // ilk yüklenirken gereksiz yere bir iframe daha çekmesin).
        frame.src = '/Admin/ProjectProgress/Manage/' + projectId + '?embed=true';
        var offcanvas = bootstrap.Offcanvas.getOrCreateInstance(panelEl);
        offcanvas.show();
    });

    // Panel kapanınca iframe'i boşalt — açık kalan yüklü sayfa gereksiz yere arkada durmasın.
    panelEl.addEventListener('hidden.bs.offcanvas', function () {
        frame.src = 'about:blank';
    });
})();
</script>
}
