@using BrikonYapi.Web.Data.Entities
@model Project
@{
    ViewData["Title"] = "İlerleme Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var stages = ViewBag.Stages as List<ProjectStage> ?? new();
    var photos = ViewBag.Photos as List<SitePhoto> ?? new();
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var totalWeight = stages.Sum(s2 => s2.WeightPercentage);
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/Admin/ProjectProgress" class="btn btn-sm btn-outline-secondary">
        <iconify-icon icon="iconamoon:arrow-left-2"></iconify-icon> Geri
    </a>
    <h5 class="mb-0">@Model.Name</h5>
</div>

<div class="row g-3">
    <!-- Genel bilgiler -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title mb-0">Genel Bilgiler</h6></div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="ProjectProgress" asp-action="SaveGeneral" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Genel ilerleme (%)</label>
                        <input type="number" name="overallProgress" class="form-control" min="0" max="100"
                               value="@Model.OverallProgressPercentage" required />
                        <div class="form-text">Kat maliki ekranında büyük yüzde olarak gösterilir.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tahmini teslim tarihi</label>
                        <input type="date" name="estimatedDelivery" class="form-control"
                               value="@(Model.EstimatedDeliveryDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">360° sanal tur bağlantısı</label>
                        <input type="url" name="virtualTourUrl" class="form-control" placeholder="https://..."
                               value="@Model.VirtualTourUrl" />
                        <div class="form-text">
                            CloudPano, Matterport vb. tur adresi. Güvenlik gereği yalnızca <code>https://</code> ile
                            başlayan tam adresler kabul edilir.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon> Kaydet
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Aşamalar / İş Adımları -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="card-title mb-0">İnşaat Aşamaları / İş Adımları (@stages.Count)</h6>
                <div class="d-flex gap-2">
                    @if (!stages.Any())
                    {
                        <form asp-area="Admin" asp-controller="ProjectProgress" asp-action="SeedDefaultStages" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <iconify-icon icon="iconamoon:lightning-1-duotone"></iconify-icon>
                                Standart aşamaları ekle
                            </button>
                        </form>
                    }
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="offcanvas" data-bs-target="#stageAddPanel">
                        <iconify-icon icon="iconamoon:plus-circle-duotone" class="me-1"></iconify-icon>İş Adımı Ekle
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                @if (stages.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0 pp-stage-table">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px;">Sıra</th>
                                    <th>İş Adımı</th>
                                    <th style="width:120px;">Tarih Aralığı</th>
                                    <th style="width:110px;">Bütçe</th>
                                    <th style="width:120px;">İlerleme</th>
                                    <th style="width:170px;">Durum</th>
                                    <th style="width:70px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in stages)
                                {
                                    <tr>
                                        <td class="text-muted small">@s.OrderIndex</td>
                                        <td>
                                            <div class="pp-stage-name">@s.Name</div>
                                            @if (s.WeightPercentage > 0)
                                            {
                                                <div class="pp-stage-sub">Ağırlık %@s.WeightPercentage</div>
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @(s.PlannedStartDate?.ToString("dd.MM.yy") ?? "—") – @(s.PlannedEndDate?.ToString("dd.MM.yy") ?? "—")
                                        </td>
                                        <td class="text-muted small">@(s.EstimatedBudget.HasValue ? s.EstimatedBudget.Value.ToString("N0", tr) + " ₺" : "—")</td>
                                        <td>
                                            <div class="progress" style="height:6px;">
                                                <div class="progress-bar" style="width:@(s.ProgressPercentage)%;"></div>
                                            </div>
                                            <div class="text-muted small mt-1">%@s.ProgressPercentage</div>
                                        </td>
                                        <td>
                                            <form asp-area="Admin" asp-controller="ProjectProgress" asp-action="UpdateStageStatus" method="post" class="d-flex gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="stageId" value="@s.Id" />
                                                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                                    <option value="0" selected="@(s.Status == ProjectStageStatus.Pending)">Bekliyor</option>
                                                    <option value="1" selected="@(s.Status == ProjectStageStatus.InProgress)">Devam ediyor</option>
                                                    <option value="2" selected="@(s.Status == ProjectStageStatus.Completed)">Tamamlandı</option>
                                                </select>
                                            </form>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-link p-0 me-1" data-bs-toggle="offcanvas" data-bs-target="#stageEdit-@s.Id" title="Düzenle">
                                                <iconify-icon icon="iconamoon:edit-duotone"></iconify-icon>
                                            </button>
                                            <form asp-area="Admin" asp-controller="ProjectProgress" asp-action="DeleteStage" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bu iş adımı silinsin mi?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="stageId" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0">
                                                    <iconify-icon icon="iconamoon:trash-duotone"></iconify-icon>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4 small">Henüz iş adımı tanımlanmamış.</div>
                }
            </div>
        </div>
    </div>

</div>

<!-- Yeni İş Adımı — sağdan kayan panel (row'un dışında; Bootstrap'ın ".row > *" kuralı
     position:relative dayattığı için offcanvas'ın position:fixed'ini eziyordu) -->
    <div class="offcanvas offcanvas-end pp-stage-panel" tabindex="-1" id="stageAddPanel">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title">
                <iconify-icon icon="iconamoon:calendar-checkmark-duotone" class="me-1 text-primary"></iconify-icon>
                Yeni İş Adımı
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
        </div>
        <div class="offcanvas-body">
            <div class="text-muted small mb-3">
                Projenin iş programındaki bir kalemi tanımlayın. Ağırlık, bu adımın genel ilerlemedeki payıdır.
            </div>
            <form asp-area="Admin" asp-controller="ProjectProgress" asp-action="AddStage" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label fw-semibold small">İş Adımı <span class="text-danger">*</span></label>
                    <input name="name" class="form-control" placeholder="Ör: Kaba İnşaat, Sıva, Boya" required />
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Ağırlık (%) <span class="text-danger">*</span></label>
                        <input name="weightPercentage" type="number" min="0" max="100" class="form-control pp-weight-input"
                               value="0" data-remain-target="#addWeightRemain" data-total-other="@totalWeight" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Sıra <span class="text-danger">*</span></label>
                        <input name="orderIndex" type="number" class="form-control" value="@(stages.Count + 1)" required />
                    </div>
                </div>
                <div class="form-text mb-3" id="addWeightRemain">Kalan: %@(Math.Max(0, 100 - totalWeight))</div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Başlangıç</label>
                        <input name="plannedStartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Bitiş</label>
                        <input name="plannedEndDate" type="date" class="form-control" />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold small">Tahmini Bütçe (₺)</label>
                    <input name="estimatedBudget" type="number" step="0.01" min="0" class="form-control" placeholder="0,00" />
                    <div class="form-text">Yalnızca alt kalemi olmayan kalemler bütçe taşır (opsiyonel).</div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold small">İlerleme (%)</label>
                    <input name="progressPercentage" type="range" min="0" max="100" value="0" class="form-range"
                           oninput="this.nextElementSibling.textContent = this.value + '%'" />
                    <div class="text-muted small">%0</div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">İptal</button>
                    <button type="submit" class="btn btn-primary">
                        <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- İş adımı düzenleme panelleri (sağdan kayan) -->
    @foreach (var s in stages)
    {
        var remainForThis = Math.Max(0, 100 - (totalWeight - s.WeightPercentage));
        <div class="offcanvas offcanvas-end pp-stage-panel" tabindex="-1" id="stageEdit-@s.Id">
            <div class="offcanvas-header border-bottom">
                <h5 class="offcanvas-title">
                    <iconify-icon icon="iconamoon:edit-duotone" class="me-1 text-primary"></iconify-icon>
                    İş Adımını Düzenle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
            </div>
            <div class="offcanvas-body">
                <form asp-area="Admin" asp-controller="ProjectProgress" asp-action="UpdateStageDetails" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="stageId" value="@s.Id" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">İş Adımı <span class="text-danger">*</span></label>
                        <input name="name" class="form-control" value="@s.Name" required />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Ağırlık (%)</label>
                            <input name="weightPercentage" type="number" min="0" max="100" class="form-control pp-weight-input"
                                   value="@s.WeightPercentage" data-remain-target="#editWeightRemain-@s.Id" data-total-other="@(totalWeight - s.WeightPercentage)" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Sıra</label>
                            <input name="orderIndex" type="number" class="form-control" value="@s.OrderIndex" />
                        </div>
                    </div>
                    <div class="form-text mb-3" id="editWeightRemain-@s.Id">Kalan: %@remainForThis</div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Başlangıç</label>
                            <input name="plannedStartDate" type="date" class="form-control"
                                   value="@(s.PlannedStartDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Bitiş</label>
                            <input name="plannedEndDate" type="date" class="form-control"
                                   value="@(s.PlannedEndDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Tahmini Bütçe (₺)</label>
                        <!-- GÜVENLİK/DOĞRULUK: number input'un value'su HTML spec gereği her zaman
                             nokta-ondalıklı (invariant) olmalı — site kültürü tr-TR (virgül ondalık)
                             olduğu için @s.EstimatedBudget'i doğrudan yazmak "250000,00" üretip
                             tarayıcının alanı geçersiz/boş göstermesine yol açardı. -->
                        <input name="estimatedBudget" type="number" step="0.01" min="0" class="form-control"
                               value="@(s.EstimatedBudget?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold small">İlerleme (%) — <span class="text-muted fw-normal">%100 olunca durum otomatik "Tamamlandı" olur</span></label>
                        <input name="progressPercentage" type="range" min="0" max="100" class="form-range" value="@s.ProgressPercentage"
                               oninput="this.nextElementSibling.textContent = this.value + '%'" />
                        <div class="text-muted small">@s.ProgressPercentage%</div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">İptal</button>
                        <button type="submit" class="btn btn-primary">
                            <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="row g-3">
    <!-- Saha fotoğrafları -->
    <div class="col-12">
        <div class="card">
            <div class="card-header"><h6 class="card-title mb-0">Saha Fotoğrafları (@photos.Count)</h6></div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="ProjectProgress" asp-action="AddPhoto" method="post"
                      enctype="multipart/form-data" class="row g-2 align-items-end mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Fotoğraf (JPG/PNG/WEBP, max 10 MB)</label>
                        <input type="file" name="photo" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Açıklama</label>
                        <input name="caption" class="form-control form-control-sm" placeholder="Örn: Dış cephe kaplama" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Çekim tarihi</label>
                        <input type="date" name="takenAt" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-1">
                        <div class="form-check">
                            <input type="checkbox" name="is360" value="true" class="form-check-input" id="is360" />
                            <label class="form-check-label small" for="is360">360°</label>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-sm btn-primary w-100">Yükle</button>
                    </div>
                </form>

                @if (photos.Any())
                {
                    <div class="row g-3">
                        @foreach (var ph in photos)
                        {
                            <div class="col-6 col-md-3 col-lg-2">
                                <div class="border rounded overflow-hidden h-100">
                                    <div style="height:110px; background:#eef0f2 url('@ph.ImagePath') center/cover no-repeat;"></div>
                                    <div class="p-2">
                                        <div class="small fw-semibold text-truncate">@(ph.Caption ?? "—")</div>
                                        <div class="text-muted" style="font-size:.72rem;">
                                            @ph.TakenAt.ToString("dd MMM yyyy", tr)
                                            @if (ph.Is360)
                                            {
                                                <span class="badge bg-dark-subtle text-dark ms-1">360°</span>
                                            }
                                        </div>
                                        <form asp-area="Admin" asp-controller="ProjectProgress" asp-action="DeletePhoto" method="post"
                                              onsubmit="return confirm('Bu fotoğraf silinsin mi?')" class="mt-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="photoId" value="@ph.Id" />
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0" style="font-size:.75rem;">Sil</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3 small">Henüz saha fotoğrafı yüklenmemiş.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .pp-stage-name { font-weight:700; text-transform:uppercase; letter-spacing:.02em; font-size:.92rem; }
    .pp-stage-sub { font-size:.76rem; color:#8a939c; font-weight:500; margin-top:.1rem; }
    .pp-stage-table thead th { font-size:.72rem; text-transform:uppercase; letter-spacing:.03em; color:#8a939c; font-weight:700; }
    .pp-stage-panel { width:420px; max-width:92vw; }
    .pp-stage-panel .offcanvas-title { font-weight:700; }
</style>
}

@section Scripts {
<script>
    (function () {
        // SantiyePro referansındaki "Kalan: %X" yardımcı metnini canlı günceller.
        // data-total-other: bu alan hariç diğer tüm aşamaların toplam ağırlığı.
        document.querySelectorAll('.pp-weight-input').forEach(function (input) {
            var targetSel = input.getAttribute('data-remain-target');
            var target = targetSel ? document.querySelector(targetSel) : null;
            if (!target) return;
            var totalOther = parseInt(input.getAttribute('data-total-other'), 10) || 0;
            input.addEventListener('input', function () {
                var val = parseInt(input.value, 10) || 0;
                var remain = Math.max(0, 100 - (totalOther + val));
                target.textContent = 'Kalan: %' + remain;
            });
        });
    })();
</script>
}
