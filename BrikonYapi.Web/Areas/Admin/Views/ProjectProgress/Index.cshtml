@model List<BrikonYapi.Web.Data.Entities.Project>
@{
    ViewData["Title"] = "İnşaat İlerlemesi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var unitCounts  = ViewBag.UnitCounts  as Dictionary<int, int> ?? new();
    var stageCounts = ViewBag.StageCounts as Dictionary<int, int> ?? new();
    var photoCounts = ViewBag.PhotoCounts as Dictionary<int, int> ?? new();
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">İnşaat İlerlemesi</h5>
        <div class="text-muted small mt-1">
            Kat maliklerinin "İlerleme" ekranında gördüğü aşamalar, saha fotoğrafları ve 360° sanal tur burada yönetilir.
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Proje</th>
                        <th>Bağımsız Bölüm</th>
                        <th>Genel İlerleme</th>
                        <th>Aşama</th>
                        <th>Saha Fotoğrafı</th>
                        <th>360° Tur</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var units  = unitCounts.TryGetValue(p.Id, out var u) ? u : 0;
                        var stages = stageCounts.TryGetValue(p.Id, out var s) ? s : 0;
                        var photos = photoCounts.TryGetValue(p.Id, out var ph) ? ph : 0;
                        <tr>
                            <td>
                                <strong>@p.Name</strong>
                                <div class="text-muted small">@string.Join(" • ", new[] { p.District, p.City }.Where(x => !string.IsNullOrEmpty(x)))</div>
                            </td>
                            <td>
                                @if (units > 0)
                                {
                                    <span class="badge bg-primary-subtle text-primary">@units bölüm</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td style="min-width:140px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:6px;">
                                        <div class="progress-bar" style="width:@(p.OverallProgressPercentage)%"></div>
                                    </div>
                                    <span class="small fw-semibold">%@p.OverallProgressPercentage</span>
                                </div>
                            </td>
                            <td class="small">@stages</td>
                            <td class="small">@photos</td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.VirtualTourUrl))
                                {
                                    <span class="badge bg-success-subtle text-success">Var</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary progressPanelBtn"
                                        data-project-id="@p.Id" data-project-name="@p.Name">
                                    <iconify-icon icon="iconamoon:settings-duotone"></iconify-icon>
                                    Yönet
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- İlerleme Yönetimi paneli: Units/Index.cshtml'deki #progressPanel ile aynı desen — ayrı sayfaya
     gitmeden /Admin/ProjectProgress/Manage'i (embed modunda) sağdan açılan panelde gösterir. Bu sayfa
     zaten Manage action'ının kendi listesi olduğu için burada da aynı tutarlılık sağlanıyor. -->
<div class="offcanvas offcanvas-end pp-embed-panel" tabindex="-1" id="progressPanel" aria-labelledby="progressPanelTitle">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="progressPanelTitle">
            <iconify-icon icon="mdi:crane" class="me-1 text-info"></iconify-icon>
            <span id="progressPanelProjectName">İnşaat İlerlemesi</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
    </div>
    <div class="offcanvas-body p-0">
        <iframe id="progressPanelFrame" src="about:blank" style="width:100%; height:100%; border:0;"></iframe>
    </div>
</div>

@section Styles {
<style>
    .pp-embed-panel { --bs-offcanvas-width: min(1100px, 96vw); }
</style>
}

@section Scripts {
<script>
(function () {
    var panelEl = document.getElementById('progressPanel');
    var frame = document.getElementById('progressPanelFrame');
    var titleEl = document.getElementById('progressPanelProjectName');
    if (!panelEl || !frame) return;

    document.querySelectorAll('.progressPanelBtn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var projectId = btn.getAttribute('data-project-id');
            var projectName = btn.getAttribute('data-project-name') || 'İnşaat İlerlemesi';
            titleEl.textContent = projectName;
            frame.src = '/Admin/ProjectProgress/Manage/' + projectId + '?embed=true';
            var offcanvas = bootstrap.Offcanvas.getOrCreateInstance(panelEl);
            offcanvas.show();
        });
    });

    panelEl.addEventListener('hidden.bs.offcanvas', function () {
        frame.src = 'about:blank';
    });
})();
</script>
}
