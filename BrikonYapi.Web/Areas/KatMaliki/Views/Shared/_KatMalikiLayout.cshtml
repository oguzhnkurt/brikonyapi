@inject BrikonYapi.Web.Services.SiteSettingService SiteSettings
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] — Brikon Yapı Kat Maliki Paneli</title>

    <!-- Mobil uygulama hissi: ana ekrana eklenebilir (PWA) -->
    <link rel="manifest" href="~/katmaliki-manifest.json" />
    <meta name="theme-color" content="#0082B4" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Kat Maliki" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Font: Admin panelle aynı "DM Sans" (Logisko referans şablonundan) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" rel="stylesheet">
    <style>
        :root {
            --c-primary:#0082B4; --c-secondary:#00A0E3; --c-dark:#2B2A29; --c-navy:#0b1b2e;
            --km-bg:#f1f4f8; --km-border:#e6ebf0;
            --km-shadow: 0 1px 2px rgba(16,24,40,.04), 0 8px 24px rgba(16,24,40,.06);
        }

        /* Mobile-first, buyuk metin ve buyuk dokunma alanlari - yasli/az teknik kullanicilar icin */
        html { -webkit-text-size-adjust: 100%; overscroll-behavior-y: contain; height: 100%; }
        /* Alt gezinme çubuğu önceden position:fixed'di. Mobil tarayıcılarda (özellikle sayfa
           kaydırma gerektirmeyecek kadar kısaysa) adres çubuğu/altbilgi genişleyip daralırken
           "fixed" öğeler layout-viewport'a göre konumlandığından, sayfadan sayfaya (içerik
           kısa/uzun) çubuk ekranda farklı bir yükseklikte görünüyordu. Bunun yerine body'yi
           tam-yükseklik bir flex sütunu yapıp çubuğu normal akışın son öğesi olarak "sticky"
           konumlandırıyoruz — bu, mobil tarayıcı davranışından bağımsız, her sayfada tutarlı
           şekilde ekranın altında kalmasını garanti eder.
        */
        body {
            font-family:'DM Sans','Segoe UI',Arial,sans-serif;
            background:var(--km-bg); color:#1f2933;
            font-size: 17px;
            line-height: 1.55;
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior-y: contain;
            display: flex; flex-direction: column;
            min-height: 100vh; min-height: 100dvh;
        }
        .km-navbar { flex: none; }
        .km-content { flex: 1 0 auto; }
        h1,h2,h3,h4,h5,h6 { line-height:1.3; }
        h4 { font-size: 1.4rem; }

        a, button { -webkit-tap-highlight-color: transparent; }

        /* Kurumsal başlık: lacivertten marka mavisine geçiş + ince mimari ızgara dokusu
           (ana sitenin koyu lacivert footer/header diliyle uyumlu). */
        .km-navbar {
            position: relative; overflow: hidden;
            background:
                radial-gradient(120% 150% at 100% 0%, rgba(0,160,227,.55) 0%, rgba(0,160,227,0) 55%),
                linear-gradient(135deg, var(--c-navy) 0%, #0d3150 55%, #0a6a98 100%);
            padding: .85rem 0 1.6rem; padding-top: calc(.85rem + env(safe-area-inset-top, 0px));
            border-radius: 0 0 28px 28px;
            box-shadow: 0 14px 34px rgba(11,27,46,.22);
            margin-bottom: 1.4rem;
        }
        .km-navbar::before {
            content:''; position:absolute; inset:0; pointer-events:none;
            background-image:
                linear-gradient(rgba(255,255,255,.055) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 30px 30px;
            -webkit-mask-image: linear-gradient(to bottom left, #000 0%, transparent 70%);
                    mask-image: linear-gradient(to bottom left, #000 0%, transparent 70%);
            animation: km-grid-drift 40s linear infinite;
        }
        .km-navbar > .container { position: relative; z-index: 1; }

        /* İnşaat temalı, çok yavaş hareketli çizim: şantiye silueti + kule vinç.
           Vinç arabası bomun üzerinde gidip gelir, kanca iner-kalkar, tepedeki ikaz lambası
           yanıp söner, yapım halindeki bina katları sırayla "çizilir". Düşük opaklıkta
           durur, yazıların okunmasını etkilemez; hareket azaltma tercihi olanlarda durur. */
        .km-hero-art {
            position: absolute; right: -8px; bottom: 0; height: 100%; width: 380px; max-width: 75%;
            pointer-events: none; z-index: 0; opacity: .2;
            -webkit-mask-image: linear-gradient(to left, #000 55%, transparent 100%);
                    mask-image: linear-gradient(to left, #000 55%, transparent 100%);
        }
        .km-hero-art svg { width: 100%; height: 100%; display: block; }
        .km-hero-art .ln { fill: none; stroke: #fff; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
        .km-hero-art .ln-thin { stroke-width: .8; opacity: .7; }
        .km-hero-art .win { fill: #fff; opacity: .35; }
        .km-hero-art .trolley { animation: km-trolley 22s ease-in-out infinite alternate; }
        .km-hero-art .hook { animation: km-hook 9s ease-in-out infinite alternate; }
        .km-hero-art .beacon { fill: #ff5a4f; animation: km-beacon 2.6s ease-in-out infinite; }
        .km-hero-art .floor { stroke-dasharray: 120; stroke-dashoffset: 120; animation: km-draw 16s ease-in-out infinite; }
        .km-hero-art .floor.f2 { animation-delay: 1.6s; }
        .km-hero-art .floor.f3 { animation-delay: 3.2s; }
        .km-hero-art .floor.f4 { animation-delay: 4.8s; }

        @@keyframes km-grid-drift { from { background-position: 0 0, 0 0; } to { background-position: 30px 30px, 30px 30px; } }
        @@keyframes km-trolley { from { transform: translateX(0); } to { transform: translateX(-62px); } }
        @@keyframes km-hook { from { transform: translateY(0); } to { transform: translateY(26px); } }
        @@keyframes km-beacon { 0%, 60%, 100% { opacity: .15; } 30% { opacity: 1; } }
        @@keyframes km-draw { 0% { stroke-dashoffset: 120; } 35%, 80% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 120; } }
        @@media (prefers-reduced-motion: reduce) {
            .km-navbar::before, .km-hero-art * { animation: none !important; }
            .km-hero-art .floor { stroke-dashoffset: 0; }
        }
        /* Ana sayfada ilk kart başlığın üzerine taşar; bunun için başlığın altında yer açılır */
        .km-page-home .km-navbar { padding-bottom: 2.8rem; }

        /* Kişisel karşılama (KmGreeting bileşeni): üstte logo + menü, altında selam */
        .km-greeting { display:flex; flex-direction:column; gap:1.15rem; width:100%; }
        .km-greeting-top { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
        .km-greeting-brand { display:flex; align-items:center; gap:.7rem; text-decoration:none; min-width:0; }
        .km-greeting-brand img { height:30px; width:auto; display:block; }
        .km-greeting-brand-sep { width:1px; height:22px; background:rgba(255,255,255,.28); }
        .km-greeting-brand-label {
            color:rgba(255,255,255,.78); font-size:.68rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase;
            white-space:nowrap;
        }
        .km-greeting-text { display:flex; flex-direction:column; gap:.1rem; min-width:0; }
        .km-greeting-hi { color:rgba(255,255,255,.7); font-size:.88rem; font-weight:500; }
        .km-greeting-name {
            color:#fff; font-size:1.55rem; font-weight:800; line-height:1.2; letter-spacing:-.01em;
            overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
        }
        /* Avatar aynı zamanda menü düğmesi: Haberler/SSS/Çıkış Yap'a buradan ulaşılır */
        .km-greeting-avatar {
            width:44px; height:44px; flex-shrink:0; border-radius:14px;
            background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.28);
            -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
            display:flex; align-items:center; justify-content:center;
            color:#fff; font-weight:800; font-size:.95rem; letter-spacing:.03em; padding:0; cursor:pointer;
        }
        .km-greeting-avatar:active { background:rgba(255,255,255,.24); }

        .progress { background:#e8eaec; height: 16px !important; border-radius: 8px; }
        .progress-bar { background:var(--c-primary); }

        .card { border:1px solid var(--km-border); border-radius:18px; box-shadow:var(--km-shadow); }
        .card-body { padding: 1.25rem; }

        /* Butonlar: buyuk, parmakla kolay dokunulur (min 48px), net yazi */
        .btn {
            font-size: 1rem; padding: .8rem 1.25rem; border-radius: 8px; min-height: 48px;
            transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
        }
        .btn-sm { font-size: .95rem; padding: .7rem 1.1rem; min-height: 46px; }
        .btn-primary { background:var(--c-primary); border-color:var(--c-primary); font-weight:600; }
        .btn-primary:hover { background:#006a91; border-color:#006a91; box-shadow:0 6px 16px rgba(0,130,180,.3); }
        .btn-primary:active { transform:scale(.97); }
        .btn-outline-primary { border-width: 2px; font-weight:600; }
        .btn-success { font-weight:600; }

        /* Admin panelle aynı "yumuşak zemin" hover efekti — kartlar ve tıklanabilir satırlar için */
        .card { transition: box-shadow .2s ease, transform .15s ease; }
        a.card:hover, .card.card-clickable:hover { box-shadow:0 6px 18px rgba(0,0,0,.1); transform:translateY(-1px); }
        .km-greeting-avatar { transition: background-color .2s ease, transform .15s ease; }
        .km-greeting-avatar:hover { background:rgba(255,255,255,.28); }
        .km-greeting-avatar:active { transform:scale(.94); }

        .badge { font-size: .85rem; padding: .5em .85em; border-radius: 6px; }

        .form-control, .form-select { font-size: 1rem; padding: .7rem .9rem; min-height: 48px; border-radius: 8px; }
        .form-control:focus, .form-select:focus {
            border-color: var(--c-primary);
            box-shadow: 0 0 0 .15rem rgba(0, 130, 180, .15);
        }
        .form-select {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%230082B4' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
        }
        .form-check-input:checked { background-color: var(--c-primary); border-color: var(--c-primary); }
        .form-check-input:focus { border-color: var(--c-primary); box-shadow: 0 0 0 .15rem rgba(0, 130, 180, .25); }
        .form-label { font-size: .95rem; font-weight: 600; }

        .alert { font-size: 1rem; border-radius: 10px; }

        @@media (max-width: 575.98px) {
            body { font-size: 16.5px; }
            .container { padding-left: 1rem; padding-right: 1rem; }
            .card-body { padding: 1.1rem; }
        }

        /* ── Panel alt bilgisi: güvenli ödeme logoları + yasal linkler + şirket bilgisi ── */
        .km-legal { margin: 2.2rem 0 .5rem; padding-top: 1.1rem; border-top: 1px solid #e5e8eb;
                    text-align: center; font-size: .74rem; color: #8a94a0; }
        .km-legal-pay { display: flex; flex-direction: column; align-items: center; gap: .45rem; margin-bottom: .8rem; }
        .km-legal-secure { display: inline-flex; align-items: center; gap: .3rem; font-size: .72rem; color: #4b5563; font-weight: 600; }
        .km-legal-secure iconify-icon { color: #16a34a; font-size: .95rem; }
        .km-legal-chips { display: inline-flex; gap: .4rem; flex-wrap: wrap; justify-content: center; }
        .km-paychip { display: inline-flex; align-items: center; justify-content: center; height: 26px; min-width: 50px;
                   padding: 0 .55rem; border-radius: 6px; background: #fff; border: 1px solid #e5e8eb;
                   font-size: .66rem; font-weight: 800; letter-spacing: .04em; line-height: 1; }
        .km-paychip img { height: 14px; width: auto; display: block; }
        .km-paychip-visa { color: #1a1f71; font-style: italic; font-size: .74rem; }
        .km-paychip-troy { color: #00a3ad; }
        .km-paychip-mc i { width: 14px; height: 14px; border-radius: 50%; display: block; }
        .km-paychip-mc i:first-child { background: #eb001b; }
        .km-paychip-mc i:last-child { background: #f79e1b; margin-left: -5px; mix-blend-mode: multiply; }
        .km-legal-links { display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem .9rem; margin-bottom: .6rem; }
        .km-legal-links a { color: #6b7684; text-decoration: none; }
        .km-legal-links a:hover { color: var(--c-primary); text-decoration: underline; }
        .km-legal-company { display: flex; flex-direction: column; gap: .1rem; line-height: 1.5; }
        .km-legal-company strong { color: #4b5563; font-weight: 600; }

        /* ── Mobil uygulama hissi: yüzen (floating) alt gezinme çubuğu ──────── */
        .km-content { padding-bottom: 1.1rem; }

        .km-bottomnav {
            flex: none;
            position: sticky; bottom: 0; z-index: 1030;
            margin: 0 10px calc(10px + env(safe-area-inset-bottom, 0px));
            background: #fff; border-radius: 22px;
            box-shadow: 0 10px 28px rgba(20,30,40,.14), 0 2px 8px rgba(20,30,40,.06);
        }
        .km-bottomnav-inner {
            max-width: 720px; margin: 0 auto; display: flex; padding: 6px;
        }
        .km-bottomnav a {
            flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
            gap: .3rem; padding: .3rem .1rem; text-decoration: none; color: #9aa2ac;
            font-size: .66rem; font-weight: 600; min-height: 60px; position: relative;
            border-radius: 16px; transition: color .15s;
        }
        .km-bottomnav a span {
            max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        /* Aktif sekme: ikon renkli yuvarlak-kare rozetin içinde, beyaz simge + kalın mavi etiket */
        .km-bottomnav a iconify-icon {
            font-size: 1.3rem; width: 40px; height: 40px; border-radius: 13px;
            display: flex; align-items: center; justify-content: center;
            color: #9aa2ac; transition: all .18s;
        }
        .km-bottomnav a.active { color: var(--c-primary); font-weight: 700; }
        .km-bottomnav a.active iconify-icon {
            background: linear-gradient(135deg, #0d3150, var(--c-primary));
            color: #fff;
            box-shadow: 0 6px 14px rgba(11,27,46,.28);
        }
        .km-bottomnav a:active iconify-icon { background: #f0f2f4; }
        .km-bottomnav a.active:active iconify-icon { background: linear-gradient(135deg, #0d3150, var(--c-primary)); }

        /* Alt açılır menü (bottom sheet) */
        .km-sheet-backdrop {
            position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 1040;
            opacity: 0; transition: opacity .2s;
        }
        .km-sheet-backdrop.show { opacity: 1; }
        .km-sheet-backdrop[hidden] { display: none; }

        .km-sheet {
            position: fixed; left: 0; right: 0; bottom: 0; z-index: 1050;
            background: #fff; border-radius: 20px 20px 0 0;
            padding: .5rem .8rem calc(1rem + env(safe-area-inset-bottom, 0px));
            box-shadow: 0 -8px 30px rgba(0,0,0,.18);
            transform: translateY(100%); transition: transform .25s ease;
        }
        .km-sheet.show { transform: translateY(0); }
        .km-sheet[hidden] { display: none; }

        .km-sheet-handle {
            width: 44px; height: 4px; border-radius: 4px; background: #dfe3e7;
            margin: .4rem auto .8rem;
        }
        .km-sheet-item {
            width: 100%; display: flex; align-items: center; gap: .8rem;
            padding: .95rem .9rem; border: none; background: none; border-radius: 12px;
            text-decoration: none; color: #2B2A29; font-size: 1rem; font-weight: 600;
            min-height: 56px; text-align: left;
        }
        .km-sheet-item iconify-icon { font-size: 1.4rem; color: var(--c-primary); flex-shrink: 0; }
        .km-sheet-item span { flex: 1; }
        .km-sheet-item .km-sheet-chev { font-size: 1.1rem; color: #c3cad1; }
        .km-sheet-item:active { background: #f5f6f7; }
        .km-sheet-item.active { color: var(--c-primary); background: #f2fafd; }
        .km-sheet-item.is-danger { color: #c0392b; }
        .km-sheet-item.is-danger iconify-icon { color: #c0392b; }
        .km-sheet-logout { border-top: 1px solid #f1f3f5; margin-top: .4rem; padding-top: .4rem; }

        /* Kısa ekranlı telefonlar (iPhone SE vb.): başlık ve alt çubuk biraz daha kompakt,
           içeriğe daha fazla alan kalsın */
        @@media (max-width: 767px) and (max-height: 700px) {
            .km-navbar { padding-bottom: 1.15rem; margin-bottom: 1rem; }
            .km-page-home .km-navbar { padding-bottom: 2.4rem; }
            .km-greeting { gap: .8rem; }
            .km-greeting-name { font-size: 1.3rem; }
            .km-bottomnav a { min-height: 54px; gap: .2rem; }
            .km-bottomnav a iconify-icon { width: 36px; height: 36px; font-size: 1.2rem; }
        }

        /* Dar telefonlarda 5 sekme sığsın diye yazı ve rozet boyutu biraz küçülür */
        @@media (max-width: 360px) {
            .km-greeting-name { font-size: 1.3rem; }
            .km-bottomnav a { font-size: .6rem; }
            .km-greeting-brand-label, .km-greeting-brand-sep { display: none; }
            .km-bottomnav a iconify-icon { font-size: 1.15rem; width: 34px; height: 34px; border-radius: 11px; }
        }

        /* ── Bilgisayardan girenler için: uygulama, Base44 referansındaki gibi ortalanmış
           dar bir "app" sütunu olarak kalır — tam ekran genişliğine yayılmaz. Böylece
           kart oranları ve sabit yükseklikli görseller (tur kartı, saha fotoğrafları,
           haber kapakları) mobildekiyle aynı, dengeli oranını korur; yatay/kare görseller
           tuhaf biçimde kırpılmaz. */
        @@media (min-width: 768px) {
            /* Masaüstünde boş kenarlar "boşluk" değil, bilinçli bir zemin gibi dursun: üstte
               lacivert bir şerit + açık gri zemin; başlık tam genişlik değil, uygulama sütunuyla
               aynı genişlikte yuvarlak bir "kapak" kartı olarak ortada durur. */
            /* Şerit yalnızca sayfanın en üstünde bir kez çizilir (no-repeat) — aksi halde
               tarayıcı degradeyi sayfa boyunca tekrarlayıp araya lacivert bantlar koyuyordu. */
            body {
                background-color: var(--km-bg);
                background-image: linear-gradient(var(--c-navy), var(--c-navy));
                background-repeat: no-repeat;
                background-position: top left;
                background-size: 100% 150px;
            }
            .container { max-width: 680px; }
            .km-navbar {
                width: calc(100% - 32px); max-width: 656px; margin: 18px auto 1.4rem;
                border-radius: 26px; padding-bottom: 1.8rem;
                box-shadow: 0 18px 40px rgba(11,27,46,.28);
            }
            .km-navbar > .container { padding-left: 1.5rem; padding-right: 1.5rem; }
            .km-page-home .km-navbar { padding-bottom: 3rem; }
            .km-content { padding-top:.25rem; }
            .card, .km-card { box-shadow: var(--km-shadow); }
            /* Alt sekme çubuğu, telefonda parmakla dokunmaya göre boyutlandırılmıştı (40px ikon,
               ~11px yazı) — masaüstünde normal görüntüleme mesafesinde bu "minicik" görünüyordu.
               Çubuğu ve içindekileri masaüstü için büyütüyoruz, uygulama sütunuyla (640px) aynı
               genişlikte ve ortada kalmaya devam ediyor.
               Not: body flex sütunu içinde margin:0 auto TEK BAŞINA genişliği içeriğe göre
               küçültüyordu (auto kenar boşluğu, dikey flex'te "stretch" davranışını iptal edip
               çubuğu sadece ~280px'e daraltıyordu) — bu yüzden 640px'e asla ulaşmıyor, ekranın
               ortasında minik bir hap gibi kalıyordu. width:100% eklemek bunu düzeltir.
            */
            .km-bottomnav {
                width:100%; max-width:656px; margin:0 auto calc(16px + env(safe-area-inset-bottom, 0px));
                border-radius:26px;
            }
            .km-bottomnav-inner { padding:10px; }
            .km-bottomnav a { min-height:70px; font-size:.85rem; gap:.4rem; }
            .km-bottomnav a iconify-icon { font-size:1.55rem; width:48px; height:48px; border-radius:15px; }

            /* Avatar menüsü (km-sheet): mobilde ekranın tam genişliğine yayılan bir "bottom
               sheet" — masaüstünde bu tam-ekran-genişliği tuhaf ve aşırı büyük görünüyordu.
               Uygulama sütunuyla (640px) aynı genişlikte, ortalanmış, ekranın altına yapışık
               olmayan (küçük bir boşluk bırakan) yuvarlak köşeli bir panel olarak göster. */
            .km-sheet {
                left:50%; right:auto; bottom:16px;
                width:100%; max-width:656px; transform:translate(-50%, 120%);
                border-radius:20px; box-shadow:0 12px 40px rgba(20,30,40,.22);
            }
            .km-sheet.show { transform:translate(-50%, 0); }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["BodyClass"] ?? "")">
    <nav class="km-navbar navbar navbar-dark">
        <div class="km-hero-art" aria-hidden="true">
            <svg viewBox="0 0 380 170" preserveAspectRatio="xMaxYMax meet">
