    </nav>

    <div class="container km-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()

        @* Güvenli ödeme + yasal alt bilgi yalnızca ödeme ekranlarında (Ödemelerim) gösterilir. *@
        @if (User.Identity?.IsAuthenticated == true && ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard")
        {
            var kmSettings = await SiteSettings.GetAllAsync();
            string KmV(string k) => kmSettings.TryGetValue(k, out var v) && !string.IsNullOrWhiteSpace(v) ? v!.Trim() : "";
            var kmTitle = KmV(BrikonYapi.Web.Services.LegalPages.KeyCompanyTitle);
            if (!string.IsNullOrEmpty(kmTitle))
            {
                var kmTaxOffice = KmV(BrikonYapi.Web.Services.LegalPages.KeyTaxOffice);
                var kmTaxNo = KmV(BrikonYapi.Web.Services.LegalPages.KeyTaxNumber);
                var kmAddress = KmV("Address");
                var kmMersis = KmV(BrikonYapi.Web.Services.LegalPages.KeyMersisNo);
                <footer class="km-legal">
                    <div class="km-legal-pay">
                        <span class="km-legal-secure">
                            <iconify-icon icon="mdi:lock-outline"></iconify-icon> 3D Secure ile güvenli ödeme
                        </span>
                        <span class="km-legal-chips">
                            <span class="km-paychip"><img src="/images/tkpay.png" alt="tkpay" /></span>
                            <span class="km-paychip km-paychip-visa">VISA</span>
                            <span class="km-paychip km-paychip-mc"><i></i><i></i></span>
                            <span class="km-paychip km-paychip-troy">TROY</span>
                        </span>
                    </div>
                    <div class="km-legal-links">
                        @foreach (var lp in BrikonYapi.Web.Services.LegalPages.All)
                        {
                            <a href="/yasal/@lp.Slug" target="_blank" rel="noopener">@lp.Title</a>
                        }
                    </div>
                    <div class="km-legal-company">
                        <strong>@kmTitle</strong>
                        @if (!string.IsNullOrEmpty(kmAddress)) { <span>@kmAddress</span> }
                        @if (!string.IsNullOrEmpty(kmTaxOffice) || !string.IsNullOrEmpty(kmTaxNo))
                        {
                            <span>@("Vergi Dairesi: " + kmTaxOffice + (string.IsNullOrEmpty(kmTaxNo) ? "" : " • VKN: " + kmTaxNo))</span>
                        }
                        @if (!string.IsNullOrEmpty(kmMersis)) { <span>MERSİS: @kmMersis</span> }
                    </div>
                </footer>
            }
        }
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="km-bottomnav">
            <div class="km-bottomnav-inner">
                <a href="/KatMaliki/Progress" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Progress" ? "active" : "")">
                    <iconify-icon icon="iconamoon:home-duotone"></iconify-icon>
                    <span>Ana Sayfa</span>
                </a>
                <a href="/KatMaliki/Dashboard" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <iconify-icon icon="iconamoon:credit-card-duotone"></iconify-icon>
                    <span>Ödemelerim</span>
                </a>
                <a href="/KatMaliki/Polls" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Polls" ? "active" : "")">
                    <iconify-icon icon="iconamoon:check-square-duotone"></iconify-icon>
                    <span>Oylama</span>
                </a>
                <a href="/KatMaliki/Chat" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Chat" ? "active" : "")">
                    <iconify-icon icon="iconamoon:comment-dots-duotone"></iconify-icon>
                    <span>Sohbet</span>
                </a>
            </div>
        </nav>

        <!-- Mobil menü: alt çubuğa sığmayan bölümler -->
        <div id="kmSheetBackdrop" class="km-sheet-backdrop" hidden></div>
        <div id="kmSheet" class="km-sheet" role="dialog" aria-modal="true" aria-label="Menü" hidden>
            <div class="km-sheet-handle"></div>
            <a class="km-sheet-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "News" ? "active" : "")" href="/KatMaliki/News">
                <iconify-icon icon="iconamoon:news-duotone"></iconify-icon>
                <span>Haberler &amp; Projeler</span>
                <iconify-icon class="km-sheet-chev" icon="iconamoon:arrow-right-2"></iconify-icon>
            </a>
            <a class="km-sheet-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Faq" ? "active" : "")" href="/KatMaliki/Faq">
                <iconify-icon icon="iconamoon:question-mark-circle-duotone"></iconify-icon>
                <span>Sıkça Sorulan Sorular</span>
                <iconify-icon class="km-sheet-chev" icon="iconamoon:arrow-right-2"></iconify-icon>
            </a>
            <form asp-area="KatMaliki" asp-controller="Account" asp-action="Logout" method="post" class="km-sheet-logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="km-sheet-item is-danger">
                    <iconify-icon icon="iconamoon:exit-duotone"></iconify-icon>
                    <span>Çıkış Yap</span>
                </button>
            </form>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>

    <script>
    (function () {
        var btn      = document.getElementById('kmMenuBtn');
        var sheet    = document.getElementById('kmSheet');
        var backdrop = document.getElementById('kmSheetBackdrop');
        if (!btn || !sheet || !backdrop) return;

        function open() {
            sheet.hidden = false;
            backdrop.hidden = false;
            // Kısa gecikme ile sınıf eklenir ki CSS geçişi çalışsın.
            // (requestAnimationFrame arka plandaki sekmelerde duraklatıldığı için setTimeout kullanılıyor.)
            setTimeout(function () {
                sheet.classList.add('show');
                backdrop.classList.add('show');
            }, 10);
            btn.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
        }

        function close() {
            sheet.classList.remove('show');
            backdrop.classList.remove('show');
            btn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            setTimeout(function () {
                sheet.hidden = true;
                backdrop.hidden = true;
            }, 250);
        }

        btn.addEventListener('click', function () {
            sheet.hidden ? open() : close();
        });
        backdrop.addEventListener('click', close);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !sheet.hidden) close();
        });
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
