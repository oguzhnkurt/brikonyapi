@using BrikonYapi.Web.Areas.KatMaliki.Models
@model ProgressPageViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["BodyClass"] = "km-page-home";
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

@if (!Model.Projects.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            Hesabınıza henüz bir bağımsız bölüm atanmamış. Lütfen yönetici ile iletişime geçin.
        </div>
    </div>
}

@for (var projectIndex = 0; projectIndex < Model.Projects.Count; projectIndex++)
{
    var p = Model.Projects[projectIndex];
    var isFirstProject = projectIndex == 0;
    var firstUnit = p.Units.FirstOrDefault();
    var unitLabel = firstUnit == null ? null : string.Join(" · ", new[] { firstUnit.BlockNo, "No " + firstUnit.UnitNo }.Where(x => !string.IsNullOrWhiteSpace(x)));
    var unitDetail = firstUnit == null ? null : string.Join(" · ", new[]
    {
        firstUnit.FloorNo.HasValue ? $"{firstUnit.FloorNo}. Kat" : null,
        firstUnit.RoomLayout,
        firstUnit.AreaM2.HasValue ? $"{firstUnit.AreaM2} m²" : null
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    <!-- Genel ilerleme kartı: daire bilgisi + ilerleme halkası + aşama/teslim özeti -->
    var unitTags = firstUnit == null ? new List<string>() : new[]
    {
        firstUnit.BlockNo,
        string.IsNullOrWhiteSpace(firstUnit.UnitNo) ? null : "No " + firstUnit.UnitNo,
        firstUnit.FloorNo.HasValue ? $"{firstUnit.FloorNo}. Kat" : null,
        firstUnit.RoomLayout,
        firstUnit.AreaM2.HasValue ? $"{firstUnit.AreaM2} m²" : null
    }.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!).ToList();
    var ringPct = Math.Clamp(p.OverallProgress, 0, 100);
    const double ringC = 2 * Math.PI * 34; // r = 34
    var ringOffset = (ringC * (1 - ringPct / 100.0)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var ringCStr = ringC.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var stagesTotal = p.Stages.Count;
    var stagesDone = p.Stages.Count(st => st.Status == BrikonYapi.Web.Data.Entities.ProjectStageStatus.Completed);
    var stagesNow = p.Stages.Where(st => st.Status == BrikonYapi.Web.Data.Entities.ProjectStageStatus.InProgress).Select(st => st.Name).ToList();
    int? daysLeft = p.EstimatedDelivery.HasValue ? (int)(p.EstimatedDelivery.Value.Date - DateTime.Today).TotalDays : null;

    <div class="km-card km-prog-summary mb-4 @(isFirstProject ? "km-prog-summary-first" : "")">
        <div class="km-ps-head">
            <span class="km-prog-unit-icon"><iconify-icon icon="mdi:home-city-outline"></iconify-icon></span>
            <div class="km-ps-title">
                <span class="km-ps-eyebrow">Bağımsız Bölümünüz</span>
                <strong class="km-ps-name">@p.Project.Name</strong>
                @if (unitTags.Any())
                {
                    <span class="km-ps-tags">
                        @foreach (var t in unitTags)
                        {
                            <span class="km-ps-tag">@t</span>
                        }
                    </span>
                }
            </div>
        </div>

        <div class="km-ps-body">
            <div class="km-ps-ring" role="img" aria-label="Genel ilerleme yüzde @ringPct">
                <svg viewBox="0 0 80 80">
                    <defs>
                        <linearGradient id="kmRingGrad@(projectIndex)" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#00A0E3" />
                            <stop offset="100%" stop-color="#0d3150" />
                        </linearGradient>
                    </defs>
                    <circle cx="40" cy="40" r="34" class="km-ps-ring-track" />
                    <circle cx="40" cy="40" r="34" class="km-ps-ring-fill" stroke="url(#kmRingGrad@(projectIndex))"
                            style="stroke-dasharray:@ringCStr; stroke-dashoffset:@ringOffset; --ring-c:@ringCStr;" />
                </svg>
                <span class="km-ps-ring-text">
                    <span class="km-ps-ring-val"><small>%</small>@ringPct</span>
                    <span class="km-ps-ring-lbl">ilerleme</span>
                </span>
            </div>

            <ul class="km-ps-facts">
                @if (stagesNow.Any())
                {
                    <li>
                        <span class="km-ps-fact-ic"><iconify-icon icon="mdi:crane"></iconify-icon></span>
                        <span class="km-ps-fact-tx">
                            <span class="km-ps-fact-lbl">Devam eden iş</span>
                            <span class="km-ps-fact-val">@string.Join(", ", stagesNow)</span>
                        </span>
                    </li>
                }
                @if (stagesTotal > 0)
                {
                    <li>
                        <span class="km-ps-fact-ic"><iconify-icon icon="mdi:check-decagram-outline"></iconify-icon></span>
                        <span class="km-ps-fact-tx">
                            <span class="km-ps-fact-lbl">Tamamlanan aşama</span>
                            <span class="km-ps-fact-val">@stagesDone / @stagesTotal</span>
                        </span>
                    </li>
                }
                @if (p.EstimatedDelivery.HasValue)
                {
                    <li>
                        <span class="km-ps-fact-ic"><iconify-icon icon="iconamoon:calendar-1-duotone"></iconify-icon></span>
                        <span class="km-ps-fact-tx">
                            <span class="km-ps-fact-lbl">Tahmini teslim</span>
                            <span class="km-ps-fact-val">
                                @p.EstimatedDelivery.Value.ToString("dd MMMM yyyy", tr)
                                @if (daysLeft > 0)
                                {
                                    <span class="km-ps-days">@daysLeft gün</span>
                                }
                            </span>
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- 360° sanal tur -->
    @if (!string.IsNullOrEmpty(p.SafeVirtualTourUrl))
    {
        <h6 class="km-section-title">Projeyi Gezin</h6>
        <button type="button" class="km-tour-card mb-4"
                data-tour-url="@p.SafeVirtualTourUrl"
                data-tour-title="@p.Project.Name">
            <div class="km-tour-bg" style="@(!string.IsNullOrEmpty(p.Project.MainImagePath) ? $"background-image:url('{p.Project.MainImagePath}')" : "")"></div>
            <span class="km-tour-badge">
                <iconify-icon icon="iconamoon:3d-duotone"></iconify-icon> 360° Sanal Tur
            </span>
            <span class="km-tour-cta">
                <span class="km-tour-cta-text">
                    <span class="km-tour-cta-title">@p.Project.Name</span>
                    <span class="km-tour-cta-sub">Daireyi ve projeyi 360° gezin</span>
                </span>
                <span class="km-tour-cta-btn">
                    <iconify-icon icon="iconamoon:player-play-duotone"></iconify-icon> Turu başlat
                </span>
            </span>
        </button>
    }

    @if (isFirstProject && Model.HasAnySchedule)
    {
        <!-- Ödeme özeti (para birimine göre ayrı — bkz. Admin taksit sihirbazı) -->
        @if (Model.PaymentTotals.All(t => t.Remaining <= 0) && Model.PaymentTotals.Any(t => t.Paid > 0))
        {
            <div class="km-home-banner mb-3">
                <iconify-icon icon="iconamoon:check-circle-1-duotone"></iconify-icon>
                <span>Tüm ödemeleriniz tamamlandı.</span>
            </div>
        }

        @foreach (var pt in Model.PaymentTotals)
        {
            var ptTotal = pt.Paid + pt.Remaining;
            var ptPct = ptTotal > 0 ? (double)(pt.Paid / ptTotal * 100) : 0;
            <div class="km-pay-card mb-3">
                <div class="km-pay-card-top">
                    <span class="km-pay-card-title">
                        <span class="km-pay-card-ic"><iconify-icon icon="iconamoon:wallet-duotone"></iconify-icon></span>
                        <span class="km-pay-card-ttx">
                            <span class="km-pay-card-eyebrow">Ödeme Durumu @(Model.PaymentTotals.Count > 1 ? $"({pt.Currency})" : "")</span>
                            <span class="km-pay-card-total">@pt.Symbol@ptTotal.ToString("N0", tr) <small>toplam</small></span>
                        </span>
                    </span>
                    <span class="km-pay-card-pct">%@(Math.Round(ptPct))</span>
                </div>
                <div class="km-pay-progress">
                    <div class="km-pay-progress-fill" style="width:@(ptPct.ToString("0.##", tr))%"></div>
                </div>
                <div class="km-pay-stats">
                    <div class="km-pay-stat">
                        <span class="km-pay-stat-icon is-paid"><iconify-icon icon="iconamoon:check-circle-1-duotone"></iconify-icon></span>
                        <span class="km-pay-stat-text">
                            <span class="km-pay-stat-label">Ödenen</span>
                            <span class="km-pay-stat-value is-paid">@pt.Symbol@pt.Paid.ToString("N0", tr)</span>
                        </span>
                    </div>
                    <div class="km-pay-stat-divider"></div>
                    <div class="km-pay-stat">
                        <span class="km-pay-stat-icon is-remaining"><iconify-icon icon="iconamoon:credit-card-duotone"></iconify-icon></span>
                        <span class="km-pay-stat-text">
                            <span class="km-pay-stat-label">Kalan</span>
                            <span class="km-pay-stat-value">@pt.Symbol@pt.Remaining.ToString("N0", tr)</span>
                        </span>
                    </div>
                </div>
                <a href="/KatMaliki/Dashboard" class="km-pay-card-link">
                    Tüm ödemeleri gör <iconify-icon icon="iconamoon:arrow-right-2"></iconify-icon>
                </a>
            </div>
        }
    }

    <!-- İnşaat aşamaları: dikey zaman çizelgesi -->
    @if (p.Stages.Any())
    {
        var stTotal = p.Stages.Count;
        var stDone = p.Stages.Count(st => st.Status == BrikonYapi.Web.Data.Entities.ProjectStageStatus.Completed);
        <h6 class="km-section-title">İnşaat Aşamaları</h6>
        <div class="km-card km-tl mb-4">
            <div class="km-tl-head">
                <span class="km-tl-head-txt"><strong>@stDone</strong> / @stTotal aşama tamamlandı</span>
                <span class="km-tl-seg">
                    @foreach (var sg in p.Stages)
                    {
                        <i class="@(sg.Status == BrikonYapi.Web.Data.Entities.ProjectStageStatus.Completed ? "is-done" : sg.Status == BrikonYapi.Web.Data.Entities.ProjectStageStatus.InProgress ? "is-now" : "")"></i>
                    }
                </span>
            </div>
            <ol class="km-tl-list">
                @foreach (var s in p.Stages)
                {
                    var isDone = s.Status == BrikonYapi.Web.Data.Entities.ProjectStageStatus.Completed;
                    var isNow = s.Status == BrikonYapi.Web.Data.Entities.ProjectStageStatus.InProgress;
                    <li class="km-tl-item @(isNow ? "is-now" : "") @(isDone ? "is-done" : "")">
                        <span class="km-tl-dot">
                            @if (isDone)
                            {
                                <iconify-icon icon="iconamoon:check-bold"></iconify-icon>
                            }
                            else if (isNow)
                            {
                                <span class="km-tl-pulse"></span>
                            }
                            else
                            {
                                @s.OrderIndex
                            }
                        </span>
                        <span class="km-tl-body">
                            <span class="km-tl-row">
                                <span class="km-tl-name">@s.Name</span>
                                @if (isNow)
                                {
                                    <span class="km-tl-badge">Devam ediyor</span>
                                }
                            </span>
                            @if (isDone && s.CompletedAt.HasValue)
                            {
                                <span class="km-tl-sub">Tamamlandı · @s.CompletedAt.Value.ToString("dd MMMM yyyy", tr)</span>
                            }
                            else if (isNow)
                            {
                                if (s.ProgressPercentage > 0)
                                {
                                    <span class="km-tl-mini"><i style="width:@(s.ProgressPercentage)%"></i></span>
                                }
                                if (s.PlannedEndDate.HasValue)
                                {
                                    <span class="km-tl-sub">Hedef bitiş · @s.PlannedEndDate.Value.ToString("dd MMMM yyyy", tr)</span>
                                }
                            }
                            else if (!isDone && s.PlannedStartDate.HasValue)
                            {
                                <span class="km-tl-sub">Planlanan başlangıç · @s.PlannedStartDate.Value.ToString("dd MMMM yyyy", tr)</span>
                            }
                        </span>
                    </li>
                }
            </ol>
        </div>
    }

    <!-- Saha fotoğrafları -->
    @if (p.Photos.Any())
    {
        <div class="d-flex justify-content-between align-items-baseline">
            <h6 class="km-section-title">Saha Fotoğrafları</h6>
            <span class="km-photo-count">@p.Photos.Count güncelleme</span>
        </div>
        <div class="km-photo-scroll mb-4">
            @foreach (var ph in p.Photos)
            {
                <button type="button" class="km-photo-card"
                        data-photo-src="@ph.ImagePath"
                        data-photo-caption="@ph.Caption">
                    <span class="km-photo-img" style="background-image:url('@ph.ImagePath')"></span>
                    @if (ph.Is360)
                    {
                        <span class="km-photo-360">360°</span>
                    }
                    <span class="km-photo-meta">
                        @if (!string.IsNullOrEmpty(ph.Caption))
                        {
                            <span class="km-photo-caption">@ph.Caption</span>
                        }
                        <span class="km-photo-date">@ph.TakenAt.ToString("dd MMM yyyy", tr)</span>
                    </span>
                </button>
            }
        </div>
    }

    @if (!p.Stages.Any() && !p.Photos.Any() && string.IsNullOrEmpty(p.SafeVirtualTourUrl))
    {
        <div class="card mb-4">
            <div class="card-body text-center text-muted py-4">
                Bu proje için henüz ilerleme detayı paylaşılmamış.
            </div>
        </div>
    }
}

@if (Model.RecentNews.Any())
{
    <div class="d-flex justify-content-between align-items-baseline mb-2">
        <h6 class="km-section-title mb-0">
            <iconify-icon icon="iconamoon:news-duotone" class="me-1"></iconify-icon> Haberler
        </h6>
        <a href="/KatMaliki/News" class="km-home-link-sm">Tümü <iconify-icon icon="iconamoon:arrow-right-2"></iconify-icon></a>
    </div>
    <div class="km-home-news mb-4">
        @foreach (var n in Model.RecentNews)
        {
            <a class="km-home-news-item" href="/KatMaliki/News/Detail/@n.Id">
                @if (!string.IsNullOrEmpty(n.CoverImagePath))
                {
                    <span class="km-home-news-thumb" style="background-image:url('@n.CoverImagePath')"></span>
                }
                <span class="km-home-news-text">
                    <span class="km-home-news-date">@n.CreatedAt.ToString("dd MMM yyyy", tr)</span>
                    <span class="km-home-news-title">@n.Title</span>
                </span>
            </a>
        }
    </div>
}

<!-- Tam ekran görsel/tur penceresi -->
<div id="km-viewer" class="km-viewer" hidden>
    <div class="km-viewer-bar">
        <span id="km-viewer-title" class="km-viewer-title"></span>
        <div class="km-viewer-actions">
            <a id="km-viewer-open" class="km-viewer-btn" href="#" target="_blank" rel="noopener noreferrer" hidden>
                <iconify-icon icon="iconamoon:link-external"></iconify-icon>
            </a>
            <button type="button" id="km-viewer-close" class="km-viewer-btn" aria-label="Kapat">
                <iconify-icon icon="iconamoon:close"></iconify-icon>
            </button>
        </div>
    </div>
    <div class="km-viewer-body">
        <iframe id="km-viewer-frame" hidden referrerpolicy="no-referrer"
                sandbox="allow-scripts allow-same-origin allow-popups"
                allowfullscreen></iframe>
        <img id="km-viewer-img" hidden alt="" />
    </div>
</div>

@section Styles {
<style>
    .km-card { background:#fff; border-radius:18px; padding:1.25rem 1.35rem; border:1px solid var(--km-border); box-shadow:var(--km-shadow); }

    /* İlk proje kartı, üstteki lacivert başlığın üzerine taşarak onunla birleşir */
    .km-prog-summary-first { margin-top:-3.6rem; position:relative; z-index:2; }
    .km-prog-summary { background:#fff; }

    .km-prog-unit { display:flex; align-items:center; gap:.75rem; padding-bottom:.9rem; margin-bottom:.9rem; border-bottom:1px solid #f1f3f5; }
    .km-prog-unit-icon {
        width:44px; height:44px; flex-shrink:0; border-radius:13px;
        background:linear-gradient(135deg, #0d3150, var(--c-primary));
        display:flex; align-items:center; justify-content:center;
        box-shadow:0 6px 14px rgba(11,27,46,.2);
    }
    .km-prog-unit-icon iconify-icon { font-size:1.3rem; color:#fff; }
    .km-prog-unit-text { display:flex; flex-direction:column; gap:.05rem; font-size:.98rem; min-width:0; }
    .km-prog-unit-sub { font-size:.82rem; color:#9aa3ac; font-weight:500; }

    /* Özet kartı (kurumsal): başlık + etiketler, solda ilerleme halkası, sağda kısa bilgiler */
    .km-ps-head { display:flex; align-items:flex-start; gap:.85rem; padding-bottom:1rem; margin-bottom:1rem; border-bottom:1px solid #eef1f4; }
    .km-ps-title { display:flex; flex-direction:column; min-width:0; gap:.15rem; }
    .km-ps-eyebrow { font-size:.66rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:#8a939c; }
    .km-ps-name { font-size:1.12rem; font-weight:800; color:var(--c-navy); line-height:1.25; }
    .km-ps-tags { display:flex; flex-wrap:wrap; gap:.3rem; margin-top:.35rem; }
    .km-ps-tag { font-size:.72rem; font-weight:600; color:#4b5866; background:#f1f4f8; border:1px solid #e6ebf0; border-radius:6px; padding:.15rem .5rem; white-space:nowrap; }

    .km-ps-body { display:flex; align-items:center; gap:1.25rem; }
    .km-ps-ring { position:relative; width:112px; height:112px; flex-shrink:0; }
    .km-ps-ring svg { width:100%; height:100%; transform:rotate(-90deg); }
    .km-ps-ring-track { fill:none; stroke:#edf1f5; stroke-width:7; }
    .km-ps-ring-fill { fill:none; stroke-width:7; stroke-linecap:round; animation:km-ring-in 1.2s cubic-bezier(.2,.7,.2,1) both; }
    @@keyframes km-ring-in { from { stroke-dashoffset: var(--ring-c); } }
    .km-ps-ring-text { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
    .km-ps-ring-val { font-size:1.75rem; font-weight:800; color:var(--c-navy); line-height:1; letter-spacing:-.02em; }
    .km-ps-ring-val small { font-size:.55em; color:var(--c-primary); font-weight:700; margin-right:.05em; }
    .km-ps-ring-lbl { font-size:.62rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#8a939c; margin-top:.25rem; }

    .km-ps-facts { list-style:none; margin:0; padding:0; flex:1; min-width:0; display:flex; flex-direction:column; gap:.7rem; }
    .km-ps-facts li { display:flex; align-items:center; gap:.65rem; }
    .km-ps-fact-ic { width:32px; height:32px; flex-shrink:0; border-radius:9px; background:#eef6fb; color:var(--c-primary);
                     display:flex; align-items:center; justify-content:center; font-size:1.05rem; }
    .km-ps-fact-tx { display:flex; flex-direction:column; min-width:0; }
    .km-ps-fact-lbl { font-size:.68rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#8a939c; }
    .km-ps-fact-val { font-size:.92rem; font-weight:700; color:var(--c-navy); line-height:1.3; display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; }
    .km-ps-days { font-size:.7rem; font-weight:700; color:var(--c-primary); background:#eef6fb; border-radius:20px; padding:.08rem .5rem; }
    @@media (max-width: 400px) {
        .km-ps-ring { width:96px; height:96px; }
        .km-ps-ring-val { font-size:1.5rem; }
        .km-ps-body { gap:1rem; }
    }
    @@media (prefers-reduced-motion: reduce) { .km-ps-ring-fill { animation:none; } }

    .km-prog-label { font-size:.7rem; color:#8a939c; font-weight:700; text-transform:uppercase; letter-spacing:.09em; }
    .km-prog-value { font-size:2.4rem; font-weight:800; color:var(--c-navy); line-height:1.05; letter-spacing:-.02em; }
    .km-prog-value small { font-size:.55em; font-weight:700; color:var(--c-primary); margin-right:.05em; }
    .km-prog-delivery { font-size:1rem; font-weight:700; color:var(--c-navy); display:inline-flex; align-items:center; gap:.35rem; }
    .km-prog-delivery iconify-icon { color:var(--c-primary); font-size:1.05rem; }
    .km-prog-bar { height:10px; background:#edf1f5; border-radius:20px; overflow:hidden; }
    .km-prog-bar-fill { height:100%; background:linear-gradient(90deg,var(--c-primary),var(--c-secondary)); border-radius:20px; transition:width .6s ease; }
    .km-prog-current { font-size:.92rem; color:#4a5158; display:flex; align-items:center; gap:.4rem; }
    .km-prog-current iconify-icon { color:var(--c-primary); font-size:1.15rem; }

    .km-section-title {
        display:flex; align-items:center; gap:.5rem; margin:0 0 .8rem;
        font-size:.74rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:#5b6672;
    }
    .km-section-title::before { content:''; width:3px; height:14px; border-radius:3px; background:linear-gradient(180deg,var(--c-secondary),var(--c-primary)); }

    /* 360 tur kartı */
    .km-tour-card {
        display:block; position:relative; width:100%; border:none; padding:0; overflow:hidden;
        border-radius:18px; height:200px; background:var(--c-navy); box-shadow:var(--km-shadow); text-align:left;
    }
    .km-tour-bg { position:absolute; inset:0; background:var(--c-navy) center/cover no-repeat; transition:transform .6s ease; }
    .km-tour-card:hover .km-tour-bg { transform:scale(1.04); }
    .km-tour-card::after { content:''; position:absolute; inset:0; background:linear-gradient(to top, rgba(11,27,46,.85) 0%, rgba(11,27,46,.25) 45%, rgba(11,27,46,0) 70%); }
    .km-tour-badge {
        position:absolute; top:.8rem; left:.8rem; z-index:2; display:inline-flex; align-items:center; gap:.3rem;
        background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.35); color:#fff;
        -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px);
        font-size:.72rem; font-weight:700; letter-spacing:.04em; padding:.35rem .7rem; border-radius:20px;
    }
    .km-tour-cta {
        position:absolute; left:1rem; right:1rem; bottom:1rem; z-index:2;
        display:flex; align-items:center; justify-content:space-between; gap:.6rem; color:#fff;
    }
    .km-tour-cta-text { display:flex; flex-direction:column; min-width:0; }
    .km-tour-cta-title { font-weight:800; font-size:1.05rem; line-height:1.2; }
    .km-tour-cta-sub { font-size:.78rem; color:rgba(255,255,255,.75); }
    .km-tour-cta-btn {
        flex-shrink:0; display:inline-flex; align-items:center; gap:.35rem;
        background:#fff; color:var(--c-navy); font-weight:700; font-size:.85rem;
        padding:.55rem .95rem; border-radius:999px; box-shadow:0 6px 16px rgba(0,0,0,.25);
    }
    .km-tour-cta-btn iconify-icon { color:var(--c-primary); font-size:1.05rem; }

    /* Aşamalar: dikey zaman çizelgesi */
    .km-tl { padding:1.1rem 1.25rem 1rem; }
    .km-tl-head { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-bottom:.9rem; margin-bottom:.5rem; border-bottom:1px solid #eef1f4; }
    .km-tl-head-txt { font-size:.85rem; color:#5b6672; white-space:nowrap; }
    .km-tl-head-txt strong { color:var(--c-navy); font-size:1rem; }
    .km-tl-seg { display:flex; gap:3px; flex:1; max-width:180px; }
    .km-tl-seg i { flex:1; height:6px; border-radius:3px; background:#e6ebf0; }
    .km-tl-seg i.is-done { background:var(--c-primary); }
    .km-tl-seg i.is-now { background:linear-gradient(90deg,var(--c-primary) 50%, #bfe3f3 50%); }

    .km-tl-list { list-style:none; margin:0; padding:0; }
    .km-tl-item { position:relative; display:flex; gap:.85rem; padding:.55rem 0; }
    /* Noktaları birleştiren dikey çizgi */
    .km-tl-item::before {
        content:''; position:absolute; left:14px; top:calc(.55rem + 30px); bottom:calc(-.55rem); width:2px; background:#e6ebf0;
    }
    .km-tl-item:last-child::before { display:none; }
    .km-tl-item.is-done::before { background:var(--c-primary); }

    .km-tl-dot {
        position:relative; z-index:1; width:30px; height:30px; flex-shrink:0; border-radius:50%;
        display:flex; align-items:center; justify-content:center;
        background:#fff; border:2px solid #dfe5eb; color:#9aa3ac; font-size:.78rem; font-weight:700;
    }
    .km-tl-item.is-done .km-tl-dot { background:var(--c-primary); border-color:var(--c-primary); color:#fff; font-size:.95rem; }
    .km-tl-item.is-now .km-tl-dot { border-color:var(--c-primary); box-shadow:0 0 0 4px rgba(0,130,180,.12); }
    .km-tl-pulse { width:10px; height:10px; border-radius:50%; background:var(--c-primary); animation:km-tl-pulse 1.8s ease-in-out infinite; }
    @@keyframes km-tl-pulse { 0%,100% { transform:scale(1); opacity:1; } 50% { transform:scale(.6); opacity:.55; } }

    .km-tl-body { flex:1; min-width:0; display:flex; flex-direction:column; gap:.2rem; padding-top:.2rem; }
    .km-tl-row { display:flex; align-items:center; flex-wrap:wrap; gap:.5rem; }
    .km-tl-name { font-size:.98rem; font-weight:600; color:#9aa3ac; }
    .km-tl-item.is-done .km-tl-name { color:var(--c-navy); }
    .km-tl-item.is-now .km-tl-name { color:var(--c-navy); font-weight:800; }
    .km-tl-badge { font-size:.66rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase; color:var(--c-primary); background:#e6f4fb; border-radius:20px; padding:.15rem .55rem; }
    .km-tl-sub { font-size:.76rem; color:#8a939c; }
    .km-tl-mini { display:block; height:5px; max-width:200px; background:#e6ebf0; border-radius:4px; overflow:hidden; margin-top:.15rem; }
    .km-tl-mini i { display:block; height:100%; background:linear-gradient(90deg,var(--c-secondary),var(--c-primary)); border-radius:4px; }
    @@media (prefers-reduced-motion: reduce) { .km-tl-pulse { animation:none; } }

    /* Saha fotoğrafları */
    .km-photo-count { font-size:.82rem; color:#9aa3ac; }
    .km-photo-scroll {
        display:flex; gap:.8rem; overflow-x:auto; padding-bottom:.3rem;
        scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch;
    }
    .km-photo-scroll::-webkit-scrollbar { height:5px; }
    .km-photo-scroll::-webkit-scrollbar-track { background:#eef0f2; border-radius:10px; }
    .km-photo-scroll::-webkit-scrollbar-thumb { background:#d8dde1; border-radius:10px; }
    /* Web/masaüstü görünümde: mobildeki ince dokunmatik iz yerine, fare ile sürüklenip
       görülebilecek daha kalın, belirgin bir scrollbar */
    @@media (min-width: 768px) {
        .km-photo-scroll { scrollbar-width: auto; scrollbar-color: #b9c0c7 #eef0f2; }
        .km-photo-scroll::-webkit-scrollbar { height:12px; }
        .km-photo-scroll::-webkit-scrollbar-thumb { background:#b9c0c7; border-radius:10px; border:3px solid #eef0f2; }
        .km-photo-scroll::-webkit-scrollbar-thumb:hover { background:#9aa3ac; }
    }
    .km-photo-card {
        position:relative; flex:0 0 240px; scroll-snap-align:start; border:1px solid var(--km-border); padding:0;
        border-radius:16px; overflow:hidden; background:#fff; box-shadow:var(--km-shadow); text-align:left;
    }
    .km-photo-img { display:block; height:160px; background:#0d1520 center/cover no-repeat; }
    .km-photo-360 {
        position:absolute; top:.55rem; left:.55rem; background:rgba(0,0,0,.6); color:#fff;
        font-size:.7rem; font-weight:700; padding:.25rem .55rem; border-radius:20px;
    }
    .km-photo-meta { display:block; padding:.6rem .8rem .75rem; }
    .km-photo-caption { display:block; font-size:.88rem; font-weight:600; line-height:1.3; }
    .km-photo-date { display:block; font-size:.76rem; color:#9aa3ac; margin-top:.15rem; }

    /* Ödeme özeti (Ana Sayfa) */
    .km-home-banner {
        display:flex; align-items:center; gap:.6rem; background:#e6f7ed; color:#1e9e5a;
        border-radius:14px; padding:.9rem 1.05rem; font-size:.95rem; font-weight:700;
    }
    .km-home-banner iconify-icon { font-size:1.3rem; flex-shrink:0; }

    /* Ödeme durumu kartı: ayrı ayrı çirkin kutucuklar yerine tek, marka renkli, oranlı bir kart */
    .km-pay-card {
        background:#fff; border-radius:18px; padding:1.15rem 1.25rem 1.1rem;
        box-shadow:var(--km-shadow); border:1px solid var(--km-border);
    }
    .km-pay-card-top { display:flex; align-items:center; justify-content:space-between; gap:.6rem; margin-bottom:.9rem; }
    .km-pay-card-title { display:flex; align-items:center; gap:.7rem; font-size:.95rem; font-weight:800; color:var(--c-navy); }
    .km-pay-card-title iconify-icon { font-size:1.15rem; color:var(--c-primary); }
    .km-pay-card-pct { font-size:.85rem; font-weight:800; color:#1e9e5a; background:#e6f7ed; border-radius:20px; padding:.25rem .65rem; white-space:nowrap; }

    .km-pay-card-ic { width:38px; height:38px; flex-shrink:0; border-radius:11px; background:linear-gradient(135deg,#0d3150,var(--c-primary)); color:#fff;
                      display:flex; align-items:center; justify-content:center; font-size:1.15rem; box-shadow:0 6px 14px rgba(11,27,46,.18); }
    .km-pay-card-ic iconify-icon { color:#fff !important; }
    .km-pay-card-ttx { display:flex; flex-direction:column; gap:.05rem; }
    .km-pay-card-eyebrow { font-size:.66rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:#8a939c; }
    .km-pay-card-total { font-size:1.1rem; font-weight:800; color:var(--c-navy); line-height:1.2; }
    .km-pay-card-total small { font-size:.7rem; font-weight:600; color:#8a939c; margin-left:.15rem; }
    .km-pay-progress { height:8px; margin-top:.1rem; background:#eef0f2; border-radius:20px; overflow:hidden; margin-bottom:1rem; }
    .km-pay-progress-fill { height:100%; background:linear-gradient(90deg,#1e9e5a,#3fc47c); border-radius:20px; transition:width .6s ease; }

    .km-pay-stats { display:flex; align-items:center; gap:.8rem; }
    .km-pay-stat { flex:1; display:flex; align-items:center; gap:.7rem; min-width:0; }
    .km-pay-stat-icon {
        width:38px; height:38px; flex-shrink:0; border-radius:11px; display:flex; align-items:center; justify-content:center;
        font-size:1.2rem;
    }
    .km-pay-stat-icon.is-paid      { background:#e6f7ed; color:#1e9e5a; }
    .km-pay-stat-icon.is-remaining { background:#e6f4fb; color:var(--c-primary); }
    .km-pay-stat-text { display:flex; flex-direction:column; gap:.05rem; min-width:0; }
    .km-pay-stat-label { font-size:.78rem; color:#9aa3ac; font-weight:600; }
    .km-pay-stat-value { font-size:1.15rem; font-weight:800; color:var(--c-primary); line-height:1.2; }
    .km-pay-stat-value.is-paid { color:#1e9e5a; }
    .km-pay-stat-divider { width:1px; align-self:stretch; background:#f1f3f5; }

    .km-pay-card-link {
        display:flex; align-items:center; justify-content:center; gap:.35rem;
        color:var(--c-primary); font-weight:700; font-size:.9rem; text-decoration:none;
        margin-top:1rem; padding:.75rem 1rem; border-radius:12px; background:#eef6fb;
        transition:background-color .2s ease, color .2s ease;
    }
    .km-pay-card-link:hover { background:var(--c-primary); color:#fff; }
    .km-pay-card-link iconify-icon { font-size:1.05rem; }

    .km-home-link-sm { color:var(--c-primary); font-weight:700; font-size:.85rem; text-decoration:none; display:inline-flex; align-items:center; gap:.2rem; }
    .km-home-link-sm iconify-icon { font-size:1rem; }

    .km-home-news { display:flex; flex-direction:column; gap:.7rem; }
    .km-home-news-item {
        display:flex; align-items:center; gap:.85rem; background:#fff; border-radius:16px; border:1px solid var(--km-border);
        padding:.7rem .85rem; text-decoration:none; color:inherit; box-shadow:var(--km-shadow);
    }
    .km-home-news-item:active { background:#f7f9fa; }
    .km-home-news-thumb {
        width:56px; height:56px; flex-shrink:0; border-radius:11px; background:#eef0f2 center/cover no-repeat;
    }
    .km-home-news-text { flex:1; min-width:0; display:flex; flex-direction:column; gap:.1rem; }
    .km-home-news-date { font-size:.76rem; color:#9aa3ac; }
    .km-home-news-title { font-size:.95rem; font-weight:700; line-height:1.3; }

    /* Tam ekran görüntüleyici */
    .km-viewer { position:fixed; inset:0; z-index:2000; background:#05080d; display:flex; flex-direction:column; }
    .km-viewer[hidden] { display:none; }
    .km-viewer-bar {
        display:flex; align-items:center; justify-content:space-between; gap:.75rem;
        padding:calc(.7rem + env(safe-area-inset-top,0px)) .9rem .7rem; background:#0b1017; color:#fff;
    }
    .km-viewer-title { font-size:.95rem; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .km-viewer-actions { display:flex; gap:.4rem; flex-shrink:0; }
    .km-viewer-btn {
        background:rgba(255,255,255,.12); border:none; color:#fff; border-radius:8px;
        width:42px; height:42px; display:flex; align-items:center; justify-content:center; font-size:1.2rem;
    }
    .km-viewer-body { flex:1; position:relative; display:flex; align-items:center; justify-content:center; }
    .km-viewer-body iframe { width:100%; height:100%; border:none; }
    .km-viewer-body img { max-width:100%; max-height:100%; object-fit:contain; }

    @@media (max-width: 576px) {
        .km-prog-value { font-size:1.9rem; }
        .km-photo-card { flex-basis:210px; }
        .km-prog-summary-first { margin-top:-3.4rem; }
        .km-pay-stat-value { font-size:1.05rem; }
        .km-pay-stat-icon { width:34px; height:34px; font-size:1.05rem; }
    }

    /* Bilgisayardan girenlerde sütun daralıp ortalandığı için (bkz. _KatMalikiLayout),
       sabit yükseklikli görsel kutuları da orana göre biraz artırılır — yatay uzun ya
       da kare görseller aşırı ince bir şeride sıkışıp tuhaf kırpılmasın diye. */
    @@media (min-width: 768px) {
        .km-tour-card { height:280px; }
        .km-photo-img { height:190px; }
        .km-photo-card { flex-basis:260px; }
        .km-home-news-thumb { width:68px; height:68px; }
    }
</style>
}

@section Scripts {
<script>
(function () {
    var viewer  = document.getElementById('km-viewer');
    var frame   = document.getElementById('km-viewer-frame');
    var img     = document.getElementById('km-viewer-img');
    var title   = document.getElementById('km-viewer-title');
    var openBtn = document.getElementById('km-viewer-open');
    var closeBtn= document.getElementById('km-viewer-close');

    function open(opts) {
        title.textContent = opts.title || '';
        if (opts.url) {
            frame.src = opts.url;
            frame.hidden = false;
            img.hidden = true;
            openBtn.href = opts.url;
            openBtn.hidden = false;
        } else {
            img.src = opts.src;
            img.hidden = false;
            frame.hidden = true;
            openBtn.hidden = true;
        }
        viewer.hidden = false;
        document.body.style.overflow = 'hidden';
    }

    function close() {
        viewer.hidden = true;
        frame.src = 'about:blank';
        img.removeAttribute('src');
        document.body.style.overflow = '';
    }

    document.querySelectorAll('.km-tour-card').forEach(function (el) {
        el.addEventListener('click', function () {
            open({ url: el.dataset.tourUrl, title: el.dataset.tourTitle });
        });
    });

    document.querySelectorAll('.km-photo-card').forEach(function (el) {
        el.addEventListener('click', function () {
            open({ src: el.dataset.photoSrc, title: el.dataset.photoCaption || 'Saha fotoğrafı' });
        });
    });

    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !viewer.hidden) close();
    });
})();
</script>
}
