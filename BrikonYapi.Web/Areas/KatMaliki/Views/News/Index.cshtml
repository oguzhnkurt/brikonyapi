@model List<Announcement>
@{
    ViewData["Title"] = "Haberler & Projeler";
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();

    string TagClass(string? tag) => (tag ?? "").ToLower(tr) switch
    {
        "uyarı" or "uyari"           => "km-tag-warn",
        "önemli" or "onemli"         => "km-tag-danger",
        "haber" or "kentsel dönüşüm" => "km-tag-news",
        _                             => "km-tag-info"
    };
}

<div class="km-news-hero mb-3">
    <div class="km-news-hero-title">Haberler &amp; Projeler</div>
    <div class="km-news-hero-sub">Kentsel dönüşüm ve Brikon Yapı güncellemeleri</div>
</div>

<div class="km-tabs mb-3">
    <button type="button" class="km-tab active" data-tab="haberler">Haberler</button>
    <button type="button" class="km-tab" data-tab="projeler">Projeler</button>
</div>

<div class="km-tabpanel" data-panel="haberler">
    @if (!Model.Any())
    {
        <div class="card"><div class="card-body text-center text-muted py-5">Henüz haber paylaşılmamış.</div></div>
    }
    else
    {
        <div class="km-news-list mb-4">
            @foreach (var a in Model)
            {
                var summary = !string.IsNullOrWhiteSpace(a.Summary)
                    ? a.Summary
                    : (a.Body.Length > 140 ? a.Body.Substring(0, 140) + "…" : a.Body);

                <a class="km-news-card" href="/KatMaliki/News/Detail/@a.Id">
                    @if (!string.IsNullOrEmpty(a.CoverImagePath))
                    {
                        <span class="km-news-cover" style="background-image:url('@a.CoverImagePath')"></span>
                    }
                    <span class="km-news-body">
                        <span class="km-news-meta">
                            @if (!string.IsNullOrEmpty(a.Tag))
                            {
                                <span class="km-tag @TagClass(a.Tag)">@a.Tag</span>
                            }
                            <span class="km-news-date">@a.CreatedAt.ToString("dd MMM yyyy", tr)</span>
                        </span>
                        <span class="km-news-title">@a.Title</span>
                        <span class="km-news-summary">@summary</span>
                        <span class="km-news-source">@(string.IsNullOrWhiteSpace(a.Source) ? "Brikon Yapı" : a.Source)</span>
                    </span>
                </a>
            }
        </div>
    }
</div>

<div class="km-tabpanel" data-panel="projeler" hidden>
    @if (!projects.Any())
    {
        <div class="card"><div class="card-body text-center text-muted py-5">Gösterilecek proje bulunamadı.</div></div>
    }
    else
    {
        <div class="km-proj-grid mb-4">
            @foreach (var p in projects)
            {
                <div class="km-proj-card">
                    <div class="km-proj-img" style="@(!string.IsNullOrEmpty(p.MainImagePath) ? $"background-image:url('{p.MainImagePath}')" : "")">
                        @if (!string.IsNullOrEmpty(p.CardTag))
                        {
                            <span class="km-proj-tag">@p.CardTag</span>
                        }
                    </div>
                    <div class="km-proj-info">
                        <div class="km-proj-name">@p.Name</div>
                        @if (!string.IsNullOrEmpty(p.District) || !string.IsNullOrEmpty(p.City))
                        {
                            <div class="km-proj-loc">@string.Join(" • ", new[] { p.District, p.City }.Where(x => !string.IsNullOrEmpty(x)))</div>
                        }
                        @if (p.OverallProgressPercentage > 0)
                        {
                            <div class="km-proj-prog">
                                <div class="km-proj-prog-bar"><span style="width:@(p.OverallProgressPercentage)%"></span></div>
                                <span class="km-proj-prog-pct">%@p.OverallProgressPercentage</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
<style>
    .km-news-hero-title { font-size:1.5rem; font-weight:700; }
    .km-news-hero-sub { color:#6c7580; font-size:.95rem; margin-top:.2rem; }

    .km-tabs { display:flex; gap:.5rem; }
    .km-tab {
        border:1px solid #dfe3e7; background:#fff; color:#4a5158; border-radius:20px;
        padding:.55rem 1.2rem; font-size:.95rem; font-weight:600; min-height:44px;
    }
    .km-tab.active { background:var(--c-primary); border-color:var(--c-primary); color:#fff; }

    .km-news-list { display:flex; flex-direction:column; gap:.9rem; }
    .km-news-card {
        display:block; background:#fff; border-radius:16px; overflow:hidden; text-decoration:none;
        color:inherit; box-shadow:0 2px 10px rgba(0,0,0,.06);
    }
    .km-news-card:active { background:#f7f9fa; }
    .km-news-cover { display:block; height:170px; background:#0d1520 center/cover no-repeat; }
    .km-news-body { display:block; padding:.9rem 1.05rem 1.05rem; }
    .km-news-meta { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; margin-bottom:.4rem; }
    .km-news-date { font-size:.78rem; color:#9aa3ac; }
    .km-news-title { display:block; font-size:1.05rem; font-weight:700; line-height:1.35; }
    .km-news-summary { display:block; font-size:.9rem; color:#6c7580; line-height:1.5; margin-top:.25rem; }
    .km-news-source { display:block; font-size:.78rem; color:#9aa3ac; margin-top:.5rem; }

    .km-tag { font-size:.7rem; font-weight:700; padding:.25rem .6rem; border-radius:20px; text-transform:uppercase; letter-spacing:.02em; }
    .km-tag-info   { background:#e6f4fb; color:#0082B4; }
    .km-tag-news   { background:#eaf0fd; color:#2f5bd7; }
    .km-tag-warn   { background:#fef6e0; color:#b8860b; }
    .km-tag-danger { background:#fde8e8; color:#c0392b; }

    .km-proj-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:.9rem; }
    .km-proj-card { background:#fff; border-radius:14px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.05); }
    .km-proj-img { height:120px; background:linear-gradient(160deg,#1a2540,#0d1520) center/cover no-repeat; position:relative; }
    .km-proj-tag {
        position:absolute; top:.5rem; left:.5rem; background:rgba(0,0,0,.55); color:#fff;
        font-size:.66rem; font-weight:600; padding:.22rem .5rem; border-radius:20px;
    }
    .km-proj-info { padding:.7rem .8rem .85rem; }
    .km-proj-name { font-weight:700; font-size:.9rem; line-height:1.3; }
    .km-proj-loc { font-size:.76rem; color:#9aa3ac; margin-top:.2rem; }
    .km-proj-prog { display:flex; align-items:center; gap:.4rem; margin-top:.5rem; }
    .km-proj-prog-bar { flex:1; height:5px; background:#eef0f2; border-radius:5px; overflow:hidden; }
    .km-proj-prog-bar span { display:block; height:100%; background:var(--c-primary); border-radius:5px; }
    .km-proj-prog-pct { font-size:.72rem; font-weight:700; color:var(--c-primary); }

    @@media (max-width: 576px) {
        .km-news-hero-title { font-size:1.3rem; }
        .km-news-cover { height:150px; }
    }

    /* Bilgisayardan girenlerde sütun daralıp ortalandığı için (bkz. _KatMalikiLayout),
       kapak görselleri de orana göre biraz artırılır. */
    @@media (min-width: 768px) {
        .km-news-cover { height:220px; }
        .km-proj-img { height:150px; }
    }
</style>
}

@section Scripts {
<script>
(function () {
    var tabs = document.querySelectorAll('.km-tab');
    var panels = document.querySelectorAll('.km-tabpanel');
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            tabs.forEach(function (t) { t.classList.remove('active'); });
            tab.classList.add('active');
            panels.forEach(function (p) { p.hidden = p.dataset.panel !== tab.dataset.tab; });
        });
    });
})();
</script>
}
