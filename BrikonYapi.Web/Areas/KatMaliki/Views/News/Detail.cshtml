@model Announcement
@{
    ViewData["Title"] = Model.Title;
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

<a href="/KatMaliki/News" class="km-art-back mb-3">
    <iconify-icon icon="iconamoon:arrow-left-2"></iconify-icon> Haberler
</a>

<article class="km-art">
    @if (!string.IsNullOrEmpty(Model.CoverImagePath))
    {
        <div class="km-art-cover" style="background-image:url('@Model.CoverImagePath')"></div>
    }
    <div class="km-art-body">
        <div class="km-art-meta">
            @if (!string.IsNullOrEmpty(Model.Tag))
            {
                <span class="km-tag km-tag-info">@Model.Tag</span>
            }
            <span class="km-art-date">@Model.CreatedAt.ToString("dd MMMM yyyy", tr)</span>
        </div>
        <h1 class="km-art-title">@Model.Title</h1>
        <div class="km-art-source">@(string.IsNullOrWhiteSpace(Model.Source) ? "Brikon Yapı" : Model.Source)</div>
        <div class="km-art-text">@Model.Body</div>
    </div>
</article>

@section Styles {
<style>
    .km-art-back {
        display:inline-flex; align-items:center; gap:.2rem; color:var(--c-primary);
        text-decoration:none; font-weight:600; font-size:.95rem; min-height:40px;
    }
    .km-art { background:#fff; border-radius:18px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,.07); }
    .km-art-cover { height:220px; background:#0d1520 center/cover no-repeat; }
    .km-art-body { padding:1.2rem 1.35rem 1.6rem; }
    .km-art-meta { display:flex; align-items:center; gap:.6rem; flex-wrap:wrap; margin-bottom:.6rem; }
    .km-art-date { font-size:.82rem; color:#9aa3ac; }
    .km-art-title { font-size:1.35rem; font-weight:800; line-height:1.3; margin:0 0 .4rem; }
    .km-art-source { font-size:.85rem; color:#9aa3ac; margin-bottom:1rem; }
    .km-art-text { font-size:1rem; line-height:1.7; color:#3d444b; white-space:pre-line; }

    .km-tag { font-size:.7rem; font-weight:700; padding:.25rem .6rem; border-radius:20px; text-transform:uppercase; letter-spacing:.02em; }
    .km-tag-info { background:#e6f4fb; color:#0082B4; }

    @@media (max-width: 576px) {
        .km-art-cover { height:180px; }
        .km-art-title { font-size:1.2rem; }
    }

    /* Bilgisayardan girenlerde sütun daralıp ortalandığı için (bkz. _KatMalikiLayout),
       kapak görseli de orana göre biraz artırılır. */
    @@media (min-width: 768px) {
        .km-art-cover { height:300px; }
    }
</style>
}
