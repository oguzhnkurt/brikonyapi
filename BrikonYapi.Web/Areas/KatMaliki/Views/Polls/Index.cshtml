@model List<Poll>
@{
    ViewData["Title"] = "Oylama";
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var ownerId = (int)(ViewBag.OwnerId ?? 0);
    var now = DateTime.Now;
}

@Html.AntiForgeryToken()

<div class="km-poll-hero mb-3">
    <div class="km-poll-hero-title">Oylama</div>
    <div class="km-poll-hero-sub">Malik oylamaları ve malzeme seçim süreçleri</div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            Şu anda açık bir oylama bulunmuyor.
        </div>
    </div>
}

<div class="km-poll-list mb-4">
@foreach (var poll in Model)
{
    var totalVotes = poll.Votes.Count;
    var myVote     = poll.Votes.FirstOrDefault(v => v.OwnerId == ownerId);
    var hasVoted   = myVote != null;
    // Üç ayrı durum: henüz başlamadı / açık / kapandı.
    // "Başlamadı" ile "Kapandı" ayrımı önemli — başlangıcı ileri tarihli bir oylama
    // eskiden yanlışlıkla "Kapandı" olarak gösteriliyordu.
    var notStarted = poll.Status == PollStatus.Active
                     && poll.StartsAt != null && poll.StartsAt > now;
    var isOpen     = poll.Status == PollStatus.Active
                     && (poll.StartsAt == null || poll.StartsAt <= now)
                     && (poll.EndsAt == null || poll.EndsAt >= now);
    var statusText = isOpen ? "Aktif" : notStarted ? "Başlamadı" : "Kapandı";
    var statusCss  = isOpen ? "is-open" : notStarted ? "is-soon" : "is-closed";
    var startsText = poll.StartsAt?.ToString("dd MMMM yyyy HH:mm", tr) ?? "";
    var startsShort = poll.StartsAt?.ToString("dd MMM yyyy HH:mm", tr) ?? "";

    <div class="km-poll-card" data-poll-id="@poll.Id" data-open="@(isOpen ? "1" : "0")">
        <div class="km-poll-head">
            @if (!string.IsNullOrEmpty(poll.Category))
            {
                <span class="km-poll-cat">@poll.Category</span>
            }
            <span class="km-poll-status @statusCss">@statusText</span>
        </div>

        <div class="km-poll-title">@poll.Title</div>
        @if (!string.IsNullOrWhiteSpace(poll.Description))
        {
            <div class="km-poll-desc">@poll.Description</div>
        }

        <div class="km-poll-meta">
            <span><iconify-icon icon="iconamoon:profile-circle-duotone"></iconify-icon> @(poll.ProjectId == null ? "Tüm Malikler" : "Proje Malikleri")</span>
            <span class="km-poll-total-votes"><iconify-icon icon="iconamoon:check-square-duotone"></iconify-icon> <span class="km-poll-total-num">@totalVotes</span> oy</span>
            @if (notStarted && poll.StartsAt.HasValue)
            {
                <span><iconify-icon icon="iconamoon:clock-duotone"></iconify-icon> Başlangıç: @startsShort</span>
            }
            else if (poll.EndsAt.HasValue && isOpen)
            {
                <span><iconify-icon icon="iconamoon:clock-duotone"></iconify-icon> Son: @poll.EndsAt.Value.ToString("dd MMM yyyy", tr)</span>
            }
        </div>

        @if (poll.IsConcept)
        {
            var cRooms = (poll.ConceptRooms ?? "Salon,Mutfak,Banyo,Dış Cephe")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            var cOpts = poll.Options.OrderBy(o => o.OrderIndex).ToList();
            // Görseli olan odalar (hiçbir konseptte görseli olmayan oda sekmesi gösterilmez)
            var usedRooms = cRooms.Where(r => cOpts.Any(o => o.Images.Any(i => i.Room == r))).ToList();
            var startOpt = cOpts.FirstOrDefault(o => o.Id == myVote?.PollOptionId) ?? cOpts.FirstOrDefault();
            var cData = new
            {
                rooms = usedRooms,
                same = poll.SameCameraAngle,
                options = cOpts.Select(o => new
                {
                    id = o.Id,
                    name = o.Text,
                    images = o.Images.ToDictionary(i => i.Room, i => i.ImagePath)
                })
            };

            <div class="km-cv" data-same="@(poll.SameCameraAngle ? "1" : "0")">
                <script type="application/json" class="km-cv-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(cData))</script>

                <div class="km-cv-tabs" role="tablist">
                    @foreach (var o in cOpts)
                    {
                        var cnt = poll.Votes.Count(v => v.PollOptionId == o.Id);
                        var cpct = totalVotes > 0 ? (int)Math.Round(cnt * 100.0 / totalVotes) : 0;
                        var cMine = myVote?.PollOptionId == o.Id;
                        <button type="button" class="km-cv-tab km-poll-opt @(o.Id == startOpt?.Id ? "is-active" : "") @(cMine ? "is-mine" : "")"
                                data-option-id="@o.Id" role="tab">
                            <span class="km-cv-tab-name">@o.Text</span>
                            <span class="km-cv-tab-meta">
                                <iconify-icon icon="iconamoon:check-bold" class="km-cv-tab-check"></iconify-icon>
                                <span class="km-poll-opt-pct">%@cpct</span>
                            </span>
                            <span class="km-poll-opt-bar"><span style="width:@(cpct)%"></span></span>
                        </button>
                    }
                </div>

                @if (usedRooms.Count > 1)
                {
                    <div class="km-cv-rooms">
                        @for (var ri = 0; ri < usedRooms.Count; ri++)
                        {
                            <button type="button" class="km-cv-room @(ri == 0 ? "is-active" : "")" data-room="@usedRooms[ri]">@usedRooms[ri]</button>
                        }
                    </div>
                }

                <div class="km-cv-stage">
                    @if (usedRooms.Any())
                    {
                        <img class="km-cv-img is-front" alt="" />
                        <img class="km-cv-img" alt="" />
                        <div class="km-cv-cmp" hidden>
                            <img class="km-cv-cmp-img" alt="" />
                            <div class="km-cv-cmp-line"><span class="km-cv-cmp-knob"><iconify-icon icon="mdi:arrow-left-right"></iconify-icon></span></div>
                            <span class="km-cv-cmp-lbl is-l"></span>
                            <span class="km-cv-cmp-lbl is-r"></span>
                        </div>
                        <span class="km-cv-badge"></span>
                        <div class="km-cv-tools">
                            @if (poll.SameCameraAngle && cOpts.Count > 1)
                            {
                                <button type="button" class="km-cv-tool km-cv-cmp-btn"><iconify-icon icon="mdi:compare-horizontal"></iconify-icon> Karşılaştır</button>
                            }
                            <button type="button" class="km-cv-tool km-cv-full" aria-label="Tam ekran"><iconify-icon icon="mdi:fullscreen"></iconify-icon></button>
                        </div>
                    }
                    else
                    {
                        <div class="km-cv-empty"><iconify-icon icon="mdi:image-outline"></iconify-icon> Render görselleri yakında eklenecek.</div>
                    }
                </div>

                @foreach (var o in cOpts)
                {
                    <div class="km-cv-info" data-for="@o.Id" @(o.Id == startOpt?.Id ? "" : "hidden")>
                        @if (!string.IsNullOrWhiteSpace(o.Description))
                        {
                            <div class="km-cv-desc">@o.Description</div>
                        }
                        @if (o.Materials.Any())
                        {
                            <div class="km-cv-mats">
                                @foreach (var m in o.Materials.OrderBy(m => m.OrderIndex))
                                {
                                    <div class="km-cv-mat">
                                        <span class="km-cv-mat-sw" style="@(m.SwatchPath != null ? $"background-image:url('{m.SwatchPath}')" : m.ColorHex != null ? $"background:{m.ColorHex}" : "")"></span>
                                        <span class="km-cv-mat-tx">
                                            <span class="km-cv-mat-cat">@m.Category</span>
                                            <span class="km-cv-mat-name">@m.Name</span>
                                            @if (!string.IsNullOrEmpty(m.Code))
                                            {
                                                <span class="km-cv-mat-code">@m.Code</span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (isOpen)
                {
                    <button type="button" class="km-cv-vote btn btn-primary w-100" data-option-id="@startOpt?.Id">
                        <iconify-icon icon="iconamoon:check-circle-1-duotone" class="me-1"></iconify-icon>
                        <span class="km-cv-vote-tx"></span>
                    </button>
                }
            </div>
        }
        else
        {
        if (isOpen)
        {
            <div class="km-poll-hint">Oy vermek için bir seçeneğe dokunun — değiştirmek istersen başka birine dokunman yeterli.</div>
        }

        <div class="km-poll-options @(isOpen ? "is-interactive" : "")">
            @foreach (var o in poll.Options.OrderBy(o => o.OrderIndex))
            {
                var count = poll.Votes.Count(v => v.PollOptionId == o.Id);
                var pct = totalVotes > 0 ? (int)Math.Round(count * 100.0 / totalVotes) : 0;
                var isMine = myVote?.PollOptionId == o.Id;

                <div class="km-poll-opt @(isMine ? "is-mine" : "")" data-option-id="@o.Id"
                     role="@(isOpen ? "button" : null)" tabindex="@(isOpen ? "0" : null)">
                    @if (!string.IsNullOrEmpty(o.ImagePath))
                    {
                        <span class="km-poll-opt-img" style="background-image:url('@o.ImagePath')">
                            <span class="km-poll-opt-check"><iconify-icon icon="iconamoon:check-bold"></iconify-icon></span>
                        </span>
                    }
                    <span class="km-poll-opt-body">
                        <span class="km-poll-opt-top">
                            <span class="km-poll-opt-text">
                                @o.Text
                                <span class="km-poll-mine">· sizin oyunuz</span>
                            </span>
                            <span class="km-poll-opt-pct">%@pct</span>
                        </span>
                        <span class="km-poll-opt-bar"><span style="width:@(pct)%"></span></span>
                    </span>
                </div>
            }
        </div>
        }

        <div class="km-poll-foot @(hasVoted ? "is-voted" : "")">
            @if (isOpen)
            {
                <iconify-icon icon="iconamoon:check-circle-1-duotone"></iconify-icon>
                <span class="km-poll-foot-text">@(hasVoted ? "Oyunuz kaydedildi." : "Henüz oy kullanmadınız.")</span>
            }
            else if (notStarted)
            {
                <iconify-icon icon="iconamoon:clock-duotone"></iconify-icon>
                <span class="km-poll-foot-text">Oylama @startsText tarihinde başlayacak.</span>
            }
            else
            {
                <iconify-icon icon="iconamoon:lock-duotone"></iconify-icon>
                <span class="km-poll-foot-text">@(hasVoted ? "Oy verdiniz · oylama kapandı" : "Oylama kapandı")</span>
            }
        </div>
    </div>
}
</div>

@section Styles {
<style>
    .km-poll-hero-title { font-size:1.5rem; font-weight:700; }
    .km-poll-hero-sub { color:#6c7580; font-size:.95rem; margin-top:.2rem; }

    .km-poll-list { display:flex; flex-direction:column; gap:.9rem; }
    .km-poll-card { background:#fff; border-radius:16px; padding:1.1rem 1.2rem 1.2rem; box-shadow:0 2px 10px rgba(0,0,0,.06); }

    .km-poll-head { display:flex; align-items:center; gap:.45rem; flex-wrap:wrap; margin-bottom:.5rem; }
    .km-poll-cat { background:#eef0f2; color:#6c7580; font-size:.7rem; font-weight:700; padding:.25rem .6rem; border-radius:20px; }
    .km-poll-status { font-size:.7rem; font-weight:700; padding:.25rem .6rem; border-radius:20px; }
    .km-poll-status.is-open   { background:#e6f7ed; color:#1e9e5a; }
    .km-poll-status.is-closed { background:#eef0f2; color:#8a939c; }
    .km-poll-status.is-soon   { background:#fef6e0; color:#b8860b; }

    .km-poll-title { font-size:1.15rem; font-weight:800; line-height:1.3; }
    .km-poll-desc { font-size:.92rem; color:#6c7580; line-height:1.5; margin-top:.3rem; }
    .km-poll-meta { display:flex; gap:1rem; flex-wrap:wrap; font-size:.8rem; color:#9aa3ac; margin:.6rem 0 .5rem; }
    .km-poll-meta span { display:inline-flex; align-items:center; gap:.25rem; }
    .km-poll-hint { font-size:.82rem; color:#9aa3ac; margin-bottom:.7rem; }

    /* Seçenekler: hem sonuç hem oy verme aynı görünümde — açık oylamalarda tıklanabilir */
    .km-poll-options { display:flex; flex-direction:column; gap:.7rem; }
    .km-poll-opt { display:flex; gap:.7rem; align-items:center; border-radius:12px; padding:.3rem; transition:background .15s; }
    .km-poll-options.is-interactive .km-poll-opt { cursor:pointer; }
    .km-poll-options.is-interactive .km-poll-opt:active { background:#f5f6f7; }
    .km-poll-opt-img {
        width:52px; height:52px; flex-shrink:0; border-radius:10px; background:#eef0f2 center/cover no-repeat;
        position:relative; box-shadow:inset 0 0 0 2px transparent; transition:box-shadow .15s;
    }
    .km-poll-opt.is-mine .km-poll-opt-img { box-shadow:inset 0 0 0 3px var(--c-primary); }
    .km-poll-opt-check {
        position:absolute; top:-6px; right:-6px; width:22px; height:22px; border-radius:50%;
        background:var(--c-primary); color:#fff; display:flex; align-items:center; justify-content:center;
        font-size:.7rem; box-shadow:0 2px 6px rgba(0,0,0,.25); opacity:0; transform:scale(.6); transition:all .18s;
    }
    .km-poll-opt.is-mine .km-poll-opt-check { opacity:1; transform:scale(1); }
    .km-poll-opt-body { flex:1; min-width:0; }
    .km-poll-opt-top { display:flex; justify-content:space-between; align-items:baseline; gap:.6rem; margin-bottom:.3rem; }
    .km-poll-opt-text { font-size:.94rem; color:#4a5158; }
    .km-poll-opt.is-mine .km-poll-opt-text { color:var(--c-primary); font-weight:700; }
    .km-poll-mine { font-size:.8rem; font-weight:600; display:none; }
    .km-poll-opt.is-mine .km-poll-mine { display:inline; }
    .km-poll-opt-pct { font-size:.85rem; font-weight:700; color:#8a939c; white-space:nowrap; }
    .km-poll-opt.is-mine .km-poll-opt-pct { color:var(--c-primary); }
    .km-poll-opt-bar { display:block; height:7px; background:#eef0f2; border-radius:7px; overflow:hidden; }
    .km-poll-opt-bar span { display:block; height:100%; background:#c9d2d9; border-radius:7px; transition:width .5s ease; }
    .km-poll-opt.is-mine .km-poll-opt-bar span { background:linear-gradient(90deg,var(--c-primary),var(--c-secondary)); }

    .km-poll-foot { display:flex; align-items:center; gap:.35rem; margin-top:1rem; padding-top:.8rem;
                    border-top:1px solid #f1f3f5; font-size:.9rem; font-weight:600; color:#8a939c; transition:color .15s; }
    .km-poll-foot.is-voted { color:#1e9e5a; }
    .km-poll-foot iconify-icon { font-size:1.15rem; }
    .km-poll-foot.km-poll-flash { color:#1e9e5a; }


    /* ── Konsept (render) oylaması ─────────────────────────────── */
    .km-cv { margin-top:.6rem; }
    .km-cv-tabs { display:grid; grid-template-columns:repeat(auto-fit, minmax(0, 1fr)); gap:.45rem; margin-bottom:.7rem; }
    .km-cv-tab { position:relative; display:flex; flex-direction:column; align-items:flex-start; gap:.3rem; text-align:left;
                 border:1.5px solid var(--km-border, #e6ebf0); background:#fff; border-radius:12px; padding:.55rem .65rem .6rem; min-width:0;
                 transition:border-color .15s, background-color .15s, box-shadow .15s; }
    .km-cv-tab.is-active { border-color:var(--c-navy, #0b1b2e); background:#f4f7fa; box-shadow:0 0 0 3px rgba(11,27,46,.08); }
    .km-cv-tab-name { font-size:.88rem; font-weight:800; color:var(--c-navy, #0b1b2e); line-height:1.2; max-width:100%;
                      overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .km-cv-tab-meta { display:flex; align-items:center; gap:.25rem; }
    .km-cv-tab .km-poll-opt-pct { font-size:.72rem; }
    .km-cv-tab-check { display:none; color:#fff; background:#1e9e5a; border-radius:50%; font-size:.62rem; padding:.18rem; }
    .km-cv-tab.is-mine .km-cv-tab-check { display:inline-block; }
    .km-cv-tab.is-mine { border-color:#1e9e5a; }
    .km-cv-tab .km-poll-opt-bar { width:100%; height:4px; }
    .km-cv-tab.is-mine .km-poll-opt-bar span { background:#1e9e5a; }

    .km-cv-rooms { display:flex; gap:.35rem; overflow-x:auto; padding-bottom:.15rem; margin-bottom:.6rem; }
    .km-cv-rooms::-webkit-scrollbar { display:none; }
    .km-cv-room { border:none; background:#eef2f6; color:#4b5866; font-size:.8rem; font-weight:700; padding:.4rem .8rem;
                  border-radius:999px; white-space:nowrap; min-height:34px; }
    .km-cv-room.is-active { background:var(--c-navy, #0b1b2e); color:#fff; }

    .km-cv-stage { position:relative; aspect-ratio:16/10; border-radius:14px; overflow:hidden; background:#0d1520; touch-action:pan-y; }
    .km-cv-img { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; opacity:0; transition:opacity .45s ease; }
    .km-cv-img.is-front { opacity:1; }
    .km-cv-stage:fullscreen { border-radius:0; aspect-ratio:auto; }
    .km-cv-badge { position:absolute; left:.7rem; top:.7rem; z-index:3; background:rgba(11,27,46,.72); color:#fff; font-size:.74rem; font-weight:700;
                   padding:.3rem .65rem; border-radius:999px; -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); }
    .km-cv-tools { position:absolute; right:.6rem; bottom:.6rem; z-index:4; display:flex; gap:.35rem; }
    .km-cv-tool { border:none; background:rgba(255,255,255,.92); color:var(--c-navy, #0b1b2e); font-size:.78rem; font-weight:700;
                  border-radius:999px; padding:.4rem .7rem; display:inline-flex; align-items:center; gap:.25rem; box-shadow:0 4px 12px rgba(0,0,0,.2); min-height:34px; }
    .km-cv-tool.is-on { background:var(--c-primary); color:#fff; }
    .km-cv-empty { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; gap:.4rem; color:#9aa3ac; font-size:.88rem; }

    /* Karşılaştırma sürgüsü: soldaki konsept üstte, kesme çizgisine kadar görünür */
    .km-cv-cmp { position:absolute; inset:0; z-index:2; }
    .km-cv-cmp-img { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; clip-path:inset(0 calc(100% - var(--cut, 50%)) 0 0); }
    .km-cv-cmp-line { position:absolute; top:0; bottom:0; left:var(--cut, 50%); width:2px; margin-left:-1px; background:#fff; box-shadow:0 0 8px rgba(0,0,0,.4); cursor:ew-resize; }
    .km-cv-cmp-knob { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:38px; height:38px; border-radius:50%;
                      background:#fff; color:var(--c-navy, #0b1b2e); display:flex; align-items:center; justify-content:center; font-size:1.1rem; box-shadow:0 4px 12px rgba(0,0,0,.3); }
    .km-cv-cmp-lbl { position:absolute; bottom:.7rem; font-size:.72rem; font-weight:800; color:#fff; background:rgba(11,27,46,.72); padding:.25rem .55rem; border-radius:999px; }
    .km-cv-cmp-lbl.is-l { left:.7rem; } .km-cv-cmp-lbl.is-r { right:.7rem; bottom:3.3rem; }
    .km-cv.is-cmp .km-cv-badge { display:none; }

    .km-cv-info { margin-top:.8rem; }
    .km-cv-desc { font-size:.9rem; color:#4b5866; line-height:1.5; margin-bottom:.6rem; }
    .km-cv-mats { display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:.45rem; }
    .km-cv-mat { display:flex; align-items:center; gap:.55rem; padding:.5rem .6rem; border:1px solid var(--km-border, #e6ebf0); border-radius:11px; background:#fafbfc; min-width:0; }
    .km-cv-mat-sw { width:34px; height:34px; border-radius:8px; flex-shrink:0; background:#e9edf1 center/cover no-repeat; border:1px solid rgba(0,0,0,.06); }
    .km-cv-mat-tx { display:flex; flex-direction:column; min-width:0; }
    .km-cv-mat-cat { font-size:.62rem; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:#8a939c; }
    .km-cv-mat-name { font-size:.84rem; font-weight:700; color:var(--c-navy, #0b1b2e); line-height:1.25; }
    .km-cv-mat-code { font-size:.7rem; color:#9aa3ac; }
    .km-cv-vote { margin-top:.9rem; min-height:50px; border-radius:12px; font-weight:700; }
    .km-cv-vote.is-done { background:#1e9e5a; border-color:#1e9e5a; }

    @@media (max-width: 576px) {
        .km-poll-hero-title { font-size:1.3rem; }
        .km-poll-title { font-size:1.05rem; }
    }
</style>
}

@section Scripts {
<script>
(function () {
    var aft = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    document.querySelectorAll('.km-poll-card[data-open="1"] .km-poll-options.is-interactive .km-poll-opt').forEach(function (optEl) {
        optEl.addEventListener('click', function () { castVote(optEl); });
        optEl.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); castVote(optEl); }
        });
    });


    // ── Konsept görüntüleyici ─────────────────────────────────────
    document.querySelectorAll('.km-cv').forEach(function (cv) {
        var dataEl = cv.querySelector('.km-cv-data');
        if (!dataEl) return;
        var data = JSON.parse(dataEl.textContent);
        var card = cv.closest('.km-poll-card');
        var tabs = Array.prototype.slice.call(cv.querySelectorAll('.km-cv-tab'));
        var roomBtns = Array.prototype.slice.call(cv.querySelectorAll('.km-cv-room'));
        var imgs = cv.querySelectorAll('.km-cv-img');
        var badge = cv.querySelector('.km-cv-badge');
        var voteBtn = cv.querySelector('.km-cv-vote');
        var cmpBtn = cv.querySelector('.km-cv-cmp-btn');
        var cmp = cv.querySelector('.km-cv-cmp');
        var stage = cv.querySelector('.km-cv-stage');
        var active = tabs.find(function (t) { return t.classList.contains('is-active'); }) || tabs[0];
        var room = data.rooms[0];
        var front = 0;

        function opt(id) { return data.options.find(function (o) { return o.id === id; }); }
        function imgFor(o, r) { return o && o.images ? (o.images[r] || null) : null; }
        function activeId() { return parseInt(active.dataset.optionId, 10); }
        function mineId() { var m = tabs.find(function (t) { return t.classList.contains('is-mine'); }); return m ? parseInt(m.dataset.optionId, 10) : null; }

        // Önceden yükle: geçişler anında olsun
        data.options.forEach(function (o) { Object.keys(o.images || {}).forEach(function (k) { var i = new Image(); i.src = o.images[k]; }); });

        function show() {
            var o = opt(activeId());
            var src = imgFor(o, room);
            if (imgs.length === 2) {
                var next = imgs[1 - front];
                if (src) {
                    next.onload = function () { next.classList.add('is-front'); imgs[front].classList.remove('is-front'); front = 1 - front; };
                    if (next.getAttribute('src') === src) next.onload();
                    else next.src = src;
                } else {
                    imgs[front].classList.remove('is-front');
                }
            }
            if (badge) badge.textContent = (o ? o.name : '') + (room ? ' · ' + room : '') + (src ? '' : ' · görsel yok');
            cv.querySelectorAll('.km-cv-info').forEach(function (inf) { inf.hidden = parseInt(inf.dataset.for, 10) !== activeId(); });
            updateVoteBtn();
            if (cv.classList.contains('is-cmp')) updateCmp();
        }

        function updateVoteBtn() {
            if (!voteBtn) return;
            var o = opt(activeId());
            var done = mineId() === activeId();
            voteBtn.dataset.optionId = activeId();
            voteBtn.classList.toggle('is-done', done);
            voteBtn.querySelector('.km-cv-vote-tx').textContent = done ? (o.name + ' seçiminiz kaydedildi') : (o.name + ' konseptini seçiyorum');
        }

        tabs.forEach(function (t) {
            t.addEventListener('click', function () {
                active = t;
                tabs.forEach(function (x) { x.classList.toggle('is-active', x === t); });
                show();
            });
        });
        roomBtns.forEach(function (b) {
            b.addEventListener('click', function () {
                room = b.dataset.room;
                roomBtns.forEach(function (x) { x.classList.toggle('is-active', x === b); });
                show();
            });
        });

        // Parmakla kaydırarak konsept değiştirme (karşılaştırma kapalıyken)
        if (stage) {
            var sx = null;
            stage.addEventListener('touchstart', function (e) { if (!cv.classList.contains('is-cmp')) sx = e.touches[0].clientX; }, { passive: true });
            stage.addEventListener('touchend', function (e) {
                if (sx === null) return;
                var dx = e.changedTouches[0].clientX - sx; sx = null;
                if (Math.abs(dx) < 50) return;
                var idx = tabs.indexOf(active) + (dx < 0 ? 1 : -1);
                if (idx >= 0 && idx < tabs.length) tabs[idx].click();
            });
        }

        // Karşılaştırma: sol = bir önceki/sonraki konsept, sağ = seçili konsept
        var cut = 50;
        function cmpOther() {
            var i = tabs.indexOf(active);
            return opt(parseInt(tabs[i > 0 ? i - 1 : 1].dataset.optionId, 10));
        }
        function updateCmp() {
            var other = cmpOther(), cur = opt(activeId());
            cmp.querySelector('.km-cv-cmp-img').src = imgFor(other, room) || '';
            cmp.querySelector('.is-l').textContent = other.name;
            cmp.querySelector('.is-r').textContent = cur.name;
            cmp.style.setProperty('--cut', cut + '%');
        }
        if (cmpBtn && cmp) {
            cmpBtn.addEventListener('click', function () {
                var on = !cv.classList.contains('is-cmp');
                cv.classList.toggle('is-cmp', on);
                cmpBtn.classList.toggle('is-on', on);
                cmp.hidden = !on;
                if (on) { cut = 50; updateCmp(); }
            });
            function setCut(clientX) {
                var r = stage.getBoundingClientRect();
                cut = Math.max(0, Math.min(100, (clientX - r.left) / r.width * 100));
                cmp.style.setProperty('--cut', cut + '%');
            }
            var dragging = false;
            cmp.addEventListener('pointerdown', function (e) { dragging = true; cmp.setPointerCapture(e.pointerId); setCut(e.clientX); });
            cmp.addEventListener('pointermove', function (e) { if (dragging) setCut(e.clientX); });
            cmp.addEventListener('pointerup', function () { dragging = false; });
            cmp.style.touchAction = 'none';
        }

        var fullBtn = cv.querySelector('.km-cv-full');
        if (fullBtn && stage) {
            fullBtn.addEventListener('click', function () {
                if (document.fullscreenElement) document.exitFullscreen();
                else if (stage.requestFullscreen) stage.requestFullscreen();
                else if (stage.webkitRequestFullscreen) stage.webkitRequestFullscreen();
            });
        }

        if (voteBtn) {
            voteBtn.addEventListener('click', function () {
                if (mineId() === activeId()) return;
                castVote(active);
            });
        }

        // Oy sonucu geldiğinde buton metnini güncelle
        cv.addEventListener('km-voted', updateVoteBtn);
        show();
    });
    function castVote(optEl) {
        var card = optEl.closest('.km-poll-card');
        if (!card || card.dataset.busy === '1') return;

        var pollId = card.dataset.pollId;
        var optionId = optEl.dataset.optionId;

        card.dataset.busy = '1';
        card.style.opacity = '.85';

        var body = new URLSearchParams({ pollId: pollId, optionId: optionId, __RequestVerificationToken: aft });

        fetch('/KatMaliki/Polls/Vote', { method: 'POST', body: body, headers: { 'Content-Type': 'application/x-www-form-urlencoded' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                card.style.opacity = '';
                card.dataset.busy = '';
                if (!data.success) { showFoot(card, data.message || 'Oy kaydedilemedi.', false); return; }
                applyVoteResult(card, data);
            })
            .catch(function () {
                card.style.opacity = '';
                card.dataset.busy = '';
                showFoot(card, 'Bağlantı hatası, lütfen tekrar deneyin.', false);
            });
    }

    function applyVoteResult(card, data) {
        card.querySelectorAll('.km-poll-opt').forEach(function (optEl) {
            var optId = parseInt(optEl.dataset.optionId, 10);
            var isMine = optId === data.myOptionId;
            optEl.classList.toggle('is-mine', isMine);

            var info = data.options.find(function (o) { return o.optionId === optId; });
            var count = info ? info.count : 0;
            var pct = info ? info.pct : 0;

            var pctEl = optEl.querySelector('.km-poll-opt-pct');
            if (pctEl) pctEl.textContent = '%' + pct;
            var barEl = optEl.querySelector('.km-poll-opt-bar > span');
            if (barEl) barEl.style.width = pct + '%';
        });

        var totalEl = card.querySelector('.km-poll-total-num');
        if (totalEl) totalEl.textContent = data.totalVotes;
        var cvEl = card.querySelector('.km-cv');
        if (cvEl) cvEl.dispatchEvent(new Event('km-voted'));

        showFoot(card, 'Oyunuz kaydedildi.', true);
    }

    function showFoot(card, text, ok) {
        var foot = card.querySelector('.km-poll-foot');
        if (!foot) return;
        var textEl = foot.querySelector('.km-poll-foot-text');
        if (textEl) textEl.textContent = text;
        foot.classList.toggle('is-voted', ok);
        foot.classList.add('km-poll-flash');
        setTimeout(function () { foot.classList.remove('km-poll-flash'); }, 1800);
    }
})();
</script>
}
