@model List<BrikonYapi.Web.Data.Entities.FaqItem>
@{
    bool isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewData["Title"] = isEn ? "Frequently Asked Questions" : "Sıkça Sorulan Sorular";
    ViewData["Description"] = "Brikon Yapı kentsel dönüşüm süreci hakkında sıkça sorulan sorular ve cevapları.";
    ViewData["BodyClass"] = "faq-page";
}

@section Styles {
<style>
/* İletişim sayfasıyla aynı sade/kurumsal desen: kısa koyu hero + açık gri içerik alanı */
body { background: #f4f6f8; }

/* ── HERO ─────────────────────────────────────────── */
.faq-hero {
    background: #0a1628;
    padding: calc(68px + 3.2rem) 0 3.2rem;
}
.faq-hero-inner {
    max-width: 640px; margin: 0 auto; padding: 0 1.5rem;
    text-align: center;
}
.faq-eyebrow {
    display: inline-flex; align-items: center; gap: .5rem;
    font-size: .58rem; font-weight: 700; letter-spacing: .25em;
    text-transform: uppercase; color: #0082B4; margin-bottom: .9rem;
}
.faq-eyebrow::before, .faq-eyebrow::after {
    content: ''; display: block; width: 24px; height: 1px; background: #0082B4; opacity: .5;
}
.faq-title {
    font-family: 'Inter', sans-serif; font-weight: 900;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: #fff; letter-spacing: -.03em; line-height: 1.1; margin: 0 0 .7rem;
}
.faq-subtitle { font-size: .88rem; color: rgba(255,255,255,.4); line-height: 1.6; }

/* ── SAYFA İSKELETİ ───────────────────────────────────
   Soru sayısı azken (ör. tek soru) hero + liste viewport'u doldurmuyor ve
   footer sayfa yüklenir yüklenmez ekranın büyük kısmını kaplıyormuş gibi
   görünüyordu. faq-shell'i en az ekran yüksekliği kadar yapıp içerik
   alanını (faq-wrap) esnetiyoruz ki footer her zaman aşağı itilsin ve
   yalnızca scroll ile görünsün. */
.faq-shell { display: flex; flex-direction: column; min-height: calc(100vh + 40px); }
.faq-shell .faq-hero { flex: none; }

/* ── LIST ─────────────────────────────────────────── */
.faq-wrap { max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem 4rem; flex: 1 0 auto; width: 100%; box-sizing: border-box; }

.faq-item {
    background: #fff; border: 1px solid #e8ecf0; border-radius: 10px;
    margin-bottom: .7rem; overflow: hidden;
    transition: border-color .2s;
}
.faq-item:hover { border-color: #d3dae1; }
.faq-item.is-open { border-color: #0082B4; }

.faq-q {
    width: 100%; text-align: left; background: none; border: none;
    color: #0a1628; font-weight: 700; font-size: .95rem; line-height: 1.4;
    padding: 1.05rem 1.2rem; display: flex; align-items: center;
    justify-content: space-between; gap: 1rem; cursor: pointer;
}
.faq-q:hover { color: #0082B4; }
.faq-q-icon {
    flex-shrink: 0; width: 18px; height: 18px; color: #9CA3AF;
    transition: transform .25s, color .2s;
}
.faq-item.is-open .faq-q-icon { transform: rotate(180deg); color: #0082B4; }

.faq-a-wrap {
    display: grid; grid-template-rows: 0fr; transition: grid-template-rows .25s ease;
}
.faq-item.is-open .faq-a-wrap { grid-template-rows: 1fr; }
.faq-a-inner { overflow: hidden; }
.faq-a {
    padding: 0 1.2rem 1.1rem;
    color: #6B7280; font-size: .87rem; line-height: 1.7; white-space: pre-line;
    border-top: 1px solid #f1f3f5; margin-top: -.1rem; padding-top: .9rem;
}

.faq-empty {
    text-align: center; color: #9CA3AF;
    padding: 3rem 1rem; font-size: .88rem;
}

.faq-more { text-align: center; font-size: .85rem; color: #6B7280; margin-top: 1.6rem; }
.faq-more a { color: #0082B4; font-weight: 600; text-decoration: none; }
.faq-more a:hover { text-decoration: underline; }

@@media (max-width: 480px) {
    .faq-hero { padding: calc(68px + 2.2rem) 0 2.2rem; }
    .faq-wrap { padding: 2.2rem 1.2rem 3rem; }
    .faq-q { font-size: .88rem; padding: .9rem 1rem; }
}
</style>
}

<div class="faq-shell">
<section class="faq-hero">
    <div class="faq-hero-inner">
        <span class="faq-eyebrow">@(isEn ? "Support" : "Destek")</span>
        <h1 class="faq-title">@(isEn ? "Frequently Asked Questions" : "Sıkça Sorulan Sorular")</h1>
        <p class="faq-subtitle">
            @(isEn
                ? "Answers to the questions we hear most often about the urban transformation process."
                : "Kentsel dönüşüm sürecinde en çok merak edilen soruların cevapları.")
        </p>
    </div>
</section>

<div class="faq-wrap">
    @if (!Model.Any())
    {
        <div class="faq-empty">
            @(isEn ? "No questions have been published yet." : "Henüz yayınlanmış bir soru bulunmuyor.")
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            var displayQuestion = isEn && !string.IsNullOrEmpty(item.QuestionEn) ? item.QuestionEn : item.Question;
            var displayAnswer   = isEn && !string.IsNullOrEmpty(item.AnswerEn) ? item.AnswerEn : item.Answer;
            <div class="faq-item">
                <button type="button" class="faq-q" aria-expanded="false">
                    <span>@displayQuestion</span>
                    <svg class="faq-q-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                <div class="faq-a-wrap">
                    <div class="faq-a-inner">
                        <div class="faq-a">@displayAnswer</div>
                    </div>
                </div>
            </div>
        }
    }

    <p class="faq-more">
        @(isEn ? "Couldn't find your answer? " : "Aradığınız cevabı bulamadınız mı? ")<a href="/Iletisim">@(isEn ? "Contact us" : "Bize ulaşın")</a>
    </p>
</div>
</div>

@section Scripts {
<script>
(function () {
    document.querySelectorAll('.faq-q').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var item = btn.closest('.faq-item');
            var open = item.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    });
})();
</script>
}
