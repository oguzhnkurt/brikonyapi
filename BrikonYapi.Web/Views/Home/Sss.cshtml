@model List<BrikonYapi.Web.Data.Entities.FaqItem>
@{
    bool isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewData["Title"] = isEn ? "Frequently Asked Questions" : "Sıkça Sorulan Sorular";
    ViewData["Description"] = "Brikon Yapı kentsel dönüşüm süreci hakkında sıkça sorulan sorular ve cevapları.";
    ViewData["BodyClass"] = "faq-page";
}

@section Styles {
<style>
/* Page-level dark background — diğer kurumsal alt sayfalarla (Projeler, Sertifikalar) aynı tema */
body { background: #030608; }

/* ══ HEADER — Projeler/Sertifikalar ile aynı desen ══ */
.faq-header {
    background: #0f1724;
    padding: calc(68px + 2.8rem) 3rem 2.2rem;
}
.faq-eyebrow {
    font-size: .58rem; font-weight: 700; letter-spacing: .3em;
    text-transform: uppercase; color: var(--c-primary);
    display: block; margin-bottom: .5rem;
}
.faq-title {
    font-family: 'Inter', sans-serif; font-weight: 900;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    color: #fff; letter-spacing: -.025em; line-height: 1; margin: 0 0 .6rem;
}
.faq-subtitle {
    font-size: .78rem; color: rgba(255,255,255,.38); margin: 0 0 1.4rem; max-width: 480px;
}
.faq-breadcrumb {
    display: flex; align-items: center; gap: .4rem;
    font-size: .68rem; color: rgba(255,255,255,.28);
}
.faq-breadcrumb a { color: rgba(255,255,255,.38); text-decoration: none; transition: color .2s; }
.faq-breadcrumb a:hover { color: var(--c-primary); }

.faq-header-bottom {
    display: flex; align-items: center;
    padding-top: 1.4rem; margin-top: 1.6rem; border-top: 1px solid rgba(255,255,255,.07);
    gap: 3rem; flex-wrap: wrap;
}
.faq-stat-val { font-size: 1.7rem; font-weight: 900; color: #fff; line-height: 1; display: block; letter-spacing: -.04em; }
.faq-stat-val em { color: var(--c-primary); font-style: normal; }
.faq-stat-lbl { font-size: .53rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.22); display: block; margin-top: .18rem; }

/* ══ FILTER BAR — Projeler sayfasındaki arama kutusuyla aynı desen ══ */
.faq-filter-bar {
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    padding: 1.2rem 3rem; background: #0a1220;
    border-bottom: 1px solid rgba(255,255,255,.06);
}
.faq-search-wrap { position: relative; flex: 0 0 320px; max-width: 100%; }
.faq-search-wrap svg {
    position: absolute; left: .75rem; top: 50%; transform: translateY(-50%);
    color: rgba(255,255,255,.3); pointer-events: none;
}
.faq-search {
    width: 100%; background: rgba(255,255,255,.05);
    border: 1.5px solid rgba(255,255,255,.08); border-radius: 4px;
    color: #fff; font-size: .78rem; padding: .6rem .75rem .6rem 2.2rem;
    outline: none; transition: border-color .2s;
}
.faq-search::placeholder { color: rgba(255,255,255,.25); }
.faq-search:focus { border-color: rgba(0,130,180,.55); }
.faq-filter-count { margin-left: auto; font-size: .68rem; color: rgba(255,255,255,.28); white-space: nowrap; }

/* ══ LIST ══ */
.faq-wrap { max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem 1rem; }

.faq-item {
    display: flex; align-items: flex-start; gap: 1rem;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 10px;
    background: #0b1119;
    margin-bottom: .7rem;
    overflow: hidden;
    transition: border-color .2s, transform .2s, box-shadow .2s;
}
.faq-item:hover { border-color: rgba(255,255,255,.16); }
.faq-item.is-open { border-color: rgba(0,130,180,.4); box-shadow: 0 8px 24px rgba(0,0,0,.25); }

.faq-num {
    flex-shrink: 0; font-family: 'Inter', sans-serif; font-weight: 800;
    font-size: .82rem; color: var(--c-primary);
    background: rgba(0,130,180,.12); border-radius: 8px;
    width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
    margin: 1rem 0 0 1rem;
}

.faq-body { flex: 1; min-width: 0; }

.faq-q {
    width: 100%; text-align: left; background: none; border: none;
    color: #fff; font-weight: 700; font-size: .96rem; line-height: 1.4;
    padding: 1.05rem 1.2rem 1.05rem 0; display: flex; align-items: center;
    justify-content: space-between; gap: 1rem; cursor: pointer;
}
.faq-q:hover { color: var(--c-primary); }
.faq-q-icon {
    flex-shrink: 0; width: 18px; height: 18px;
    color: rgba(255,255,255,.35); transition: transform .25s, color .2s;
}
.faq-item.is-open .faq-q-icon { transform: rotate(180deg); color: var(--c-primary); }

.faq-a-wrap {
    display: grid; grid-template-rows: 0fr; transition: grid-template-rows .28s ease;
}
.faq-item.is-open .faq-a-wrap { grid-template-rows: 1fr; }
.faq-a-inner { overflow: hidden; }
.faq-a {
    padding: 0 1.2rem 1.15rem 0;
    color: rgba(255,255,255,.56);
    font-size: .87rem; line-height: 1.7; white-space: pre-line;
}

.faq-empty, .faq-no-results {
    text-align: center; color: rgba(255,255,255,.4);
    padding: 3.5rem 1rem; font-size: .88rem;
}

/* ══ CTA BAND ══ */
.faq-cta {
    max-width: 800px; margin: 1rem auto 4.5rem; padding: 0 1.5rem;
}
.faq-cta-inner {
    background: linear-gradient(135deg, rgba(0,130,180,.14), rgba(0,160,227,.06));
    border: 1px solid rgba(0,130,180,.25); border-radius: 14px;
    padding: 2rem 2.2rem; text-align: center;
}
.faq-cta-title { font-family: 'Inter', sans-serif; font-weight: 800; font-size: 1.15rem; color: #fff; margin: 0 0 .4rem; }
.faq-cta-sub { font-size: .82rem; color: rgba(255,255,255,.45); margin: 0 0 1.3rem; }
.faq-cta .btn { font-size: .68rem; padding: .8rem 1.8rem; }

@@media (max-width: 768px) {
    .faq-header { padding: calc(60px + 2rem) 1.25rem 1.6rem; }
    .faq-header-bottom { gap: 1.8rem; }
    .faq-filter-bar { padding: .9rem 1.2rem; }
    .faq-search-wrap { flex: 1 1 100%; }
    .faq-filter-count { display: none; }
    .faq-wrap { padding: 2.2rem 1.1rem .5rem; }
    .faq-q { font-size: .9rem; padding: .95rem 1rem .95rem 0; }
    .faq-num { width: 28px; height: 28px; font-size: .72rem; margin: .85rem 0 0 .85rem; }
    .faq-cta-inner { padding: 1.6rem 1.4rem; }
}
</style>
}

<header class="faq-header">
    <span class="faq-eyebrow">@(isEn ? "Support" : "Destek")</span>
    <h1 class="faq-title">@(isEn ? "Frequently Asked Questions" : "Sıkça Sorulan Sorular")</h1>
    <p class="faq-subtitle">
        @(isEn
            ? "Answers to the questions we hear most often about the urban transformation process."
            : "Kentsel dönüşüm sürecinde en çok merak edilen soruların cevapları.")
    </p>
    <nav class="faq-breadcrumb">
        <a href="/">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <span>@(isEn ? "FAQ" : "Sıkça Sorulan Sorular")</span>
    </nav>

    @if (Model.Any())
    {
        <div class="faq-header-bottom">
            <div>
                <span class="faq-stat-val"><em>@Model.Count</em></span>
                <span class="faq-stat-lbl">@(isEn ? "Question" : "Soru")</span>
            </div>
        </div>
    }
</header>

@if (Model.Any())
{
    <div class="faq-filter-bar">
        <div class="faq-search-wrap">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input type="text" class="faq-search" id="faq-search" placeholder="@(isEn ? "Search a question..." : "Soru içinde ara...")" autocomplete="off" />
        </div>
        <span class="faq-filter-count" id="faq-filter-count">@Model.Count @(isEn ? "questions" : "soru")</span>
    </div>
}

<div class="faq-wrap">
    @if (!Model.Any())
    {
        <div class="faq-empty">
            @(isEn ? "No questions have been published yet." : "Henüz yayınlanmış bir soru bulunmuyor.")
        </div>
    }
    else
    {
        var i = 0;
        @foreach (var item in Model)
        {
            i++;
            <div class="faq-item" data-search="@($"{item.Question} {item.Answer}".ToLowerInvariant())">
                <span class="faq-num">@i.ToString("00")</span>
                <div class="faq-body">
                    <button type="button" class="faq-q" aria-expanded="false">
                        <span>@item.Question</span>
                        <svg class="faq-q-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </button>
                    <div class="faq-a-wrap">
                        <div class="faq-a-inner">
                            <div class="faq-a">@item.Answer</div>
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="faq-no-results" id="faq-no-results" style="display:none;">
            @(isEn ? "No questions match your search." : "Aramanızla eşleşen bir soru bulunamadı.")
        </div>
    }
</div>

<div class="faq-cta">
    <div class="faq-cta-inner">
        <h3 class="faq-cta-title">@(isEn ? "Couldn't find your answer?" : "Aradığınız cevabı bulamadınız mı?")</h3>
        <p class="faq-cta-sub">
            @(isEn
                ? "Get in touch with our team, we're happy to help."
                : "Ekibimizle iletişime geçin, size yardımcı olmaktan memnuniyet duyarız.")
        </p>
        <a href="/Iletisim" class="btn btn-primary">@(isEn ? "Contact Us" : "Bize Ulaşın")</a>
    </div>
</div>

@section Scripts {
<script>
(function () {
    document.querySelectorAll('.faq-q').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var item = btn.closest('.faq-item');
            var open = item.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    });

    var searchInput = document.getElementById('faq-search');
    var countEl = document.getElementById('faq-filter-count');
    var noResultsEl = document.getElementById('faq-no-results');
    var items = Array.from(document.querySelectorAll('.faq-item'));
    if (!searchInput) return;

    searchInput.addEventListener('input', function () {
        var q = searchInput.value.toLowerCase().trim();
        var visible = 0;
        items.forEach(function (item) {
            var match = !q || (item.dataset.search || '').indexOf(q) !== -1;
            item.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        if (countEl) {
            countEl.textContent = visible + ' ' + (@Html.Raw(isEn ? "'questions'" : "'soru'"));
        }
        if (noResultsEl) noResultsEl.style.display = visible === 0 ? '' : 'none';
    });
})();
</script>
}
