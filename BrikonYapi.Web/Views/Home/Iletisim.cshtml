@{
    bool isEn = ViewBag.IsEn == true;
    ViewData["Title"] = isEn ? "Contact" : "İletişim";
    ViewData["Description"] = isEn ? "Contact Brikon Yapı. We are here for your projects." : "Brikon Yapı ile iletişime geçin. Projeleriniz için buradayız.";
    ViewData["BodyClass"] = "ct-page";
}

@section Styles {
<style>
body { background: #f4f6f8; }

/* ── HERO ─────────────────────────────────────────── */
.ct-hero {
    background: #0a1628;
    padding: calc(68px + 3.5rem) 0 3.5rem;
}
.ct-hero-inner {
    max-width: 680px; margin: 0 auto; padding: 0 1.5rem;
    text-align: center;
}
.ct-eyebrow {
    display: inline-flex; align-items: center; gap: .5rem;
    font-size: .58rem; font-weight: 700; letter-spacing: .25em;
    text-transform: uppercase; color: #0082B4; margin-bottom: .9rem;
}
.ct-eyebrow::before, .ct-eyebrow::after {
    content: ''; display: block; width: 24px; height: 1px; background: #0082B4; opacity: .5;
}
.ct-title {
    font-family: 'Inter', sans-serif; font-weight: 900;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    color: #fff; letter-spacing: -.03em; line-height: 1.08; margin: 0 0 .9rem;
}
.ct-title span { color: #0082B4; }
.ct-sub { font-size: .95rem; color: rgba(255,255,255,.38); line-height: 1.7; }

/* ── LAYOUT ───────────────────────────────────────── */
.ct-outer {
    max-width: 1080px; margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 1.5rem;
    align-items: start;
}

/* ── SOL: BİLGİ ───────────────────────────────────── */
.ct-left {
    display: flex; flex-direction: column; gap: 1rem;
}
.ct-info-card {
    background: #fff; border-radius: 10px;
    padding: 1.2rem 1.3rem;
    display: flex; align-items: flex-start; gap: .9rem;
    text-decoration: none; color: inherit;
    border: 1px solid #e8ecf0;
    transition: box-shadow .2s, border-color .2s;
}
a.ct-info-card:hover { border-color: #0082B4; box-shadow: 0 4px 16px rgba(0,130,180,.1); }
.ct-info-icon {
    width: 38px; height: 38px; border-radius: 8px; flex-shrink: 0;
    background: #EBF5FB;
    display: flex; align-items: center; justify-content: center;
    color: #0082B4;
}
.ct-info-lbl {
    font-size: .56rem; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: #9CA3AF; margin-bottom: .2rem;
}
.ct-info-val { font-size: .88rem; font-weight: 600; color: #1a2535; line-height: 1.5; }

.ct-social-row { display: flex; gap: .5rem; padding: .2rem 0; }
.ct-soc {
    width: 36px; height: 36px; border-radius: 8px;
    background: #fff; border: 1px solid #e8ecf0;
    display: flex; align-items: center; justify-content: center;
    color: #6B7280; text-decoration: none;
    transition: background .2s, color .2s, border-color .2s;
}
.ct-soc:hover { background: #0082B4; color: #fff; border-color: #0082B4; }

/* ── SAĞ: FORM ────────────────────────────────────── */
.ct-right {
    background: #fff; border-radius: 12px;
    border: 1px solid #e8ecf0;
    padding: 2.4rem 2.6rem;
}
.ct-form-title { font-size: 1.25rem; font-weight: 800; color: #0a1628; margin: 0 0 .3rem; }
.ct-form-sub { font-size: .84rem; color: #6B7280; margin-bottom: 1.8rem; }

.ct-label {
    display: block; font-size: .58rem; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: #374151; margin-bottom: .35rem;
}
.ct-input {
    width: 100%; background: #f9fafb;
    border: 1.5px solid #e5e7eb; border-radius: 6px;
    padding: .68rem .9rem; font-size: .9rem; color: #0a1628;
    outline: none; transition: border-color .2s, box-shadow .2s;
    font-family: inherit;
}
.ct-input::placeholder { color: #b0b8c4; }
.ct-input:focus { background: #fff; border-color: #0082B4; box-shadow: 0 0 0 3px rgba(0,130,180,.1); }

.ct-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
.ct-field { margin-bottom: 1rem; }

.ct-submit {
    width: 100%; padding: .85rem; border: none; border-radius: 6px;
    background: #0082B4; color: #fff;
    font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: .5rem;
    transition: background .2s, transform .15s; margin-top: .4rem;
}
.ct-submit:hover { background: #006a94; transform: translateY(-1px); }
.ct-submit:active { transform: none; }

.ct-alert-ok {
    background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534;
    border-radius: 6px; padding: .85rem 1rem; margin-bottom: 1.3rem;
    font-size: .87rem; display: flex; align-items: center; gap: .5rem;
}
.ct-alert-err {
    background: #fef2f2; border: 1px solid #fecaca; color: #991b1b;
    border-radius: 6px; padding: .85rem 1rem; margin-bottom: 1.3rem; font-size: .87rem;
}

/* ── MOBİL ────────────────────────────────────────── */
@@media (max-width: 860px) {
    .ct-outer { grid-template-columns: 1fr; gap: 1.2rem; padding: 2rem 1.2rem 4rem; }
    .ct-left { order: 2; }
    .ct-right { order: 1; }
}
@@media (max-width: 480px) {
    .ct-row { grid-template-columns: 1fr; gap: .75rem; }
    .ct-right { padding: 1.6rem 1.3rem; }
    .ct-hero { padding: calc(68px + 2.2rem) 0 2.2rem; }
}
</style>
}

<!-- Hero -->
<section class="ct-hero">
    <div class="ct-hero-inner">
        <span class="ct-eyebrow">@(isEn ? "Get in Touch" : "Bize Ulaşın")</span>
        <h1 class="ct-title">@Html.Raw(isEn ? "Let's Build <span>Together</span>" : "Birlikte <span>İnşa</span> Edelim")</h1>
        <p class="ct-sub">@(isEn ? "Tell us about your project. Our team will get back to you within 24 hours." : "Projenizi bize anlatın. Ekibimiz 24 saat içinde size geri dönsün.")</p>
    </div>
</section>

<!-- İçerik -->
<div class="ct-outer">

    <!-- Sol: İletişim Bilgileri -->
    <div class="ct-left">

        @if (!string.IsNullOrEmpty(ViewBag.Phone?.ToString()))
        {
            <a href="tel:@ViewBag.Phone" class="ct-info-card">
                <div class="ct-info-icon">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.4a2 2 0 0 1 1.99-2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                    <div class="ct-info-lbl">@(isEn ? "Phone" : "Telefon")</div>
                    <div class="ct-info-val">@ViewBag.Phone</div>
                </div>
            </a>
        }

        @if (!string.IsNullOrEmpty(ViewBag.Email?.ToString()))
        {
            <a href="mailto:@ViewBag.Email" class="ct-info-card">
                <div class="ct-info-icon">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </div>
                <div>
                    <div class="ct-info-lbl">@(isEn ? "E-mail" : "E-posta")</div>
                    <div class="ct-info-val">@ViewBag.Email</div>
                </div>
            </a>
        }

        @if (!string.IsNullOrEmpty(ViewBag.Address?.ToString()))
        {
            <div class="ct-info-card">
                <div class="ct-info-icon">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                    <div class="ct-info-lbl">@(isEn ? "Address" : "Adres")</div>
                    <div class="ct-info-val">@ViewBag.Address</div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewBag.WhatsApp?.ToString()))
        {
            <a href="https://wa.me/@(ViewBag.WhatsApp?.ToString()?.Replace("+","").Replace(" ",""))" target="_blank" class="ct-info-card">
                <div class="ct-info-icon" style="background:rgba(37,211,102,.1);border-color:rgba(37,211,102,.25);color:#25D366;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.128.557 4.127 1.533 5.864L.057 23.32l5.637-1.478A11.955 11.955 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.006-1.373l-.36-.214-3.724.976.993-3.63-.234-.373A9.818 9.818 0 1 1 12 21.818z"/></svg>
                </div>
                <div>
                    <div class="ct-info-lbl">WhatsApp</div>
                    <div class="ct-info-val">@ViewBag.WhatsApp</div>
                </div>
            </a>
        }

        @{
            bool hasSocial = !string.IsNullOrEmpty(ViewBag.Instagram?.ToString()) ||
                             !string.IsNullOrEmpty(ViewBag.Facebook?.ToString()) ||
                             !string.IsNullOrEmpty(ViewBag.LinkedIn?.ToString());
        }
        @if (hasSocial)
        {
            <div class="ct-social-row">
                @if (!string.IsNullOrEmpty(ViewBag.Instagram?.ToString()))
                {
                    <a href="@ViewBag.Instagram" target="_blank" class="ct-soc" aria-label="Instagram">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor" stroke="none"/></svg>
                    </a>
                }
                @if (!string.IsNullOrEmpty(ViewBag.Facebook?.ToString()))
                {
                    <a href="@ViewBag.Facebook" target="_blank" class="ct-soc" aria-label="Facebook">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                }
                @if (!string.IsNullOrEmpty(ViewBag.LinkedIn?.ToString()))
                {
                    <a href="@ViewBag.LinkedIn" target="_blank" class="ct-soc" aria-label="LinkedIn">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                    </a>
                }
            </div>
        }
    </div>

    <!-- Sağ: Form -->
    <div class="ct-right">
        <div class="ct-form-head">
            <h2 class="ct-form-title">@(isEn ? "Send a Message" : "Mesaj Gönderin")</h2>
            <p class="ct-form-sub">@(isEn ? "Fill in the form and we'll get back to you as soon as possible." : "Formu doldurun, en kısa sürede size dönelim.")</p>
        </div>

        @if (ViewBag.ContactSuccess == true)
        {
            <div class="ct-alert-ok">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                @(isEn ? "Your message has been sent! We'll be in touch shortly." : "Mesajınız iletildi! En kısa sürede size döneceğiz.")
            </div>
        }
        @if (ViewBag.ContactError != null)
        {
            <div class="ct-alert-err">@ViewBag.ContactError</div>
        }

        <form method="post" action="/Iletisim">
            @Html.AntiForgeryToken()
            <div class="ct-row">
                <div>
                    <label class="ct-label">@(isEn ? "Full Name" : "Ad Soyad") *</label>
                    <input type="text" name="fullName" class="ct-input" placeholder="@(isEn ? "John Doe" : "Adınız Soyadınız")" required />
                </div>
                <div>
                    <label class="ct-label">@(isEn ? "E-mail" : "E-posta") *</label>
                    <input type="email" name="email" class="ct-input" placeholder="ornek@mail.com" required />
                </div>
            </div>
            <div class="ct-row">
                <div>
                    <label class="ct-label">@(isEn ? "Phone" : "Telefon")</label>
                    <input type="tel" name="phone" class="ct-input" placeholder="+90 5XX XXX XX XX" />
                </div>
                <div>
                    <label class="ct-label">@(isEn ? "Subject" : "Konu")</label>
                    <input type="text" name="subject" class="ct-input" placeholder="@(isEn ? "Project inquiry" : "Proje talebi")" />
                </div>
            </div>
            <div class="ct-field">
                <label class="ct-label">@(isEn ? "Message" : "Mesaj") *</label>
                <textarea name="message" class="ct-input" rows="5"
                    placeholder="@(isEn ? "Tell us about your project..." : "Projeniz hakkında bilgi verin...")" required style="resize:vertical;"></textarea>
            </div>
            <button type="submit" class="ct-submit">
                @(isEn ? "Send Message" : "Mesaj Gönder")
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
        </form>
    </div>
</div>
