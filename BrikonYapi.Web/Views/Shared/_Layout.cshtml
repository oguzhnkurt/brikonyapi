<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brikon Yapı</title>
    @{
        var metaDesc   = (ViewData["Description"] ?? "Brikon Yapı - Kaliteli ve güvenilir inşaat hizmetleriyle geleceği inşa ediyoruz.").ToString();
        var metaImage  = (ViewData["OgImage"]     ?? "/images/og-default.jpg").ToString();
        var metaUrl    = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var metaTitle  = $"{ViewData["Title"]} - Brikon Yapı";
    }
    <meta name="description" content="@metaDesc" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@metaUrl" />
    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Brikon Yapı" />
    <meta property="og:title"       content="@metaTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:image"       content="@metaImage" />
    <meta property="og:url"         content="@metaUrl" />
    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="@metaTitle" />
    <meta name="twitter:description" content="@metaDesc" />
    <meta name="twitter:image"       content="@metaImage" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.0.0/css/flag-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
    <link rel="stylesheet" href="~/css/brikon.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["BodyClass"] ?? "")">

<header id="site-header">
    <a href="/" class="header-logo">
        <img src="/images/logo.png" alt="Brikon Yapı" />
    </a>
    @{ var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; bool isEn = lang == "en"; }
    <nav class="header-nav">
        <a href="/" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">@(isEn ? "Home" : "Ana Sayfa")</a>

        <div class="nav-dropdown">
            @{ var isCorp = Context.Request.Path.StartsWithSegments("/Hakkimizda") || Context.Request.Path.StartsWithSegments("/Hizmetlerimiz") || Context.Request.Path.StartsWithSegments("/Sertifikalar"); }
            <button class="nav-link nav-dropdown-toggle @(isCorp ? "active" : "")" type="button">
                @(isEn ? "Corporate" : "Kurumsal") <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="nav-dropdown-menu">
                <a href="/Hakkimizda" class="nav-dropdown-item">@(isEn ? "About Us" : "Hakkımızda")</a>
                <a href="/Hizmetlerimiz" class="nav-dropdown-item">@(isEn ? "Our Services" : "Hizmetlerimiz")</a>
                <a href="/Sertifikalar" class="nav-dropdown-item">@(isEn ? "Certificates" : "Sertifikalar")</a>
            </div>
        </div>

        <div class="nav-dropdown">
            <button class="nav-link nav-dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")" type="button">
                @(isEn ? "Projects" : "Projeler") <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="nav-dropdown-menu">
                <a href="/Projeler" class="nav-dropdown-item">@(isEn ? "All Projects" : "Tüm Projeler")</a>
                <a href="/Projeler?tab=ongoing" class="nav-dropdown-item">@(isEn ? "Ongoing Projects" : "Devam Eden Projeler")</a>
                <a href="/Projeler?tab=completed" class="nav-dropdown-item">@(isEn ? "Completed Projects" : "Tamamlanan Projeler")</a>
            </div>
        </div>

        <a href="/E-Katalog" class="nav-link @(Context.Request.Path.StartsWithSegments("/E-Katalog") ? "active" : "")">@(isEn ? "E-Catalog" : "E-Katalog")</a>

        <a href="/Iletisim" class="nav-link @(Context.Request.Path.StartsWithSegments("/Iletisim") ? "active" : "")">@(isEn ? "Contact" : "İletişim")</a>

        <!-- Dil Seçimi -->
        <div class="nav-lang">
            <form asp-controller="Culture" asp-action="Set" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="culture" value="tr" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <button type="submit" class="lang-btn @(!isEn ? "active" : "")">
                    <span class="flag-tr"></span>TR
                </button>
            </form>
            <span class="lang-sep">|</span>
            <form asp-controller="Culture" asp-action="Set" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="culture" value="en" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <button type="submit" class="lang-btn @(isEn ? "active" : "")">
                    <span class="flag-en"></span>EN
                </button>
            </form>
        </div>
    </nav>

    @{var igLink = ViewBag.Instagram?.ToString();}
    <button class="hamburger" id="hamburger-btn" aria-label="Menü">
        <span></span><span></span><span></span>
    </button>
</header>

<nav class="mobile-nav" id="mobile-nav">
    <button class="mobile-nav-close" id="mobile-nav-close">&times;</button>
    <a href="/">@(isEn ? "Home" : "Ana Sayfa")</a>
    <div class="mobile-nav-group">
        <span class="mobile-nav-group-label">@(isEn ? "Corporate" : "Kurumsal")</span>
        <a href="/Hakkimizda" class="mobile-nav-sub">@(isEn ? "About Us" : "Hakkımızda")</a>
        <a href="/Hizmetlerimiz" class="mobile-nav-sub">@(isEn ? "Our Services" : "Hizmetlerimiz")</a>
        <a href="/Sertifikalar" class="mobile-nav-sub">@(isEn ? "Certificates" : "Sertifikalar")</a>
    </div>
    <div class="mobile-nav-group">
        <span class="mobile-nav-group-label">@(isEn ? "Projects" : "Projeler")</span>
        <a href="/Projeler" class="mobile-nav-sub">@(isEn ? "All Projects" : "Tüm Projeler")</a>
        <a href="/Projeler?tab=ongoing" class="mobile-nav-sub">@(isEn ? "Ongoing Projects" : "Devam Eden Projeler")</a>
        <a href="/Projeler?tab=completed" class="mobile-nav-sub">@(isEn ? "Completed Projects" : "Tamamlanan Projeler")</a>
    </div>
    <a href="/E-Katalog">@(isEn ? "E-Catalog" : "E-Katalog")</a>
    <a href="/Iletisim">@(isEn ? "Contact" : "İletişim")</a>
</nav>

@RenderBody()

<footer class="ft">
    <div class="ft-top">
        <div class="ft-inner">

            <!-- Logo + tagline -->
            <div class="ft-brand">
                <a href="/" class="ft-logo">
                    <img src="/images/logo.png" alt="Brikon Yapı" />
                </a>
                <p class="ft-tagline">@(isEn ? "Building the future with quality and reliable construction services." : (ViewBag.AboutText ?? "Kaliteli ve güvenilir inşaat hizmetleriyle geleceği inşa ediyoruz."))</p>
                <div class="ft-social">
                    @if (!string.IsNullOrEmpty(ViewBag.Instagram?.ToString()))
                    {
                        <a href="@ViewBag.Instagram" target="_blank" rel="noopener" aria-label="Instagram" class="ft-soc">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor" stroke="none"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.Facebook?.ToString()))
                    {
                        <a href="@ViewBag.Facebook" target="_blank" rel="noopener" aria-label="Facebook" class="ft-soc">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.LinkedIn?.ToString()))
                    {
                        <a href="@ViewBag.LinkedIn" target="_blank" rel="noopener" aria-label="LinkedIn" class="ft-soc">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                        </a>
                    }
                </div>
            </div>

            <!-- Hızlı Bağlantılar -->
            <div class="ft-col">
                <h6 class="ft-heading">@(isEn ? "Quick Links" : "Hızlı Bağlantılar")</h6>
                <ul class="ft-links">
                    <li><a href="/">@(isEn ? "Home" : "Ana Sayfa")</a></li>
                    <li><a href="/Hakkimizda">@(isEn ? "About Us" : "Hakkımızda")</a></li>
                    <li><a href="/Hizmetlerimiz">@(isEn ? "Services" : "Hizmetlerimiz")</a></li>
                    <li><a href="/Sertifikalar">@(isEn ? "Certificates" : "Sertifikalar")</a></li>
                    <li><a href="/E-Katalog">@(isEn ? "E-Catalog" : "E-Katalog")</a></li>
                    <li><a href="/Iletisim">@(isEn ? "Contact" : "İletişim")</a></li>
                </ul>
            </div>

            <!-- Projeler -->
            <div class="ft-col">
                <h6 class="ft-heading">@(isEn ? "Projects" : "Projeler")</h6>
                <ul class="ft-links">
                    <li><a href="/Projeler">@(isEn ? "All Projects" : "Tüm Projeler")</a></li>
                    <li><a href="/Projeler?tab=ongoing">@(isEn ? "Ongoing Projects" : "Devam Eden Projeler")</a></li>
                    <li><a href="/Projeler?tab=completed">@(isEn ? "Completed Projects" : "Tamamlanan Projeler")</a></li>
                    <li><a href="/ProjeHaritasi">@(isEn ? "Project Map" : "Proje Haritası")</a></li>
                </ul>
            </div>


        </div>
    </div>

    <div class="ft-bar">
        <div class="ft-inner">
            <span>&copy; @DateTime.Now.Year Brikon Yapı. @(isEn ? "All rights reserved." : "Tüm hakları saklıdır.")</span>
        </div>
    </div>
</footer>

<script src="~/lib/leaflet/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script src="~/js/brikon.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
